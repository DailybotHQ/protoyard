{
  "$schema": "../packages/blueprint/schema/blueprint.schema.json",
  "formatVersion": 1,
  "name": "Hirepath ATS",
  "description": "Jobs, candidates and interviews for a fictional recruiting team.",
  "icon": "🧭",
  "category": "hr",
  "tags": ["recruiting", "hr", "jobs"],
  "catalog": {
    "category": "hr",
    "productType": "ATS",
    "platforms": ["web"],
    "features": ["pipeline", "interviews"],
    "highlights": ["Job reqs", "Candidate stages", "Interview scorecards"],
    "difficulty": "intermediate"
  },
  "brand": {
    "id": "ats-recruiting-brand",
    "name": "Hirepath ATS",
    "seed": "#7c3aed",
    "styleProfile": "crisp",
    "font": "humanist"
  },
  "entities": [
    {
      "name": "job",
      "plural": "jobs",
      "fields": [
        {
          "name": "title",
          "kind": "text",
          "required": true,
          "fake": "person.jobTitle"
        },
        {
          "name": "status",
          "kind": "enum",
          "values": ["open", "paused", "closed"],
          "default": "open",
          "required": true,
          "weights": [3, 2, 1]
        },
        {
          "name": "location",
          "kind": "text",
          "fake": "location.city"
        },
        {
          "name": "hiringManager",
          "kind": "persona"
        }
      ],
      "titleField": "title",
      "ownerField": "hiringManager"
    },
    {
      "name": "candidate",
      "plural": "candidates",
      "fields": [
        {
          "name": "fullName",
          "kind": "text",
          "required": true,
          "fake": "person.fullName"
        },
        {
          "name": "email",
          "kind": "email",
          "fake": "internet.email"
        },
        {
          "name": "stage",
          "kind": "enum",
          "values": ["applied", "screen", "onsite", "offer", "hired", "rejected"],
          "default": "applied",
          "required": true,
          "weights": [6, 5, 4, 3, 2, 1]
        },
        {
          "name": "job",
          "kind": "relation",
          "to": "job",
          "required": true,
          "onDelete": "cascade"
        },
        {
          "name": "resume",
          "kind": "file",
          "accept": ["application/pdf"]
        }
      ],
      "titleField": "fullName",
      "searchable": ["fullName", "email"],
      "features": {
        "files": true
      }
    },
    {
      "name": "interview",
      "plural": "interviews",
      "fields": [
        {
          "name": "candidate",
          "kind": "relation",
          "to": "candidate",
          "required": true,
          "onDelete": "cascade"
        },
        {
          "name": "scheduledAt",
          "kind": "datetime",
          "required": true,
          "window": "around"
        },
        {
          "name": "interviewer",
          "kind": "persona"
        },
        {
          "name": "score",
          "kind": "integer",
          "min": 1,
          "max": 5,
          "trend": "decline"
        },
        {
          "name": "notes",
          "kind": "longText"
        }
      ],
      "titleField": "score"
    },
    {
      "name": "offer",
      "plural": "offers",
      "fields": [
        {
          "name": "name",
          "kind": "text",
          "required": true
        },
        {
          "name": "candidate",
          "kind": "relation",
          "to": "candidate",
          "required": true,
          "onDelete": "cascade"
        },
        {
          "name": "status",
          "kind": "enum",
          "values": ["planned", "active", "complete"],
          "default": "planned",
          "required": true,
          "weights": [5, 3, 2]
        },
        {
          "name": "startsAt",
          "kind": "datetime",
          "window": "around"
        },
        {
          "name": "value",
          "kind": "money",
          "min": 5000,
          "max": 250000,
          "trend": "seasonal"
        }
      ],
      "titleField": "name",
      "searchable": ["name"]
    }
  ],
  "roles": [
    {
      "name": "owner",
      "permissions": {
        "*": ["*"]
      }
    },
    {
      "name": "member",
      "permissions": {
        "*": ["read", "create", "update", "delete", "import", "export"]
      }
    },
    {
      "name": "viewer",
      "permissions": {
        "*": ["read"]
      }
    }
  ],
  "screens": [
    {
      "type": "dashboard",
      "path": "/dashboard",
      "title": "Hirepath ATS overview",
      "nav": {
        "label": "Overview",
        "icon": "layout-dashboard",
        "order": 0
      },
      "widgets": [
        {
          "kind": "kpi",
          "label": "Total jobs",
          "entity": "job",
          "aggregate": "count",
          "span": 1
        },
        {
          "kind": "chart",
          "label": "jobs over time",
          "entity": "job",
          "aggregate": "count",
          "chart": "line",
          "bucket": {
            "field": "createdAt",
            "unit": "month"
          },
          "span": 3
        },
        {
          "kind": "board-summary",
          "label": "jobs by status",
          "entity": "job",
          "groupBy": "status",
          "span": 2
        }
      ]
    },
    {
      "type": "list",
      "entity": "job",
      "columns": ["title", "status", "location"]
    },
    {
      "type": "form",
      "entity": "job"
    },
    {
      "type": "list",
      "entity": "candidate",
      "columns": ["fullName", "email", "stage"]
    },
    {
      "type": "form",
      "entity": "candidate"
    },
    {
      "type": "list",
      "entity": "interview",
      "columns": ["candidate", "scheduledAt", "interviewer"]
    },
    {
      "type": "form",
      "entity": "interview"
    },
    {
      "type": "board",
      "entity": "job",
      "groupBy": "status",
      "cardFields": ["title"],
      "path": "/jobs/board",
      "title": "Jobs board",
      "nav": {
        "label": "Board",
        "icon": "kanban",
        "order": 20
      }
    },
    {
      "type": "detail",
      "entity": "job",
      "tabs": ["overview"],
      "path": "/jobs/:id",
      "title": "Job details",
      "nav": {
        "label": "Details",
        "icon": "file-text",
        "hidden": true
      }
    },
    {
      "type": "settings",
      "sections": ["profile", "appearance"],
      "path": "/settings",
      "title": "Settings",
      "nav": {
        "label": "Settings",
        "icon": "settings",
        "order": 999
      }
    }
  ]
}

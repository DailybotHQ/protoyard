{
  "$schema": "../packages/blueprint/schema/blueprint.schema.json",
  "formatVersion": 1,
  "name": "Gatepass Events",
  "description": "Events, ticket types and orders for a fictional venue.",
  "icon": "🎫",
  "category": "media",
  "tags": ["events", "tickets", "venues"],
  "catalog": {
    "category": "media",
    "productType": "Events",
    "platforms": ["web"],
    "features": ["orders", "check-in"],
    "highlights": ["Multi-tier tickets", "Order totals", "Door list"],
    "difficulty": "intermediate"
  },
  "brand": {
    "id": "events-ticketing-brand",
    "name": "Gatepass Events",
    "seed": "#db2777",
    "styleProfile": "rounded",
    "font": "geometric"
  },
  "entities": [
    {
      "name": "event",
      "plural": "events",
      "fields": [
        {
          "name": "title",
          "kind": "text",
          "required": true
        },
        {
          "name": "venue",
          "kind": "text",
          "fake": "company.name"
        },
        {
          "name": "startsAt",
          "kind": "datetime",
          "required": true,
          "window": "around"
        },
        {
          "name": "capacity",
          "kind": "integer",
          "min": 1,
          "trend": "decline"
        }
      ],
      "titleField": "title",
      "searchable": ["title", "venue"]
    },
    {
      "name": "ticket-type",
      "plural": "ticket-types",
      "fields": [
        {
          "name": "name",
          "kind": "text",
          "required": true
        },
        {
          "name": "event",
          "kind": "relation",
          "to": "event",
          "required": true,
          "onDelete": "cascade"
        },
        {
          "name": "price",
          "kind": "money",
          "currency": "USD",
          "min": 0,
          "required": true,
          "trend": "decline"
        },
        {
          "name": "quota",
          "kind": "integer",
          "min": 1,
          "trend": "decline"
        }
      ],
      "titleField": "name"
    },
    {
      "name": "order",
      "plural": "orders",
      "fields": [
        {
          "name": "ticketType",
          "kind": "relation",
          "to": "ticket-type",
          "required": true,
          "onDelete": "restrict"
        },
        {
          "name": "buyerName",
          "kind": "text",
          "required": true,
          "fake": "person.fullName"
        },
        {
          "name": "buyerEmail",
          "kind": "email",
          "fake": "internet.email"
        },
        {
          "name": "quantity",
          "kind": "integer",
          "min": 1,
          "default": 1,
          "trend": "decline"
        },
        {
          "name": "status",
          "kind": "enum",
          "values": ["pending", "paid", "refunded"],
          "default": "pending",
          "required": true,
          "weights": [3, 2, 1]
        }
      ],
      "titleField": "buyerName"
    },
    {
      "name": "venue",
      "plural": "venues",
      "fields": [
        {
          "name": "name",
          "kind": "text",
          "required": true
        },
        {
          "name": "event",
          "kind": "relation",
          "to": "event",
          "required": true,
          "onDelete": "cascade"
        },
        {
          "name": "status",
          "kind": "enum",
          "values": ["planned", "active", "complete"],
          "default": "planned",
          "required": true,
          "weights": [5, 3, 2]
        },
        {
          "name": "startsAt",
          "kind": "datetime",
          "window": "around"
        },
        {
          "name": "value",
          "kind": "money",
          "min": 5000,
          "max": 250000,
          "trend": "seasonal"
        }
      ],
      "titleField": "name",
      "searchable": ["name"]
    }
  ],
  "roles": [
    {
      "name": "owner",
      "permissions": {
        "*": ["*"]
      }
    },
    {
      "name": "member",
      "permissions": {
        "*": ["read", "create", "update", "delete", "import", "export"]
      }
    },
    {
      "name": "viewer",
      "permissions": {
        "*": ["read"]
      }
    }
  ],
  "screens": [
    {
      "type": "dashboard",
      "path": "/dashboard",
      "title": "Gatepass Events overview",
      "nav": {
        "label": "Overview",
        "icon": "layout-dashboard",
        "order": 0
      },
      "widgets": [
        {
          "kind": "kpi",
          "label": "Total events",
          "entity": "event",
          "aggregate": "count",
          "span": 1
        },
        {
          "kind": "chart",
          "label": "events over time",
          "entity": "event",
          "aggregate": "sum",
          "field": "capacity",
          "chart": "line",
          "bucket": {
            "field": "createdAt",
            "unit": "month"
          },
          "span": 3
        }
      ]
    },
    {
      "type": "list",
      "entity": "event",
      "columns": ["title", "venue", "startsAt"]
    },
    {
      "type": "form",
      "entity": "event"
    },
    {
      "type": "list",
      "entity": "ticket-type",
      "columns": ["name", "event", "price"]
    },
    {
      "type": "form",
      "entity": "ticket-type"
    },
    {
      "type": "list",
      "entity": "order",
      "columns": ["ticketType", "buyerName", "buyerEmail"]
    },
    {
      "type": "form",
      "entity": "order"
    },
    {
      "type": "calendar",
      "entity": "event",
      "dateField": "startsAt",
      "view": "month",
      "path": "/events/calendar",
      "title": "Events calendar",
      "nav": {
        "label": "Calendar",
        "icon": "calendar",
        "order": 20
      }
    },
    {
      "type": "detail",
      "entity": "event",
      "tabs": ["overview"],
      "path": "/events/:id",
      "title": "Event details",
      "nav": {
        "label": "Details",
        "icon": "file-text",
        "hidden": true
      }
    },
    {
      "type": "settings",
      "sections": ["profile", "appearance"],
      "path": "/settings",
      "title": "Settings",
      "nav": {
        "label": "Settings",
        "icon": "settings",
        "order": 999
      }
    }
  ]
}

{
  "$schema": "../packages/blueprint/schema/blueprint.schema.json",
  "formatVersion": 1,
  "name": "Stride Fitness",
  "description": "Workouts, sets and goals for a fictional fitness mobile app.",
  "icon": "🏃",
  "category": "health",
  "tags": ["fitness", "mobile", "workouts"],
  "catalog": {
    "category": "health",
    "productType": "Fitness",
    "platforms": ["mobile"],
    "features": ["workouts", "goals"],
    "highlights": ["Workout log", "Set tracking", "Weekly goals"],
    "difficulty": "intermediate"
  },
  "brand": {
    "id": "fitness-mobile-brand",
    "name": "Stride Fitness",
    "seed": "#ea580c",
    "styleProfile": "rounded",
    "font": "geometric"
  },
  "entities": [
    {
      "name": "workout",
      "plural": "workouts",
      "fields": [
        {
          "name": "title",
          "kind": "text",
          "required": true
        },
        {
          "name": "athlete",
          "kind": "persona",
          "required": true
        },
        {
          "name": "performedOn",
          "kind": "date",
          "required": true,
          "window": "past"
        },
        {
          "name": "durationMin",
          "kind": "integer",
          "min": 1,
          "trend": "decline"
        },
        {
          "name": "startsAt",
          "kind": "datetime",
          "window": "past"
        },
        {
          "name": "endsAt",
          "kind": "datetime",
          "window": "around"
        }
      ],
      "titleField": "title",
      "ownerField": "athlete"
    },
    {
      "name": "set",
      "plural": "sets",
      "fields": [
        {
          "name": "workout",
          "kind": "relation",
          "to": "workout",
          "required": true,
          "onDelete": "cascade"
        },
        {
          "name": "exercise",
          "kind": "text",
          "required": true
        },
        {
          "name": "reps",
          "kind": "integer",
          "min": 1,
          "trend": "decline"
        },
        {
          "name": "weightKg",
          "kind": "number",
          "min": 0,
          "trend": "decline"
        }
      ],
      "titleField": "exercise"
    },
    {
      "name": "goal",
      "plural": "goals",
      "fields": [
        {
          "name": "title",
          "kind": "text",
          "required": true
        },
        {
          "name": "athlete",
          "kind": "persona",
          "required": true
        },
        {
          "name": "target",
          "kind": "number",
          "required": true,
          "trend": "decline"
        },
        {
          "name": "unit",
          "kind": "enum",
          "values": ["km", "kg", "sessions"],
          "default": "km",
          "required": true,
          "weights": [3, 2, 1]
        },
        {
          "name": "dueOn",
          "kind": "date",
          "window": "around"
        }
      ],
      "titleField": "title",
      "ownerField": "athlete"
    },
    {
      "name": "training-plan",
      "plural": "training-plans",
      "fields": [
        {
          "name": "name",
          "kind": "text",
          "required": true
        },
        {
          "name": "workout",
          "kind": "relation",
          "to": "workout",
          "required": true,
          "onDelete": "cascade"
        },
        {
          "name": "status",
          "kind": "enum",
          "values": ["planned", "active", "complete"],
          "default": "planned",
          "required": true,
          "weights": [5, 3, 2]
        },
        {
          "name": "startsAt",
          "kind": "datetime",
          "window": "around"
        },
        {
          "name": "value",
          "kind": "money",
          "min": 5000,
          "max": 250000,
          "trend": "seasonal"
        }
      ],
      "titleField": "name",
      "searchable": ["name"]
    }
  ],
  "roles": [
    {
      "name": "owner",
      "permissions": {
        "*": ["*"]
      }
    },
    {
      "name": "member",
      "permissions": {
        "*": ["read", "create", "update", "delete", "import", "export"]
      }
    },
    {
      "name": "viewer",
      "permissions": {
        "*": ["read"]
      }
    }
  ],
  "screens": [
    {
      "type": "dashboard",
      "path": "/dashboard",
      "title": "Stride Fitness overview",
      "nav": {
        "label": "Overview",
        "icon": "layout-dashboard",
        "order": 0
      },
      "widgets": [
        {
          "kind": "kpi",
          "label": "Total workouts",
          "entity": "workout",
          "aggregate": "count",
          "span": 1
        },
        {
          "kind": "chart",
          "label": "workouts over time",
          "entity": "workout",
          "aggregate": "sum",
          "field": "durationMin",
          "chart": "line",
          "bucket": {
            "field": "createdAt",
            "unit": "month"
          },
          "span": 3
        }
      ]
    },
    {
      "type": "list",
      "entity": "workout",
      "columns": ["title", "athlete", "performedOn"]
    },
    {
      "type": "form",
      "entity": "workout"
    },
    {
      "type": "list",
      "entity": "set",
      "columns": ["workout", "exercise", "reps"]
    },
    {
      "type": "form",
      "entity": "set"
    },
    {
      "type": "list",
      "entity": "goal",
      "columns": ["title", "athlete", "target"]
    },
    {
      "type": "form",
      "entity": "goal"
    },
    {
      "type": "timeline",
      "entity": "workout",
      "startField": "startsAt",
      "endField": "endsAt",
      "zoom": "month",
      "path": "/workouts/timeline",
      "title": "Workouts timeline",
      "nav": {
        "label": "Timeline",
        "icon": "clock",
        "order": 20
      }
    },
    {
      "type": "detail",
      "entity": "workout",
      "tabs": ["overview"],
      "path": "/workouts/:id",
      "title": "Workout details",
      "nav": {
        "label": "Details",
        "icon": "file-text",
        "hidden": true
      }
    },
    {
      "type": "settings",
      "sections": ["profile", "appearance"],
      "path": "/settings",
      "title": "Settings",
      "nav": {
        "label": "Settings",
        "icon": "settings",
        "order": 999
      }
    }
  ]
}

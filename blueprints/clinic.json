{
  "$schema": "../packages/blueprint/schema/blueprint.schema.json",
  "formatVersion": 1,
  "name": "Harbor Clinic",
  "description": "Patients, visits and prescriptions for a fictional clinic.",
  "icon": "🏥",
  "category": "health",
  "tags": ["health", "clinic", "patients"],
  "catalog": {
    "category": "health",
    "productType": "Clinic",
    "platforms": ["web"],
    "features": ["visits", "rx"],
    "highlights": ["Patient chart", "Visit notes", "Rx list"],
    "difficulty": "intermediate"
  },
  "brand": {
    "id": "clinic-brand",
    "name": "Harbor Clinic",
    "seed": "#059669",
    "styleProfile": "soft",
    "font": "humanist"
  },
  "entities": [
    {
      "name": "patient",
      "plural": "patients",
      "fields": [
        {
          "name": "fullName",
          "kind": "text",
          "required": true,
          "fake": "person.fullName"
        },
        {
          "name": "email",
          "kind": "email",
          "fake": "internet.email"
        },
        {
          "name": "phone",
          "kind": "phone"
        },
        {
          "name": "dob",
          "kind": "date",
          "window": "past"
        }
      ],
      "titleField": "fullName",
      "searchable": ["fullName", "email"]
    },
    {
      "name": "visit",
      "plural": "visits",
      "fields": [
        {
          "name": "patient",
          "kind": "relation",
          "to": "patient",
          "required": true,
          "onDelete": "cascade"
        },
        {
          "name": "clinician",
          "kind": "persona"
        },
        {
          "name": "visitedAt",
          "kind": "datetime",
          "required": true,
          "window": "around"
        },
        {
          "name": "reason",
          "kind": "text"
        },
        {
          "name": "notes",
          "kind": "longText"
        }
      ],
      "titleField": "reason",
      "features": {
        "audit": true
      }
    },
    {
      "name": "prescription",
      "plural": "prescriptions",
      "fields": [
        {
          "name": "visit",
          "kind": "relation",
          "to": "visit",
          "required": true,
          "onDelete": "cascade"
        },
        {
          "name": "medication",
          "kind": "text",
          "required": true
        },
        {
          "name": "dose",
          "kind": "text"
        },
        {
          "name": "status",
          "kind": "enum",
          "values": ["active", "completed", "stopped"],
          "default": "active",
          "required": true,
          "weights": [3, 2, 1]
        }
      ],
      "titleField": "medication"
    },
    {
      "name": "care-plan",
      "plural": "care-plans",
      "fields": [
        {
          "name": "name",
          "kind": "text",
          "required": true
        },
        {
          "name": "patient",
          "kind": "relation",
          "to": "patient",
          "required": true,
          "onDelete": "cascade"
        },
        {
          "name": "status",
          "kind": "enum",
          "values": ["planned", "active", "complete"],
          "default": "planned",
          "required": true,
          "weights": [5, 3, 2]
        },
        {
          "name": "startsAt",
          "kind": "datetime",
          "window": "around"
        },
        {
          "name": "value",
          "kind": "money",
          "min": 5000,
          "max": 250000,
          "trend": "seasonal"
        }
      ],
      "titleField": "name",
      "searchable": ["name"]
    }
  ],
  "roles": [
    {
      "name": "owner",
      "permissions": {
        "*": ["*"]
      }
    },
    {
      "name": "member",
      "permissions": {
        "*": ["read", "create", "update", "delete", "import", "export"]
      }
    },
    {
      "name": "viewer",
      "permissions": {
        "*": ["read"]
      }
    }
  ],
  "screens": [
    {
      "type": "dashboard",
      "path": "/dashboard",
      "title": "Harbor Clinic overview",
      "nav": {
        "label": "Overview",
        "icon": "layout-dashboard",
        "order": 0
      },
      "widgets": [
        {
          "kind": "kpi",
          "label": "Total patients",
          "entity": "patient",
          "aggregate": "count",
          "span": 1
        },
        {
          "kind": "chart",
          "label": "patients over time",
          "entity": "patient",
          "aggregate": "count",
          "chart": "line",
          "bucket": {
            "field": "createdAt",
            "unit": "month"
          },
          "span": 3
        }
      ]
    },
    {
      "type": "list",
      "entity": "patient",
      "columns": ["fullName", "email", "phone"]
    },
    {
      "type": "form",
      "entity": "patient"
    },
    {
      "type": "list",
      "entity": "visit",
      "columns": ["patient", "clinician", "visitedAt"]
    },
    {
      "type": "form",
      "entity": "visit"
    },
    {
      "type": "list",
      "entity": "prescription",
      "columns": ["visit", "medication", "dose"]
    },
    {
      "type": "form",
      "entity": "prescription"
    },
    {
      "type": "calendar",
      "entity": "patient",
      "dateField": "dob",
      "view": "month",
      "path": "/patients/calendar",
      "title": "Patients calendar",
      "nav": {
        "label": "Calendar",
        "icon": "calendar",
        "order": 20
      }
    },
    {
      "type": "detail",
      "entity": "patient",
      "tabs": ["overview"],
      "path": "/patients/:id",
      "title": "Patient details",
      "nav": {
        "label": "Details",
        "icon": "file-text",
        "hidden": true
      }
    },
    {
      "type": "settings",
      "sections": ["profile", "appearance"],
      "path": "/settings",
      "title": "Settings",
      "nav": {
        "label": "Settings",
        "icon": "settings",
        "order": 999
      }
    }
  ]
}

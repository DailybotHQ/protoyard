{
  "$schema": "../packages/blueprint/schema/blueprint.schema.json",
  "formatVersion": 1,
  "name": "Neighborhood Feed",
  "description": "Posts, reactions and follows for a fictional social network.",
  "icon": "💬",
  "category": "social",
  "tags": ["social", "feed", "community"],
  "catalog": {
    "category": "social",
    "productType": "Social",
    "platforms": ["web", "mobile"],
    "features": ["reactions", "follows"],
    "highlights": ["Local feed", "Reactions", "Follow graph"],
    "difficulty": "intermediate"
  },
  "brand": {
    "id": "social-feed-brand",
    "name": "Neighborhood Feed",
    "seed": "#e11d48",
    "styleProfile": "rounded",
    "font": "rounded"
  },
  "entities": [
    {
      "name": "post",
      "plural": "posts",
      "fields": [
        {
          "name": "label",
          "kind": "text",
          "required": true
        },
        {
          "name": "body",
          "kind": "longText",
          "required": true
        },
        {
          "name": "author",
          "kind": "persona",
          "required": true
        },
        {
          "name": "postedAt",
          "kind": "datetime",
          "window": "around"
        },
        {
          "name": "workflowStatus",
          "kind": "enum",
          "values": ["planned", "active", "complete"],
          "default": "planned",
          "weights": [5, 3, 2]
        }
      ],
      "titleField": "label",
      "ownerField": "author"
    },
    {
      "name": "reaction",
      "plural": "reactions",
      "fields": [
        {
          "name": "post",
          "kind": "relation",
          "to": "post",
          "required": true,
          "onDelete": "cascade"
        },
        {
          "name": "actor",
          "kind": "persona",
          "required": true
        },
        {
          "name": "emoji",
          "kind": "enum",
          "values": ["like", "love", "wow", "sad"],
          "default": "like",
          "required": true,
          "weights": [4, 3, 2, 1]
        }
      ],
      "titleField": "emoji"
    },
    {
      "name": "follow",
      "plural": "follows",
      "fields": [
        {
          "name": "label",
          "kind": "text",
          "required": true
        },
        {
          "name": "follower",
          "kind": "persona",
          "required": true
        },
        {
          "name": "following",
          "kind": "persona",
          "required": true
        }
      ],
      "titleField": "label"
    },
    {
      "name": "community",
      "plural": "communities",
      "fields": [
        {
          "name": "name",
          "kind": "text",
          "required": true
        },
        {
          "name": "post",
          "kind": "relation",
          "to": "post",
          "required": true,
          "onDelete": "cascade"
        },
        {
          "name": "status",
          "kind": "enum",
          "values": ["planned", "active", "complete"],
          "default": "planned",
          "required": true,
          "weights": [5, 3, 2]
        },
        {
          "name": "startsAt",
          "kind": "datetime",
          "window": "around"
        },
        {
          "name": "value",
          "kind": "money",
          "min": 5000,
          "max": 250000,
          "trend": "growth"
        }
      ],
      "titleField": "name",
      "searchable": ["name"]
    }
  ],
  "roles": [
    {
      "name": "owner",
      "permissions": {
        "*": ["*"]
      }
    },
    {
      "name": "member",
      "permissions": {
        "*": ["read", "create", "update", "delete", "import", "export"]
      }
    },
    {
      "name": "viewer",
      "permissions": {
        "*": ["read"]
      }
    }
  ],
  "screens": [
    {
      "type": "dashboard",
      "path": "/dashboard",
      "title": "Neighborhood Feed overview",
      "nav": {
        "label": "Overview",
        "icon": "layout-dashboard",
        "order": 0
      },
      "widgets": [
        {
          "kind": "kpi",
          "label": "Total posts",
          "entity": "post",
          "aggregate": "count",
          "span": 1
        },
        {
          "kind": "chart",
          "label": "posts over time",
          "entity": "post",
          "aggregate": "count",
          "chart": "line",
          "bucket": {
            "field": "createdAt",
            "unit": "month"
          },
          "span": 3
        },
        {
          "kind": "board-summary",
          "label": "posts by status",
          "entity": "post",
          "groupBy": "workflowStatus",
          "span": 2
        }
      ]
    },
    {
      "type": "list",
      "entity": "post",
      "columns": ["body", "author", "postedAt"]
    },
    {
      "type": "form",
      "entity": "post"
    },
    {
      "type": "list",
      "entity": "reaction",
      "columns": ["post", "actor", "emoji"]
    },
    {
      "type": "form",
      "entity": "reaction"
    },
    {
      "type": "list",
      "entity": "follow",
      "columns": ["follower", "following"]
    },
    {
      "type": "form",
      "entity": "follow"
    },
    {
      "type": "board",
      "entity": "post",
      "groupBy": "workflowStatus",
      "cardFields": ["label"],
      "path": "/posts/board",
      "title": "Posts board",
      "nav": {
        "label": "Board",
        "icon": "kanban",
        "order": 20
      }
    },
    {
      "type": "detail",
      "entity": "post",
      "tabs": ["overview"],
      "path": "/posts/:id",
      "title": "Post details",
      "nav": {
        "label": "Details",
        "icon": "file-text",
        "hidden": true
      }
    },
    {
      "type": "settings",
      "sections": ["profile", "appearance"],
      "path": "/settings",
      "title": "Settings",
      "nav": {
        "label": "Settings",
        "icon": "settings",
        "order": 999
      }
    }
  ]
}

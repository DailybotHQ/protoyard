{
  "$schema": "../packages/blueprint/schema/blueprint.schema.json",
  "formatVersion": 1,
  "name": "Casebook Legal",
  "description": "Matters, time entries and documents for a fictional law desk.",
  "icon": "⚖️",
  "category": "internal-tools",
  "tags": ["legal", "matters", "billing"],
  "catalog": {
    "category": "internal-tools",
    "productType": "Legal",
    "platforms": ["web"],
    "features": ["timekeeping", "documents"],
    "highlights": ["Matter docket", "Billable time", "Document list"],
    "difficulty": "intermediate"
  },
  "brand": {
    "id": "legal-matters-brand",
    "name": "Casebook Legal",
    "seed": "#334155",
    "styleProfile": "flat",
    "font": "system"
  },
  "entities": [
    {
      "name": "matter",
      "plural": "matters",
      "fields": [
        {
          "name": "title",
          "kind": "text",
          "required": true
        },
        {
          "name": "status",
          "kind": "enum",
          "values": ["open", "discovery", "trial", "closed"],
          "default": "open",
          "required": true,
          "weights": [4, 3, 2, 1]
        },
        {
          "name": "clientName",
          "kind": "text",
          "fake": "company.name"
        },
        {
          "name": "leadAttorney",
          "kind": "persona"
        },
        {
          "name": "startsAt",
          "kind": "datetime",
          "window": "past"
        },
        {
          "name": "endsAt",
          "kind": "datetime",
          "window": "around"
        }
      ],
      "titleField": "title",
      "ownerField": "leadAttorney",
      "searchable": ["title", "clientName"]
    },
    {
      "name": "time-entry",
      "plural": "time-entries",
      "fields": [
        {
          "name": "label",
          "kind": "text",
          "required": true
        },
        {
          "name": "matter",
          "kind": "relation",
          "to": "matter",
          "required": true,
          "onDelete": "cascade"
        },
        {
          "name": "attorney",
          "kind": "persona",
          "required": true
        },
        {
          "name": "hours",
          "kind": "number",
          "min": 0.1,
          "required": true,
          "trend": "growth"
        },
        {
          "name": "workedOn",
          "kind": "date",
          "required": true,
          "window": "past"
        },
        {
          "name": "narrative",
          "kind": "longText"
        }
      ],
      "titleField": "label"
    },
    {
      "name": "document",
      "plural": "documents",
      "fields": [
        {
          "name": "matter",
          "kind": "relation",
          "to": "matter",
          "required": true,
          "onDelete": "cascade"
        },
        {
          "name": "title",
          "kind": "text",
          "required": true
        },
        {
          "name": "file",
          "kind": "file",
          "accept": ["application/pdf"]
        },
        {
          "name": "filedOn",
          "kind": "date",
          "window": "past"
        }
      ],
      "titleField": "title",
      "features": {
        "files": true
      }
    },
    {
      "name": "hearing",
      "plural": "hearings",
      "fields": [
        {
          "name": "name",
          "kind": "text",
          "required": true
        },
        {
          "name": "matter",
          "kind": "relation",
          "to": "matter",
          "required": true,
          "onDelete": "cascade"
        },
        {
          "name": "status",
          "kind": "enum",
          "values": ["planned", "active", "complete"],
          "default": "planned",
          "required": true,
          "weights": [5, 3, 2]
        },
        {
          "name": "startsAt",
          "kind": "datetime",
          "window": "around"
        },
        {
          "name": "value",
          "kind": "money",
          "min": 5000,
          "max": 250000,
          "trend": "growth"
        }
      ],
      "titleField": "name",
      "searchable": ["name"]
    }
  ],
  "roles": [
    {
      "name": "owner",
      "permissions": {
        "*": ["*"]
      }
    },
    {
      "name": "member",
      "permissions": {
        "*": ["read", "create", "update", "delete", "import", "export"]
      }
    },
    {
      "name": "viewer",
      "permissions": {
        "*": ["read"]
      }
    }
  ],
  "screens": [
    {
      "type": "dashboard",
      "path": "/dashboard",
      "title": "Casebook Legal overview",
      "nav": {
        "label": "Overview",
        "icon": "layout-dashboard",
        "order": 0
      },
      "widgets": [
        {
          "kind": "kpi",
          "label": "Total matters",
          "entity": "matter",
          "aggregate": "count",
          "span": 1
        },
        {
          "kind": "chart",
          "label": "matters over time",
          "entity": "matter",
          "aggregate": "count",
          "chart": "line",
          "bucket": {
            "field": "createdAt",
            "unit": "month"
          },
          "span": 3
        },
        {
          "kind": "board-summary",
          "label": "matters by status",
          "entity": "matter",
          "groupBy": "status",
          "span": 2
        }
      ]
    },
    {
      "type": "list",
      "entity": "matter",
      "columns": ["title", "status", "clientName"]
    },
    {
      "type": "form",
      "entity": "matter"
    },
    {
      "type": "list",
      "entity": "time-entry",
      "columns": ["matter", "attorney", "hours"]
    },
    {
      "type": "form",
      "entity": "time-entry"
    },
    {
      "type": "list",
      "entity": "document",
      "columns": ["matter", "title", "file"]
    },
    {
      "type": "form",
      "entity": "document"
    },
    {
      "type": "timeline",
      "entity": "matter",
      "startField": "startsAt",
      "endField": "endsAt",
      "groupBy": "status",
      "zoom": "month",
      "path": "/matters/timeline",
      "title": "Matters timeline",
      "nav": {
        "label": "Timeline",
        "icon": "clock",
        "order": 20
      }
    },
    {
      "type": "detail",
      "entity": "matter",
      "tabs": ["overview"],
      "path": "/matters/:id",
      "title": "Matter details",
      "nav": {
        "label": "Details",
        "icon": "file-text",
        "hidden": true
      }
    },
    {
      "type": "settings",
      "sections": ["profile", "appearance"],
      "path": "/settings",
      "title": "Settings",
      "nav": {
        "label": "Settings",
        "icon": "settings",
        "order": 999
      }
    }
  ]
}

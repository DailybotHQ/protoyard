{
  "$schema": "../packages/blueprint/schema/blueprint.schema.json",
  "formatVersion": 1,
  "name": "Quill CMS",
  "description": "Posts, authors and tags for a fictional content studio.",
  "icon": "✍️",
  "category": "media",
  "tags": ["cms", "blog", "content"],
  "catalog": {
    "category": "media",
    "productType": "CMS",
    "platforms": ["web"],
    "features": ["drafts", "tags"],
    "highlights": ["Post drafts", "Author personas", "Tag cloud"],
    "difficulty": "intermediate"
  },
  "brand": {
    "id": "cms-blog-brand",
    "name": "Quill CMS",
    "seed": "#6b21a8",
    "styleProfile": "editorial",
    "font": "editorial"
  },
  "entities": [
    {
      "name": "post",
      "plural": "posts",
      "fields": [
        {
          "name": "title",
          "kind": "text",
          "required": true
        },
        {
          "name": "slug",
          "kind": "text",
          "required": true
        },
        {
          "name": "body",
          "kind": "longText"
        },
        {
          "name": "status",
          "kind": "enum",
          "values": ["draft", "scheduled", "published"],
          "default": "draft",
          "required": true,
          "weights": [3, 2, 1]
        },
        {
          "name": "author",
          "kind": "persona"
        },
        {
          "name": "publishedAt",
          "kind": "datetime",
          "window": "around"
        },
        {
          "name": "value",
          "kind": "number",
          "min": 0,
          "max": 100,
          "trend": "growth"
        }
      ],
      "titleField": "title",
      "ownerField": "author",
      "searchable": ["title", "slug"]
    },
    {
      "name": "tag",
      "plural": "tags",
      "fields": [
        {
          "name": "name",
          "kind": "text",
          "required": true
        },
        {
          "name": "slug",
          "kind": "text",
          "required": true
        }
      ],
      "titleField": "name"
    },
    {
      "name": "post-tag",
      "plural": "post-tags",
      "fields": [
        {
          "name": "label",
          "kind": "text",
          "required": true
        },
        {
          "name": "post",
          "kind": "relation",
          "to": "post",
          "required": true,
          "onDelete": "cascade"
        },
        {
          "name": "tag",
          "kind": "relation",
          "to": "tag",
          "required": true,
          "onDelete": "cascade"
        }
      ],
      "titleField": "label"
    },
    {
      "name": "author",
      "plural": "authors",
      "fields": [
        {
          "name": "name",
          "kind": "text",
          "required": true
        },
        {
          "name": "post",
          "kind": "relation",
          "to": "post",
          "required": true,
          "onDelete": "cascade"
        },
        {
          "name": "status",
          "kind": "enum",
          "values": ["planned", "active", "complete"],
          "default": "planned",
          "required": true,
          "weights": [5, 3, 2]
        },
        {
          "name": "startsAt",
          "kind": "datetime",
          "window": "around"
        },
        {
          "name": "value",
          "kind": "money",
          "min": 5000,
          "max": 250000,
          "trend": "seasonal"
        }
      ],
      "titleField": "name",
      "searchable": ["name"]
    }
  ],
  "roles": [
    {
      "name": "owner",
      "permissions": {
        "*": ["*"]
      }
    },
    {
      "name": "member",
      "permissions": {
        "*": ["read", "create", "update", "delete", "import", "export"]
      }
    },
    {
      "name": "viewer",
      "permissions": {
        "*": ["read"]
      }
    }
  ],
  "screens": [
    {
      "type": "dashboard",
      "path": "/dashboard",
      "title": "Quill CMS overview",
      "nav": {
        "label": "Overview",
        "icon": "layout-dashboard",
        "order": 0
      },
      "widgets": [
        {
          "kind": "kpi",
          "label": "Total posts",
          "entity": "post",
          "aggregate": "count",
          "span": 1
        },
        {
          "kind": "chart",
          "label": "posts over time",
          "entity": "post",
          "aggregate": "sum",
          "field": "value",
          "chart": "line",
          "bucket": {
            "field": "createdAt",
            "unit": "month"
          },
          "span": 3
        },
        {
          "kind": "board-summary",
          "label": "posts by status",
          "entity": "post",
          "groupBy": "status",
          "span": 2
        }
      ]
    },
    {
      "type": "list",
      "entity": "post",
      "columns": ["title", "slug", "body"]
    },
    {
      "type": "form",
      "entity": "post"
    },
    {
      "type": "list",
      "entity": "tag",
      "columns": ["name", "slug"]
    },
    {
      "type": "form",
      "entity": "tag"
    },
    {
      "type": "list",
      "entity": "post-tag",
      "columns": ["post", "tag"]
    },
    {
      "type": "form",
      "entity": "post-tag"
    },
    {
      "type": "analytics",
      "entity": "post",
      "dateField": "createdAt",
      "measures": [
        {
          "label": "Total value",
          "aggregate": "sum",
          "field": "value"
        }
      ],
      "dimensions": ["status"],
      "path": "/posts/analytics",
      "title": "Posts analytics",
      "nav": {
        "label": "Analytics",
        "icon": "chart-line",
        "order": 20
      }
    },
    {
      "type": "detail",
      "entity": "post",
      "tabs": ["overview"],
      "path": "/posts/:id",
      "title": "Post details",
      "nav": {
        "label": "Details",
        "icon": "file-text",
        "hidden": true
      }
    },
    {
      "type": "settings",
      "sections": ["profile", "appearance"],
      "path": "/settings",
      "title": "Settings",
      "nav": {
        "label": "Settings",
        "icon": "settings",
        "order": 999
      }
    }
  ]
}

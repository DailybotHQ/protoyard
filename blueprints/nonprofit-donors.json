{
  "$schema": "../packages/blueprint/schema/blueprint.schema.json",
  "formatVersion": 1,
  "name": "Kindling Donors",
  "description": "Donors, gifts and campaigns for a fictional nonprofit.",
  "icon": "💛",
  "category": "finance",
  "tags": ["nonprofit", "donors", "campaigns"],
  "catalog": {
    "category": "finance",
    "productType": "Nonprofit",
    "platforms": ["web"],
    "features": ["gifts", "campaigns"],
    "highlights": ["Donor CRM", "Campaign goals", "Gift receipts"],
    "difficulty": "intermediate"
  },
  "brand": {
    "id": "nonprofit-donors-brand",
    "name": "Kindling Donors",
    "seed": "#be123c",
    "styleProfile": "soft",
    "font": "humanist"
  },
  "entities": [
    {
      "name": "donor",
      "plural": "donors",
      "fields": [
        {
          "name": "fullName",
          "kind": "text",
          "required": true,
          "fake": "person.fullName"
        },
        {
          "name": "email",
          "kind": "email",
          "fake": "internet.email"
        },
        {
          "name": "city",
          "kind": "text",
          "fake": "location.city"
        },
        {
          "name": "location",
          "kind": "geo",
          "region": "harbor-bay"
        }
      ],
      "titleField": "fullName",
      "searchable": ["fullName", "email"]
    },
    {
      "name": "campaign",
      "plural": "campaigns",
      "fields": [
        {
          "name": "name",
          "kind": "text",
          "required": true
        },
        {
          "name": "goal",
          "kind": "money",
          "currency": "USD",
          "min": 0,
          "required": true,
          "trend": "decline"
        },
        {
          "name": "startsOn",
          "kind": "date",
          "window": "around"
        },
        {
          "name": "endsOn",
          "kind": "date",
          "window": "past"
        }
      ],
      "titleField": "name"
    },
    {
      "name": "gift",
      "plural": "gifts",
      "fields": [
        {
          "name": "label",
          "kind": "text",
          "required": true
        },
        {
          "name": "donor",
          "kind": "relation",
          "to": "donor",
          "required": true,
          "onDelete": "cascade"
        },
        {
          "name": "campaign",
          "kind": "relation",
          "to": "campaign",
          "required": true,
          "onDelete": "restrict"
        },
        {
          "name": "amount",
          "kind": "money",
          "currency": "USD",
          "min": 1,
          "required": true,
          "trend": "decline"
        },
        {
          "name": "givenOn",
          "kind": "date",
          "required": true,
          "window": "past"
        }
      ],
      "titleField": "label",
      "features": {
        "audit": true
      }
    },
    {
      "name": "fundraiser",
      "plural": "fundraisers",
      "fields": [
        {
          "name": "name",
          "kind": "text",
          "required": true
        },
        {
          "name": "campaign",
          "kind": "relation",
          "to": "campaign",
          "required": true,
          "onDelete": "cascade"
        },
        {
          "name": "status",
          "kind": "enum",
          "values": ["planned", "active", "complete"],
          "default": "planned",
          "required": true,
          "weights": [5, 3, 2]
        },
        {
          "name": "startsAt",
          "kind": "datetime",
          "window": "around"
        },
        {
          "name": "value",
          "kind": "money",
          "min": 5000,
          "max": 250000,
          "trend": "seasonal"
        }
      ],
      "titleField": "name",
      "searchable": ["name"]
    }
  ],
  "roles": [
    {
      "name": "owner",
      "permissions": {
        "*": ["*"]
      }
    },
    {
      "name": "member",
      "permissions": {
        "*": ["read", "create", "update", "delete", "import", "export"]
      }
    },
    {
      "name": "viewer",
      "permissions": {
        "*": ["read"]
      }
    }
  ],
  "screens": [
    {
      "type": "dashboard",
      "path": "/dashboard",
      "title": "Kindling Donors overview",
      "nav": {
        "label": "Overview",
        "icon": "layout-dashboard",
        "order": 0
      },
      "widgets": [
        {
          "kind": "kpi",
          "label": "Total donors",
          "entity": "donor",
          "aggregate": "count",
          "span": 1
        },
        {
          "kind": "chart",
          "label": "donors over time",
          "entity": "donor",
          "aggregate": "count",
          "chart": "line",
          "bucket": {
            "field": "createdAt",
            "unit": "month"
          },
          "span": 3
        }
      ]
    },
    {
      "type": "list",
      "entity": "donor",
      "columns": ["fullName", "email", "city"]
    },
    {
      "type": "form",
      "entity": "donor"
    },
    {
      "type": "list",
      "entity": "campaign",
      "columns": ["name", "goal", "startsOn"]
    },
    {
      "type": "form",
      "entity": "campaign"
    },
    {
      "type": "list",
      "entity": "gift",
      "columns": ["donor", "campaign", "amount"]
    },
    {
      "type": "form",
      "entity": "gift"
    },
    {
      "type": "map",
      "entity": "donor",
      "geoField": "location",
      "path": "/donors/map",
      "title": "Donors map",
      "nav": {
        "label": "Map",
        "icon": "map",
        "order": 20
      }
    },
    {
      "type": "detail",
      "entity": "donor",
      "tabs": ["overview"],
      "path": "/donors/:id",
      "title": "Donor details",
      "nav": {
        "label": "Details",
        "icon": "file-text",
        "hidden": true
      }
    },
    {
      "type": "settings",
      "sections": ["profile", "appearance"],
      "path": "/settings",
      "title": "Settings",
      "nav": {
        "label": "Settings",
        "icon": "settings",
        "order": 999
      }
    }
  ]
}

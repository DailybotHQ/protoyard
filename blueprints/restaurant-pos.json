{
  "$schema": "../packages/blueprint/schema/blueprint.schema.json",
  "formatVersion": 1,
  "name": "Tablefire POS",
  "description": "Menus, tickets and payments for a fictional restaurant floor.",
  "icon": "🍽️",
  "category": "commerce",
  "tags": ["restaurant", "pos", "orders"],
  "catalog": {
    "category": "commerce",
    "productType": "POS",
    "platforms": ["web"],
    "features": ["tickets", "payments"],
    "highlights": ["Floor tickets", "Menu items", "Tips in cents"],
    "difficulty": "intermediate"
  },
  "brand": {
    "id": "restaurant-pos-brand",
    "name": "Tablefire POS",
    "seed": "#c2410c",
    "styleProfile": "rounded",
    "font": "rounded"
  },
  "entities": [
    {
      "name": "menu-item",
      "plural": "menu-items",
      "fields": [
        {
          "name": "name",
          "kind": "text",
          "required": true,
          "fake": "commerce.productName"
        },
        {
          "name": "price",
          "kind": "money",
          "currency": "USD",
          "min": 0,
          "required": true,
          "trend": "decline"
        },
        {
          "name": "course",
          "kind": "enum",
          "values": ["starter", "main", "dessert", "drink"],
          "default": "starter",
          "required": true,
          "weights": [4, 3, 2, 1]
        }
      ],
      "titleField": "name",
      "features": {
        "csv": true
      }
    },
    {
      "name": "ticket",
      "plural": "tickets",
      "fields": [
        {
          "name": "table",
          "kind": "text",
          "required": true
        },
        {
          "name": "status",
          "kind": "enum",
          "values": ["open", "sent", "paid", "void"],
          "default": "open",
          "required": true,
          "weights": [4, 3, 2, 1]
        },
        {
          "name": "server",
          "kind": "persona"
        },
        {
          "name": "openedAt",
          "kind": "datetime",
          "window": "around"
        }
      ],
      "titleField": "table",
      "ownerField": "server"
    },
    {
      "name": "ticket-line",
      "plural": "ticket-lines",
      "fields": [
        {
          "name": "ticket",
          "kind": "relation",
          "to": "ticket",
          "required": true,
          "onDelete": "cascade"
        },
        {
          "name": "menuItem",
          "kind": "relation",
          "to": "menu-item",
          "required": true,
          "onDelete": "restrict"
        },
        {
          "name": "quantity",
          "kind": "integer",
          "min": 1,
          "default": 1,
          "trend": "decline"
        },
        {
          "name": "note",
          "kind": "text"
        }
      ],
      "titleField": "note"
    },
    {
      "name": "table",
      "plural": "tables",
      "fields": [
        {
          "name": "name",
          "kind": "text",
          "required": true
        },
        {
          "name": "ticket",
          "kind": "relation",
          "to": "ticket",
          "required": true,
          "onDelete": "cascade"
        },
        {
          "name": "status",
          "kind": "enum",
          "values": ["planned", "active", "complete"],
          "default": "planned",
          "required": true,
          "weights": [5, 3, 2]
        },
        {
          "name": "startsAt",
          "kind": "datetime",
          "window": "around"
        },
        {
          "name": "value",
          "kind": "money",
          "min": 5000,
          "max": 250000,
          "trend": "seasonal"
        }
      ],
      "titleField": "name",
      "searchable": ["name"]
    }
  ],
  "roles": [
    {
      "name": "owner",
      "permissions": {
        "*": ["*"]
      }
    },
    {
      "name": "member",
      "permissions": {
        "*": ["read", "create", "update", "delete", "import", "export"]
      }
    },
    {
      "name": "viewer",
      "permissions": {
        "*": ["read"]
      }
    }
  ],
  "screens": [
    {
      "type": "dashboard",
      "path": "/dashboard",
      "title": "Tablefire POS overview",
      "nav": {
        "label": "Overview",
        "icon": "layout-dashboard",
        "order": 0
      },
      "widgets": [
        {
          "kind": "kpi",
          "label": "Total menu-items",
          "entity": "menu-item",
          "aggregate": "count",
          "span": 1
        },
        {
          "kind": "chart",
          "label": "menu-items over time",
          "entity": "menu-item",
          "aggregate": "sum",
          "field": "price",
          "chart": "line",
          "bucket": {
            "field": "createdAt",
            "unit": "month"
          },
          "span": 3
        },
        {
          "kind": "board-summary",
          "label": "menu-items by status",
          "entity": "menu-item",
          "groupBy": "course",
          "span": 2
        }
      ]
    },
    {
      "type": "list",
      "entity": "menu-item",
      "columns": ["name", "price", "course"]
    },
    {
      "type": "form",
      "entity": "menu-item"
    },
    {
      "type": "list",
      "entity": "ticket",
      "columns": ["table", "status", "server"]
    },
    {
      "type": "form",
      "entity": "ticket"
    },
    {
      "type": "list",
      "entity": "ticket-line",
      "columns": ["ticket", "menuItem", "quantity"]
    },
    {
      "type": "form",
      "entity": "ticket-line"
    },
    {
      "type": "board",
      "entity": "menu-item",
      "groupBy": "course",
      "cardFields": ["name"],
      "path": "/menu-items/board",
      "title": "Menu-items board",
      "nav": {
        "label": "Board",
        "icon": "kanban",
        "order": 20
      }
    },
    {
      "type": "detail",
      "entity": "menu-item",
      "tabs": ["overview"],
      "path": "/menu-items/:id",
      "title": "Menu-item details",
      "nav": {
        "label": "Details",
        "icon": "file-text",
        "hidden": true
      }
    },
    {
      "type": "settings",
      "sections": ["profile", "appearance"],
      "path": "/settings",
      "title": "Settings",
      "nav": {
        "label": "Settings",
        "icon": "settings",
        "order": 999
      }
    }
  ]
}

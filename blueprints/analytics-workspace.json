{
  "$schema": "../packages/blueprint/schema/blueprint.schema.json",
  "formatVersion": 1,
  "name": "Signalboard Analytics",
  "description": "Datasets, charts and dashboards for a fictional analytics desk.",
  "icon": "📊",
  "category": "analytics",
  "tags": ["analytics", "dashboards", "metrics"],
  "catalog": {
    "category": "analytics",
    "productType": "Analytics",
    "platforms": ["web"],
    "features": ["dashboards", "datasets"],
    "highlights": ["Dataset catalog", "Chart specs", "Shared boards"],
    "difficulty": "intermediate"
  },
  "brand": {
    "id": "analytics-workspace-brand",
    "name": "Signalboard Analytics",
    "seed": "#4f46e5",
    "styleProfile": "crisp",
    "font": "mono"
  },
  "entities": [
    {
      "name": "dataset",
      "plural": "datasets",
      "fields": [
        {
          "name": "name",
          "kind": "text",
          "required": true
        },
        {
          "name": "source",
          "kind": "text"
        },
        {
          "name": "rowCount",
          "kind": "integer",
          "min": 0,
          "trend": "growth"
        },
        {
          "name": "owner",
          "kind": "persona"
        }
      ],
      "titleField": "name",
      "ownerField": "owner",
      "searchable": ["name"]
    },
    {
      "name": "chart",
      "plural": "charts",
      "fields": [
        {
          "name": "title",
          "kind": "text",
          "required": true
        },
        {
          "name": "dataset",
          "kind": "relation",
          "to": "dataset",
          "required": true,
          "onDelete": "cascade"
        },
        {
          "name": "kind",
          "kind": "enum",
          "values": ["line", "bar", "pie", "table"],
          "default": "line",
          "required": true,
          "weights": [4, 3, 2, 1]
        },
        {
          "name": "query",
          "kind": "longText"
        }
      ],
      "titleField": "title"
    },
    {
      "name": "dashboard",
      "plural": "dashboards",
      "fields": [
        {
          "name": "name",
          "kind": "text",
          "required": true
        },
        {
          "name": "owner",
          "kind": "persona"
        },
        {
          "name": "published",
          "kind": "boolean",
          "default": false
        },
        {
          "name": "primaryChart",
          "kind": "relation",
          "to": "chart",
          "onDelete": "nullify"
        }
      ],
      "titleField": "name",
      "ownerField": "owner"
    },
    {
      "name": "report",
      "plural": "reports",
      "fields": [
        {
          "name": "name",
          "kind": "text",
          "required": true
        },
        {
          "name": "dashboard",
          "kind": "relation",
          "to": "dashboard",
          "required": true,
          "onDelete": "cascade"
        },
        {
          "name": "status",
          "kind": "enum",
          "values": ["planned", "active", "complete"],
          "default": "planned",
          "required": true,
          "weights": [5, 3, 2]
        },
        {
          "name": "startsAt",
          "kind": "datetime",
          "window": "around"
        },
        {
          "name": "value",
          "kind": "money",
          "min": 5000,
          "max": 250000,
          "trend": "growth"
        }
      ],
      "titleField": "name",
      "searchable": ["name"]
    }
  ],
  "roles": [
    {
      "name": "owner",
      "permissions": {
        "*": ["*"]
      }
    },
    {
      "name": "member",
      "permissions": {
        "*": ["read", "create", "update", "delete", "import", "export"]
      }
    },
    {
      "name": "viewer",
      "permissions": {
        "*": ["read"]
      }
    }
  ],
  "screens": [
    {
      "type": "dashboard",
      "path": "/dashboard",
      "title": "Signalboard Analytics overview",
      "nav": {
        "label": "Overview",
        "icon": "layout-dashboard",
        "order": 0
      },
      "widgets": [
        {
          "kind": "kpi",
          "label": "Total datasets",
          "entity": "dataset",
          "aggregate": "count",
          "span": 1
        },
        {
          "kind": "chart",
          "label": "datasets over time",
          "entity": "dataset",
          "aggregate": "sum",
          "field": "rowCount",
          "chart": "line",
          "bucket": {
            "field": "createdAt",
            "unit": "month"
          },
          "span": 3
        }
      ]
    },
    {
      "type": "list",
      "entity": "dataset",
      "columns": ["name", "source", "rowCount"]
    },
    {
      "type": "form",
      "entity": "dataset"
    },
    {
      "type": "list",
      "entity": "chart",
      "columns": ["title", "dataset", "kind"]
    },
    {
      "type": "form",
      "entity": "chart"
    },
    {
      "type": "list",
      "entity": "dashboard",
      "columns": ["name", "owner", "published"]
    },
    {
      "type": "form",
      "entity": "dashboard"
    },
    {
      "type": "analytics",
      "entity": "dataset",
      "dateField": "createdAt",
      "measures": [
        {
          "label": "Dataset rows",
          "aggregate": "sum",
          "field": "rowCount"
        }
      ],
      "dimensions": [],
      "path": "/datasets/analytics",
      "title": "Dataset analytics",
      "nav": {
        "label": "Analytics",
        "icon": "chart-line",
        "order": 20
      }
    },
    {
      "type": "detail",
      "entity": "dataset",
      "tabs": ["overview"],
      "path": "/datasets/:id",
      "title": "Dataset details",
      "nav": {
        "label": "Details",
        "icon": "file-text",
        "hidden": true
      }
    },
    {
      "type": "settings",
      "sections": ["profile", "appearance"],
      "path": "/settings",
      "title": "Settings",
      "nav": {
        "label": "Settings",
        "icon": "settings",
        "order": 999
      }
    }
  ]
}

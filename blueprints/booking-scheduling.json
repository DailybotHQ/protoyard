{
  "$schema": "../packages/blueprint/schema/blueprint.schema.json",
  "formatVersion": 1,
  "name": "Calendar Booking",
  "description": "Services, slots and appointments for a fictional booking desk.",
  "icon": "📅",
  "category": "operations",
  "tags": ["booking", "calendar", "appointments"],
  "catalog": {
    "category": "operations",
    "productType": "Booking",
    "platforms": ["web"],
    "features": ["slots", "reminders"],
    "highlights": ["Service catalog", "Time slots", "Guest contacts"],
    "difficulty": "intermediate"
  },
  "brand": {
    "id": "booking-scheduling-brand",
    "name": "Calendar Booking",
    "seed": "#0891b2",
    "styleProfile": "soft",
    "font": "system"
  },
  "entities": [
    {
      "name": "service",
      "plural": "services",
      "fields": [
        {
          "name": "name",
          "kind": "text",
          "required": true
        },
        {
          "name": "durationMin",
          "kind": "integer",
          "min": 15,
          "required": true,
          "trend": "seasonal"
        },
        {
          "name": "price",
          "kind": "money",
          "currency": "USD",
          "min": 0,
          "trend": "seasonal"
        },
        {
          "name": "scheduledAt",
          "kind": "datetime",
          "window": "future"
        }
      ],
      "titleField": "name"
    },
    {
      "name": "slot",
      "plural": "slots",
      "fields": [
        {
          "name": "service",
          "kind": "relation",
          "to": "service",
          "required": true,
          "onDelete": "cascade"
        },
        {
          "name": "startsAt",
          "kind": "datetime",
          "required": true,
          "window": "around"
        },
        {
          "name": "capacity",
          "kind": "integer",
          "min": 1,
          "default": 1,
          "trend": "seasonal"
        }
      ],
      "titleField": "capacity"
    },
    {
      "name": "appointment",
      "plural": "appointments",
      "fields": [
        {
          "name": "slot",
          "kind": "relation",
          "to": "slot",
          "required": true,
          "onDelete": "cascade"
        },
        {
          "name": "guestName",
          "kind": "text",
          "required": true,
          "fake": "person.fullName"
        },
        {
          "name": "guestEmail",
          "kind": "email",
          "fake": "internet.email"
        },
        {
          "name": "status",
          "kind": "enum",
          "values": ["booked", "checked-in", "cancelled"],
          "default": "booked",
          "required": true,
          "weights": [3, 2, 1]
        }
      ],
      "titleField": "guestName",
      "features": {
        "notifications": true
      }
    },
    {
      "name": "resource",
      "plural": "resources",
      "fields": [
        {
          "name": "name",
          "kind": "text",
          "required": true
        },
        {
          "name": "service",
          "kind": "relation",
          "to": "service",
          "required": true,
          "onDelete": "cascade"
        },
        {
          "name": "status",
          "kind": "enum",
          "values": ["planned", "active", "complete"],
          "default": "planned",
          "required": true,
          "weights": [5, 3, 2]
        },
        {
          "name": "startsAt",
          "kind": "datetime",
          "window": "around"
        },
        {
          "name": "value",
          "kind": "money",
          "min": 5000,
          "max": 250000,
          "trend": "seasonal"
        }
      ],
      "titleField": "name",
      "searchable": ["name"]
    }
  ],
  "roles": [
    {
      "name": "owner",
      "permissions": {
        "*": ["*"]
      }
    },
    {
      "name": "member",
      "permissions": {
        "*": ["read", "create", "update", "delete", "import", "export"]
      }
    },
    {
      "name": "viewer",
      "permissions": {
        "*": ["read"]
      }
    }
  ],
  "screens": [
    {
      "type": "dashboard",
      "path": "/dashboard",
      "title": "Calendar Booking overview",
      "nav": {
        "label": "Overview",
        "icon": "layout-dashboard",
        "order": 0
      },
      "widgets": [
        {
          "kind": "kpi",
          "label": "Total services",
          "entity": "service",
          "aggregate": "count",
          "span": 1
        },
        {
          "kind": "chart",
          "label": "services over time",
          "entity": "service",
          "aggregate": "sum",
          "field": "durationMin",
          "chart": "line",
          "bucket": {
            "field": "createdAt",
            "unit": "month"
          },
          "span": 3
        }
      ]
    },
    {
      "type": "list",
      "entity": "service",
      "columns": ["name", "durationMin", "price"]
    },
    {
      "type": "form",
      "entity": "service"
    },
    {
      "type": "list",
      "entity": "slot",
      "columns": ["service", "startsAt", "capacity"]
    },
    {
      "type": "form",
      "entity": "slot"
    },
    {
      "type": "list",
      "entity": "appointment",
      "columns": ["slot", "guestName", "guestEmail"]
    },
    {
      "type": "form",
      "entity": "appointment"
    },
    {
      "type": "calendar",
      "entity": "service",
      "dateField": "scheduledAt",
      "view": "month",
      "path": "/services/calendar",
      "title": "Services calendar",
      "nav": {
        "label": "Calendar",
        "icon": "calendar",
        "order": 20
      }
    },
    {
      "type": "detail",
      "entity": "service",
      "tabs": ["overview"],
      "path": "/services/:id",
      "title": "Service details",
      "nav": {
        "label": "Details",
        "icon": "file-text",
        "hidden": true
      }
    },
    {
      "type": "settings",
      "sections": ["profile", "appearance"],
      "path": "/settings",
      "title": "Settings",
      "nav": {
        "label": "Settings",
        "icon": "settings",
        "order": 999
      }
    }
  ]
}

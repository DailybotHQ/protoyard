{
  "$schema": "../packages/blueprint/schema/blueprint.schema.json",
  "formatVersion": 1,
  "name": "Routeline Logistics",
  "description": "Shipments, stops and carriers for a fictional 3PL desk.",
  "icon": "🚚",
  "category": "operations",
  "tags": ["logistics", "shipping", "fleet"],
  "catalog": {
    "category": "operations",
    "productType": "Logistics",
    "platforms": ["web"],
    "features": ["tracking", "carriers"],
    "highlights": ["Shipment tracker", "Multi-stop routes", "Carrier scores"],
    "difficulty": "intermediate"
  },
  "brand": {
    "id": "logistics-brand",
    "name": "Routeline Logistics",
    "seed": "#1e3a8a",
    "styleProfile": "crisp",
    "font": "grotesk"
  },
  "entities": [
    {
      "name": "carrier",
      "plural": "carriers",
      "fields": [
        {
          "name": "name",
          "kind": "text",
          "required": true,
          "fake": "company.name"
        },
        {
          "name": "scac",
          "kind": "text"
        },
        {
          "name": "score",
          "kind": "number",
          "min": 0,
          "max": 5,
          "trend": "seasonal"
        },
        {
          "name": "location",
          "kind": "geo",
          "region": "harbor-bay"
        }
      ],
      "titleField": "name"
    },
    {
      "name": "shipment",
      "plural": "shipments",
      "fields": [
        {
          "name": "reference",
          "kind": "text",
          "required": true
        },
        {
          "name": "carrier",
          "kind": "relation",
          "to": "carrier",
          "required": true,
          "onDelete": "restrict"
        },
        {
          "name": "status",
          "kind": "enum",
          "values": ["booked", "in-transit", "delivered", "exception"],
          "default": "booked",
          "required": true,
          "weights": [4, 3, 2, 1]
        },
        {
          "name": "eta",
          "kind": "datetime",
          "window": "around"
        }
      ],
      "titleField": "reference",
      "searchable": ["reference"],
      "indexes": ["status"]
    },
    {
      "name": "stop",
      "plural": "stops",
      "fields": [
        {
          "name": "shipment",
          "kind": "relation",
          "to": "shipment",
          "required": true,
          "onDelete": "cascade"
        },
        {
          "name": "kind",
          "kind": "enum",
          "values": ["pickup", "delivery"],
          "default": "pickup",
          "required": true,
          "weights": [2, 1]
        },
        {
          "name": "city",
          "kind": "text",
          "required": true,
          "fake": "location.city"
        },
        {
          "name": "sequence",
          "kind": "integer",
          "min": 1,
          "required": true,
          "trend": "seasonal"
        }
      ],
      "titleField": "city"
    },
    {
      "name": "route",
      "plural": "routes",
      "fields": [
        {
          "name": "name",
          "kind": "text",
          "required": true
        },
        {
          "name": "shipment",
          "kind": "relation",
          "to": "shipment",
          "required": true,
          "onDelete": "cascade"
        },
        {
          "name": "status",
          "kind": "enum",
          "values": ["planned", "active", "complete"],
          "default": "planned",
          "required": true,
          "weights": [5, 3, 2]
        },
        {
          "name": "startsAt",
          "kind": "datetime",
          "window": "around"
        },
        {
          "name": "value",
          "kind": "money",
          "min": 5000,
          "max": 250000,
          "trend": "growth"
        }
      ],
      "titleField": "name",
      "searchable": ["name"]
    }
  ],
  "roles": [
    {
      "name": "owner",
      "permissions": {
        "*": ["*"]
      }
    },
    {
      "name": "member",
      "permissions": {
        "*": ["read", "create", "update", "delete", "import", "export"]
      }
    },
    {
      "name": "viewer",
      "permissions": {
        "*": ["read"]
      }
    }
  ],
  "screens": [
    {
      "type": "dashboard",
      "path": "/dashboard",
      "title": "Routeline Logistics overview",
      "nav": {
        "label": "Overview",
        "icon": "layout-dashboard",
        "order": 0
      },
      "widgets": [
        {
          "kind": "kpi",
          "label": "Total carriers",
          "entity": "carrier",
          "aggregate": "count",
          "span": 1
        },
        {
          "kind": "chart",
          "label": "carriers over time",
          "entity": "carrier",
          "aggregate": "sum",
          "field": "score",
          "chart": "line",
          "bucket": {
            "field": "createdAt",
            "unit": "month"
          },
          "span": 3
        }
      ]
    },
    {
      "type": "list",
      "entity": "carrier",
      "columns": ["name", "scac", "score"]
    },
    {
      "type": "form",
      "entity": "carrier"
    },
    {
      "type": "list",
      "entity": "shipment",
      "columns": ["reference", "carrier", "status"]
    },
    {
      "type": "form",
      "entity": "shipment"
    },
    {
      "type": "list",
      "entity": "stop",
      "columns": ["shipment", "kind", "city"]
    },
    {
      "type": "form",
      "entity": "stop"
    },
    {
      "type": "map",
      "entity": "carrier",
      "geoField": "location",
      "path": "/carriers/map",
      "title": "Carriers map",
      "nav": {
        "label": "Map",
        "icon": "map",
        "order": 20
      }
    },
    {
      "type": "detail",
      "entity": "carrier",
      "tabs": ["overview"],
      "path": "/carriers/:id",
      "title": "Carrier details",
      "nav": {
        "label": "Details",
        "icon": "file-text",
        "hidden": true
      }
    },
    {
      "type": "settings",
      "sections": ["profile", "appearance"],
      "path": "/settings",
      "title": "Settings",
      "nav": {
        "label": "Settings",
        "icon": "settings",
        "order": 999
      }
    }
  ]
}

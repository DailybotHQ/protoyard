{
  "$schema": "../packages/blueprint/schema/blueprint.schema.json",
  "formatVersion": 1,
  "name": "Lotline Realty",
  "description": "Listings, showings and offers for a fictional brokerage.",
  "icon": "🏠",
  "category": "real-estate",
  "tags": ["real-estate", "listings", "offers"],
  "catalog": {
    "category": "real-estate",
    "productType": "Realty",
    "platforms": ["web"],
    "features": ["showings", "offers"],
    "highlights": ["MLS-style listings", "Showing calendar", "Offer tracker"],
    "difficulty": "intermediate"
  },
  "brand": {
    "id": "real-estate-brand",
    "name": "Lotline Realty",
    "seed": "#b45309",
    "styleProfile": "flat",
    "font": "system"
  },
  "entities": [
    {
      "name": "listing",
      "plural": "listings",
      "fields": [
        {
          "name": "address",
          "kind": "text",
          "required": true,
          "fake": "location.city"
        },
        {
          "name": "city",
          "kind": "text",
          "fake": "location.city"
        },
        {
          "name": "price",
          "kind": "money",
          "currency": "USD",
          "min": 0,
          "required": true,
          "trend": "growth"
        },
        {
          "name": "status",
          "kind": "enum",
          "values": ["active", "pending", "sold", "withdrawn"],
          "default": "active",
          "required": true,
          "weights": [4, 3, 2, 1]
        },
        {
          "name": "agent",
          "kind": "persona"
        },
        {
          "name": "location",
          "kind": "geo",
          "region": "harbor-bay"
        }
      ],
      "titleField": "address",
      "ownerField": "agent",
      "searchable": ["address", "city"]
    },
    {
      "name": "showing",
      "plural": "showings",
      "fields": [
        {
          "name": "listing",
          "kind": "relation",
          "to": "listing",
          "required": true,
          "onDelete": "cascade"
        },
        {
          "name": "startsAt",
          "kind": "datetime",
          "required": true,
          "window": "around"
        },
        {
          "name": "clientName",
          "kind": "text",
          "required": true,
          "fake": "person.fullName"
        }
      ],
      "titleField": "clientName"
    },
    {
      "name": "offer",
      "plural": "offers",
      "fields": [
        {
          "name": "listing",
          "kind": "relation",
          "to": "listing",
          "required": true,
          "onDelete": "cascade"
        },
        {
          "name": "amount",
          "kind": "money",
          "currency": "USD",
          "min": 0,
          "required": true,
          "trend": "growth"
        },
        {
          "name": "status",
          "kind": "enum",
          "values": ["submitted", "countered", "accepted", "rejected"],
          "default": "submitted",
          "required": true,
          "weights": [4, 3, 2, 1]
        },
        {
          "name": "buyerName",
          "kind": "text",
          "required": true,
          "fake": "person.fullName"
        }
      ],
      "titleField": "buyerName"
    },
    {
      "name": "neighborhood",
      "plural": "neighborhoods",
      "fields": [
        {
          "name": "name",
          "kind": "text",
          "required": true
        },
        {
          "name": "listing",
          "kind": "relation",
          "to": "listing",
          "required": true,
          "onDelete": "cascade"
        },
        {
          "name": "status",
          "kind": "enum",
          "values": ["planned", "active", "complete"],
          "default": "planned",
          "required": true,
          "weights": [5, 3, 2]
        },
        {
          "name": "startsAt",
          "kind": "datetime",
          "window": "around"
        },
        {
          "name": "value",
          "kind": "money",
          "min": 5000,
          "max": 250000,
          "trend": "growth"
        }
      ],
      "titleField": "name",
      "searchable": ["name"]
    }
  ],
  "roles": [
    {
      "name": "owner",
      "permissions": {
        "*": ["*"]
      }
    },
    {
      "name": "member",
      "permissions": {
        "*": ["read", "create", "update", "delete", "import", "export"]
      }
    },
    {
      "name": "viewer",
      "permissions": {
        "*": ["read"]
      }
    }
  ],
  "screens": [
    {
      "type": "dashboard",
      "path": "/dashboard",
      "title": "Lotline Realty overview",
      "nav": {
        "label": "Overview",
        "icon": "layout-dashboard",
        "order": 0
      },
      "widgets": [
        {
          "kind": "kpi",
          "label": "Total listings",
          "entity": "listing",
          "aggregate": "count",
          "span": 1
        },
        {
          "kind": "chart",
          "label": "listings over time",
          "entity": "listing",
          "aggregate": "sum",
          "field": "price",
          "chart": "line",
          "bucket": {
            "field": "createdAt",
            "unit": "month"
          },
          "span": 3
        },
        {
          "kind": "board-summary",
          "label": "listings by status",
          "entity": "listing",
          "groupBy": "status",
          "span": 2
        }
      ]
    },
    {
      "type": "list",
      "entity": "listing",
      "columns": ["address", "city", "price"]
    },
    {
      "type": "form",
      "entity": "listing"
    },
    {
      "type": "list",
      "entity": "showing",
      "columns": ["listing", "startsAt", "clientName"]
    },
    {
      "type": "form",
      "entity": "showing"
    },
    {
      "type": "list",
      "entity": "offer",
      "columns": ["listing", "amount", "status"]
    },
    {
      "type": "form",
      "entity": "offer"
    },
    {
      "type": "map",
      "entity": "listing",
      "geoField": "location",
      "colorBy": "status",
      "path": "/listings/map",
      "title": "Listings map",
      "nav": {
        "label": "Map",
        "icon": "map",
        "order": 20
      }
    },
    {
      "type": "detail",
      "entity": "listing",
      "tabs": ["overview"],
      "path": "/listings/:id",
      "title": "Listing details",
      "nav": {
        "label": "Details",
        "icon": "file-text",
        "hidden": true
      }
    },
    {
      "type": "settings",
      "sections": ["profile", "appearance"],
      "path": "/settings",
      "title": "Settings",
      "nav": {
        "label": "Settings",
        "icon": "settings",
        "order": 999
      }
    }
  ]
}

{
  "$schema": "../packages/blueprint/schema/blueprint.schema.json",
  "formatVersion": 1,
  "name": "Campus LMS",
  "description": "Courses, enrollments and lessons for a fictional learning platform.",
  "icon": "🎓",
  "category": "education",
  "tags": ["education", "courses", "learning"],
  "catalog": {
    "category": "education",
    "productType": "LMS",
    "platforms": ["web"],
    "features": ["enrollments", "progress"],
    "highlights": ["Course catalog", "Lesson outlines", "Enrollment status"],
    "difficulty": "intermediate"
  },
  "brand": {
    "id": "lms-brand",
    "name": "Campus LMS",
    "seed": "#1d4ed8",
    "secondary": "#0f766e",
    "styleProfile": "rounded",
    "font": "humanist"
  },
  "entities": [
    {
      "name": "course",
      "plural": "courses",
      "fields": [
        {
          "name": "title",
          "kind": "text",
          "required": true
        },
        {
          "name": "summary",
          "kind": "longText"
        },
        {
          "name": "level",
          "kind": "enum",
          "values": ["intro", "intermediate", "advanced"],
          "default": "intro",
          "required": true,
          "weights": [3, 2, 1]
        },
        {
          "name": "instructor",
          "kind": "persona"
        }
      ],
      "titleField": "title",
      "searchable": ["title"]
    },
    {
      "name": "lesson",
      "plural": "lessons",
      "fields": [
        {
          "name": "title",
          "kind": "text",
          "required": true
        },
        {
          "name": "course",
          "kind": "relation",
          "to": "course",
          "required": true,
          "onDelete": "cascade"
        },
        {
          "name": "order",
          "kind": "integer",
          "min": 1,
          "required": true,
          "trend": "seasonal"
        },
        {
          "name": "durationMin",
          "kind": "integer",
          "min": 1,
          "trend": "seasonal"
        }
      ],
      "titleField": "title"
    },
    {
      "name": "enrollment",
      "plural": "enrollments",
      "fields": [
        {
          "name": "course",
          "kind": "relation",
          "to": "course",
          "required": true,
          "onDelete": "cascade"
        },
        {
          "name": "student",
          "kind": "persona",
          "required": true
        },
        {
          "name": "status",
          "kind": "enum",
          "values": ["active", "completed", "dropped"],
          "default": "active",
          "required": true,
          "weights": [3, 2, 1]
        },
        {
          "name": "progress",
          "kind": "number",
          "min": 0,
          "max": 1,
          "default": 0,
          "trend": "seasonal"
        }
      ],
      "titleField": "status"
    },
    {
      "name": "instructor",
      "plural": "instructors",
      "fields": [
        {
          "name": "name",
          "kind": "text",
          "required": true
        },
        {
          "name": "course",
          "kind": "relation",
          "to": "course",
          "required": true,
          "onDelete": "cascade"
        },
        {
          "name": "status",
          "kind": "enum",
          "values": ["planned", "active", "complete"],
          "default": "planned",
          "required": true,
          "weights": [5, 3, 2]
        },
        {
          "name": "startsAt",
          "kind": "datetime",
          "window": "around"
        },
        {
          "name": "value",
          "kind": "money",
          "min": 5000,
          "max": 250000,
          "trend": "growth"
        }
      ],
      "titleField": "name",
      "searchable": ["name"]
    }
  ],
  "roles": [
    {
      "name": "owner",
      "permissions": {
        "*": ["*"]
      }
    },
    {
      "name": "member",
      "permissions": {
        "*": ["read", "create", "update", "delete", "import", "export"]
      }
    },
    {
      "name": "viewer",
      "permissions": {
        "*": ["read"]
      }
    }
  ],
  "screens": [
    {
      "type": "dashboard",
      "path": "/dashboard",
      "title": "Campus LMS overview",
      "nav": {
        "label": "Overview",
        "icon": "layout-dashboard",
        "order": 0
      },
      "widgets": [
        {
          "kind": "kpi",
          "label": "Total courses",
          "entity": "course",
          "aggregate": "count",
          "span": 1
        },
        {
          "kind": "chart",
          "label": "courses over time",
          "entity": "course",
          "aggregate": "count",
          "chart": "line",
          "bucket": {
            "field": "createdAt",
            "unit": "month"
          },
          "span": 3
        },
        {
          "kind": "board-summary",
          "label": "courses by status",
          "entity": "course",
          "groupBy": "level",
          "span": 2
        }
      ]
    },
    {
      "type": "list",
      "entity": "course",
      "columns": ["title", "summary", "level"]
    },
    {
      "type": "form",
      "entity": "course"
    },
    {
      "type": "list",
      "entity": "lesson",
      "columns": ["title", "course", "order"]
    },
    {
      "type": "form",
      "entity": "lesson"
    },
    {
      "type": "list",
      "entity": "enrollment",
      "columns": ["course", "student", "status"]
    },
    {
      "type": "form",
      "entity": "enrollment"
    },
    {
      "type": "board",
      "entity": "course",
      "groupBy": "level",
      "cardFields": ["title"],
      "path": "/courses/board",
      "title": "Courses board",
      "nav": {
        "label": "Board",
        "icon": "kanban",
        "order": 20
      }
    },
    {
      "type": "detail",
      "entity": "course",
      "tabs": ["overview"],
      "path": "/courses/:id",
      "title": "Course details",
      "nav": {
        "label": "Details",
        "icon": "file-text",
        "hidden": true
      }
    },
    {
      "type": "settings",
      "sections": ["profile", "appearance"],
      "path": "/settings",
      "title": "Settings",
      "nav": {
        "label": "Settings",
        "icon": "settings",
        "order": 999
      }
    }
  ]
}

{
  "$schema": "../packages/blueprint/schema/blueprint.schema.json",
  "formatVersion": 1,
  "name": "Stockroom Inventory",
  "description": "SKUs, warehouses and stock moves for a fictional warehouse.",
  "icon": "📦",
  "category": "operations",
  "tags": ["inventory", "warehouse", "sku"],
  "catalog": {
    "category": "operations",
    "productType": "Inventory",
    "platforms": ["web"],
    "features": ["stock-levels", "transfers"],
    "highlights": ["Multi-warehouse", "Stock moves", "Reorder points"],
    "difficulty": "intermediate"
  },
  "brand": {
    "id": "inventory-brand",
    "name": "Stockroom Inventory",
    "seed": "#0f766e",
    "styleProfile": "flat",
    "font": "system"
  },
  "entities": [
    {
      "name": "sku",
      "plural": "skus",
      "label": "SKUs",
      "fields": [
        {
          "name": "code",
          "kind": "text",
          "required": true
        },
        {
          "name": "name",
          "kind": "text",
          "required": true,
          "fake": "commerce.productName"
        },
        {
          "name": "unitCost",
          "kind": "money",
          "currency": "USD",
          "min": 0,
          "trend": "seasonal"
        },
        {
          "name": "reorderAt",
          "kind": "integer",
          "min": 0,
          "default": 10,
          "trend": "seasonal"
        },
        {
          "name": "startsAt",
          "kind": "datetime",
          "window": "past"
        },
        {
          "name": "endsAt",
          "kind": "datetime",
          "window": "around"
        }
      ],
      "titleField": "name",
      "searchable": ["code", "name"],
      "features": {
        "csv": true
      }
    },
    {
      "name": "warehouse",
      "plural": "warehouses",
      "fields": [
        {
          "name": "name",
          "kind": "text",
          "required": true
        },
        {
          "name": "city",
          "kind": "text",
          "fake": "location.city"
        }
      ],
      "titleField": "name"
    },
    {
      "name": "stock-move",
      "plural": "stock-moves",
      "fields": [
        {
          "name": "sku",
          "kind": "relation",
          "to": "sku",
          "required": true,
          "onDelete": "restrict"
        },
        {
          "name": "warehouse",
          "kind": "relation",
          "to": "warehouse",
          "required": true,
          "onDelete": "restrict"
        },
        {
          "name": "kind",
          "kind": "enum",
          "values": ["receive", "ship", "adjust"],
          "default": "receive",
          "required": true,
          "weights": [3, 2, 1]
        },
        {
          "name": "quantity",
          "kind": "integer",
          "min": 1,
          "required": true,
          "trend": "seasonal"
        },
        {
          "name": "movedAt",
          "kind": "datetime",
          "window": "around"
        }
      ],
      "titleField": "kind"
    },
    {
      "name": "supplier",
      "plural": "suppliers",
      "fields": [
        {
          "name": "name",
          "kind": "text",
          "required": true
        },
        {
          "name": "sku",
          "kind": "relation",
          "to": "sku",
          "required": true,
          "onDelete": "cascade"
        },
        {
          "name": "status",
          "kind": "enum",
          "values": ["planned", "active", "complete"],
          "default": "planned",
          "required": true,
          "weights": [5, 3, 2]
        },
        {
          "name": "startsAt",
          "kind": "datetime",
          "window": "around"
        },
        {
          "name": "value",
          "kind": "money",
          "min": 5000,
          "max": 250000,
          "trend": "growth"
        }
      ],
      "titleField": "name",
      "searchable": ["name"]
    }
  ],
  "roles": [
    {
      "name": "owner",
      "permissions": {
        "*": ["*"]
      }
    },
    {
      "name": "member",
      "permissions": {
        "*": ["read", "create", "update", "delete", "import", "export"]
      }
    },
    {
      "name": "viewer",
      "permissions": {
        "*": ["read"]
      }
    }
  ],
  "screens": [
    {
      "type": "dashboard",
      "path": "/dashboard",
      "title": "Stockroom Inventory overview",
      "nav": {
        "label": "Overview",
        "icon": "layout-dashboard",
        "order": 0
      },
      "widgets": [
        {
          "kind": "kpi",
          "label": "Total skus",
          "entity": "sku",
          "aggregate": "count",
          "span": 1
        },
        {
          "kind": "chart",
          "label": "skus over time",
          "entity": "sku",
          "aggregate": "sum",
          "field": "unitCost",
          "chart": "line",
          "bucket": {
            "field": "createdAt",
            "unit": "month"
          },
          "span": 3
        }
      ]
    },
    {
      "type": "list",
      "entity": "sku",
      "columns": ["code", "name", "unitCost"]
    },
    {
      "type": "form",
      "entity": "sku"
    },
    {
      "type": "list",
      "entity": "warehouse",
      "columns": ["name", "city"]
    },
    {
      "type": "form",
      "entity": "warehouse"
    },
    {
      "type": "list",
      "entity": "stock-move",
      "columns": ["sku", "warehouse", "kind"]
    },
    {
      "type": "form",
      "entity": "stock-move"
    },
    {
      "type": "timeline",
      "entity": "sku",
      "startField": "startsAt",
      "endField": "endsAt",
      "zoom": "month",
      "path": "/skus/timeline",
      "title": "Skus timeline",
      "nav": {
        "label": "Timeline",
        "icon": "clock",
        "order": 20
      }
    },
    {
      "type": "detail",
      "entity": "sku",
      "tabs": ["overview"],
      "path": "/skus/:id",
      "title": "Sku details",
      "nav": {
        "label": "Details",
        "icon": "file-text",
        "hidden": true
      }
    },
    {
      "type": "settings",
      "sections": ["profile", "appearance"],
      "path": "/settings",
      "title": "Settings",
      "nav": {
        "label": "Settings",
        "icon": "settings",
        "order": 999
      }
    }
  ]
}

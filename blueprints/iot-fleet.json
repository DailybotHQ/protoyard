{
  "$schema": "../packages/blueprint/schema/blueprint.schema.json",
  "formatVersion": 1,
  "name": "Fleetpulse IoT",
  "description": "Devices, telemetry and alerts for a fictional IoT fleet.",
  "icon": "📡",
  "category": "operations",
  "tags": ["iot", "fleet", "devices"],
  "catalog": {
    "category": "operations",
    "productType": "IoT",
    "platforms": ["web"],
    "features": ["telemetry", "alerts"],
    "highlights": ["Device registry", "Last-seen", "Alert rules"],
    "difficulty": "intermediate"
  },
  "brand": {
    "id": "iot-fleet-brand",
    "name": "Fleetpulse IoT",
    "seed": "#4338ca",
    "styleProfile": "mono",
    "font": "mono"
  },
  "entities": [
    {
      "name": "device",
      "plural": "devices",
      "fields": [
        {
          "name": "serial",
          "kind": "text",
          "required": true
        },
        {
          "name": "name",
          "kind": "text",
          "required": true
        },
        {
          "name": "status",
          "kind": "enum",
          "values": ["online", "offline", "maintenance"],
          "default": "online",
          "required": true,
          "weights": [3, 2, 1]
        },
        {
          "name": "lastSeenAt",
          "kind": "datetime",
          "window": "around"
        },
        {
          "name": "location",
          "kind": "geo",
          "region": "harbor-bay"
        }
      ],
      "titleField": "name",
      "searchable": ["serial", "name"],
      "indexes": ["status"]
    },
    {
      "name": "telemetry",
      "plural": "telemetry",
      "fields": [
        {
          "name": "device",
          "kind": "relation",
          "to": "device",
          "required": true,
          "onDelete": "cascade"
        },
        {
          "name": "metric",
          "kind": "text",
          "required": true
        },
        {
          "name": "value",
          "kind": "number",
          "required": true,
          "trend": "seasonal"
        },
        {
          "name": "recordedAt",
          "kind": "datetime",
          "required": true,
          "window": "around"
        }
      ],
      "titleField": "metric"
    },
    {
      "name": "alert",
      "plural": "alerts",
      "fields": [
        {
          "name": "device",
          "kind": "relation",
          "to": "device",
          "required": true,
          "onDelete": "cascade"
        },
        {
          "name": "message",
          "kind": "text",
          "required": true
        },
        {
          "name": "severity",
          "kind": "enum",
          "values": ["info", "warn", "critical"],
          "default": "info",
          "required": true,
          "weights": [3, 2, 1]
        },
        {
          "name": "status",
          "kind": "enum",
          "values": ["open", "acked", "resolved"],
          "default": "open",
          "required": true,
          "weights": [3, 2, 1]
        }
      ],
      "titleField": "message",
      "features": {
        "notifications": true
      }
    },
    {
      "name": "site",
      "plural": "sites",
      "fields": [
        {
          "name": "name",
          "kind": "text",
          "required": true
        },
        {
          "name": "device",
          "kind": "relation",
          "to": "device",
          "required": true,
          "onDelete": "cascade"
        },
        {
          "name": "status",
          "kind": "enum",
          "values": ["planned", "active", "complete"],
          "default": "planned",
          "required": true,
          "weights": [5, 3, 2]
        },
        {
          "name": "startsAt",
          "kind": "datetime",
          "window": "around"
        },
        {
          "name": "value",
          "kind": "money",
          "min": 5000,
          "max": 250000,
          "trend": "growth"
        }
      ],
      "titleField": "name",
      "searchable": ["name"]
    }
  ],
  "roles": [
    {
      "name": "owner",
      "permissions": {
        "*": ["*"]
      }
    },
    {
      "name": "member",
      "permissions": {
        "*": ["read", "create", "update", "delete", "import", "export"]
      }
    },
    {
      "name": "viewer",
      "permissions": {
        "*": ["read"]
      }
    }
  ],
  "screens": [
    {
      "type": "dashboard",
      "path": "/dashboard",
      "title": "Fleetpulse IoT overview",
      "nav": {
        "label": "Overview",
        "icon": "layout-dashboard",
        "order": 0
      },
      "widgets": [
        {
          "kind": "kpi",
          "label": "Total devices",
          "entity": "device",
          "aggregate": "count",
          "span": 1
        },
        {
          "kind": "chart",
          "label": "devices over time",
          "entity": "device",
          "aggregate": "count",
          "chart": "line",
          "bucket": {
            "field": "createdAt",
            "unit": "month"
          },
          "span": 3
        },
        {
          "kind": "board-summary",
          "label": "devices by status",
          "entity": "device",
          "groupBy": "status",
          "span": 2
        }
      ]
    },
    {
      "type": "list",
      "entity": "device",
      "columns": ["serial", "name", "status"]
    },
    {
      "type": "form",
      "entity": "device"
    },
    {
      "type": "list",
      "entity": "telemetry",
      "columns": ["device", "metric", "value"]
    },
    {
      "type": "form",
      "entity": "telemetry"
    },
    {
      "type": "list",
      "entity": "alert",
      "columns": ["device", "message", "severity"]
    },
    {
      "type": "form",
      "entity": "alert"
    },
    {
      "type": "map",
      "entity": "device",
      "geoField": "location",
      "colorBy": "status",
      "path": "/devices/map",
      "title": "Devices map",
      "nav": {
        "label": "Map",
        "icon": "map",
        "order": 20
      }
    },
    {
      "type": "detail",
      "entity": "device",
      "tabs": ["overview"],
      "path": "/devices/:id",
      "title": "Device details",
      "nav": {
        "label": "Details",
        "icon": "file-text",
        "hidden": true
      }
    },
    {
      "type": "settings",
      "sections": ["profile", "appearance"],
      "path": "/settings",
      "title": "Settings",
      "nav": {
        "label": "Settings",
        "icon": "settings",
        "order": 999
      }
    }
  ]
}

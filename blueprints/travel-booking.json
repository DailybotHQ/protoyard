{
  "$schema": "../packages/blueprint/schema/blueprint.schema.json",
  "formatVersion": 1,
  "name": "Waypoint Travel",
  "description": "Trips, segments and travelers for a fictional travel desk.",
  "icon": "✈️",
  "category": "travel",
  "tags": ["travel", "trips", "booking"],
  "catalog": {
    "category": "travel",
    "productType": "Travel",
    "platforms": ["web"],
    "features": ["itineraries", "travelers"],
    "highlights": ["Multi-segment trips", "Traveler list", "PNR codes"],
    "difficulty": "intermediate"
  },
  "brand": {
    "id": "travel-booking-brand",
    "name": "Waypoint Travel",
    "seed": "#0284c7",
    "styleProfile": "soft",
    "font": "humanist"
  },
  "entities": [
    {
      "name": "trip",
      "plural": "trips",
      "fields": [
        {
          "name": "name",
          "kind": "text",
          "required": true
        },
        {
          "name": "pnr",
          "kind": "text",
          "required": true
        },
        {
          "name": "status",
          "kind": "enum",
          "values": ["planned", "booked", "completed", "cancelled"],
          "default": "planned",
          "required": true,
          "weights": [4, 3, 2, 1]
        },
        {
          "name": "agent",
          "kind": "persona"
        },
        {
          "name": "scheduledAt",
          "kind": "datetime",
          "window": "future"
        }
      ],
      "titleField": "name",
      "ownerField": "agent",
      "searchable": ["name", "pnr"]
    },
    {
      "name": "segment",
      "plural": "segments",
      "fields": [
        {
          "name": "trip",
          "kind": "relation",
          "to": "trip",
          "required": true,
          "onDelete": "cascade"
        },
        {
          "name": "kind",
          "kind": "enum",
          "values": ["flight", "hotel", "rail", "car"],
          "default": "flight",
          "required": true,
          "weights": [4, 3, 2, 1]
        },
        {
          "name": "origin",
          "kind": "text",
          "required": true,
          "fake": "location.city"
        },
        {
          "name": "destination",
          "kind": "text",
          "required": true,
          "fake": "location.city"
        },
        {
          "name": "departsAt",
          "kind": "datetime",
          "window": "around"
        }
      ],
      "titleField": "kind"
    },
    {
      "name": "traveler",
      "plural": "travelers",
      "fields": [
        {
          "name": "trip",
          "kind": "relation",
          "to": "trip",
          "required": true,
          "onDelete": "cascade"
        },
        {
          "name": "fullName",
          "kind": "text",
          "required": true,
          "fake": "person.fullName"
        },
        {
          "name": "email",
          "kind": "email",
          "fake": "internet.email"
        }
      ],
      "titleField": "fullName"
    },
    {
      "name": "destination",
      "plural": "destinations",
      "fields": [
        {
          "name": "name",
          "kind": "text",
          "required": true
        },
        {
          "name": "trip",
          "kind": "relation",
          "to": "trip",
          "required": true,
          "onDelete": "cascade"
        },
        {
          "name": "status",
          "kind": "enum",
          "values": ["planned", "active", "complete"],
          "default": "planned",
          "required": true,
          "weights": [5, 3, 2]
        },
        {
          "name": "startsAt",
          "kind": "datetime",
          "window": "around"
        },
        {
          "name": "value",
          "kind": "money",
          "min": 5000,
          "max": 250000,
          "trend": "seasonal"
        }
      ],
      "titleField": "name",
      "searchable": ["name"]
    }
  ],
  "roles": [
    {
      "name": "owner",
      "permissions": {
        "*": ["*"]
      }
    },
    {
      "name": "member",
      "permissions": {
        "*": ["read", "create", "update", "delete", "import", "export"]
      }
    },
    {
      "name": "viewer",
      "permissions": {
        "*": ["read"]
      }
    }
  ],
  "screens": [
    {
      "type": "dashboard",
      "path": "/dashboard",
      "title": "Waypoint Travel overview",
      "nav": {
        "label": "Overview",
        "icon": "layout-dashboard",
        "order": 0
      },
      "widgets": [
        {
          "kind": "kpi",
          "label": "Total trips",
          "entity": "trip",
          "aggregate": "count",
          "span": 1
        },
        {
          "kind": "chart",
          "label": "trips over time",
          "entity": "trip",
          "aggregate": "count",
          "chart": "line",
          "bucket": {
            "field": "createdAt",
            "unit": "month"
          },
          "span": 3
        },
        {
          "kind": "board-summary",
          "label": "trips by status",
          "entity": "trip",
          "groupBy": "status",
          "span": 2
        }
      ]
    },
    {
      "type": "list",
      "entity": "trip",
      "columns": ["name", "pnr", "status"]
    },
    {
      "type": "form",
      "entity": "trip"
    },
    {
      "type": "list",
      "entity": "segment",
      "columns": ["trip", "kind", "origin"]
    },
    {
      "type": "form",
      "entity": "segment"
    },
    {
      "type": "list",
      "entity": "traveler",
      "columns": ["trip", "fullName", "email"]
    },
    {
      "type": "form",
      "entity": "traveler"
    },
    {
      "type": "calendar",
      "entity": "trip",
      "dateField": "scheduledAt",
      "view": "month",
      "path": "/trips/calendar",
      "title": "Trips calendar",
      "nav": {
        "label": "Calendar",
        "icon": "calendar",
        "order": 20
      }
    },
    {
      "type": "detail",
      "entity": "trip",
      "tabs": ["overview"],
      "path": "/trips/:id",
      "title": "Trip details",
      "nav": {
        "label": "Details",
        "icon": "file-text",
        "hidden": true
      }
    },
    {
      "type": "settings",
      "sections": ["profile", "appearance"],
      "path": "/settings",
      "title": "Settings",
      "nav": {
        "label": "Settings",
        "icon": "settings",
        "order": 999
      }
    }
  ]
}

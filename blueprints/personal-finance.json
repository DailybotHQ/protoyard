{
  "$schema": "../packages/blueprint/schema/blueprint.schema.json",
  "formatVersion": 1,
  "name": "Ledgerly Finance",
  "description": "Accounts, transactions and budgets for fictional household money.",
  "icon": "💸",
  "category": "finance",
  "tags": ["finance", "budget", "ledger"],
  "catalog": {
    "category": "finance",
    "productType": "Finance",
    "platforms": ["web"],
    "features": ["budgets", "categories"],
    "highlights": ["Cash accounts", "Txn categories", "Monthly budgets"],
    "difficulty": "intermediate"
  },
  "brand": {
    "id": "personal-finance-brand",
    "name": "Ledgerly Finance",
    "seed": "#15803d",
    "styleProfile": "crisp",
    "font": "grotesk"
  },
  "entities": [
    {
      "name": "account",
      "plural": "accounts",
      "fields": [
        {
          "name": "name",
          "kind": "text",
          "required": true
        },
        {
          "name": "kind",
          "kind": "enum",
          "values": ["checking", "savings", "credit", "cash"],
          "default": "checking",
          "required": true,
          "weights": [4, 3, 2, 1]
        },
        {
          "name": "currency",
          "kind": "text",
          "default": "USD"
        },
        {
          "name": "value",
          "kind": "number",
          "min": 0,
          "max": 100,
          "trend": "growth"
        }
      ],
      "titleField": "name"
    },
    {
      "name": "transaction",
      "plural": "transactions",
      "fields": [
        {
          "name": "account",
          "kind": "relation",
          "to": "account",
          "required": true,
          "onDelete": "cascade"
        },
        {
          "name": "payee",
          "kind": "text",
          "required": true,
          "fake": "company.name"
        },
        {
          "name": "amount",
          "kind": "money",
          "currency": "USD",
          "required": true,
          "trend": "decline"
        },
        {
          "name": "category",
          "kind": "enum",
          "values": ["income", "housing", "food", "transport", "fun", "other"],
          "default": "income",
          "required": true,
          "weights": [6, 5, 4, 3, 2, 1]
        },
        {
          "name": "bookedOn",
          "kind": "date",
          "required": true,
          "window": "past"
        }
      ],
      "titleField": "payee",
      "indexes": ["category"],
      "features": {
        "csv": true
      }
    },
    {
      "name": "budget",
      "plural": "budgets",
      "fields": [
        {
          "name": "category",
          "kind": "enum",
          "values": ["housing", "food", "transport", "fun", "other"],
          "default": "housing",
          "required": true,
          "weights": [5, 4, 3, 2, 1]
        },
        {
          "name": "limit",
          "kind": "money",
          "currency": "USD",
          "min": 0,
          "required": true,
          "trend": "decline"
        },
        {
          "name": "month",
          "kind": "text",
          "required": true
        }
      ],
      "titleField": "category"
    },
    {
      "name": "goal",
      "plural": "goals",
      "fields": [
        {
          "name": "name",
          "kind": "text",
          "required": true
        },
        {
          "name": "account",
          "kind": "relation",
          "to": "account",
          "required": true,
          "onDelete": "cascade"
        },
        {
          "name": "status",
          "kind": "enum",
          "values": ["planned", "active", "complete"],
          "default": "planned",
          "required": true,
          "weights": [5, 3, 2]
        },
        {
          "name": "startsAt",
          "kind": "datetime",
          "window": "around"
        },
        {
          "name": "value",
          "kind": "money",
          "min": 5000,
          "max": 250000,
          "trend": "seasonal"
        }
      ],
      "titleField": "name",
      "searchable": ["name"]
    }
  ],
  "roles": [
    {
      "name": "owner",
      "permissions": {
        "*": ["*"]
      }
    },
    {
      "name": "member",
      "permissions": {
        "*": ["read", "create", "update", "delete", "import", "export"]
      }
    },
    {
      "name": "viewer",
      "permissions": {
        "*": ["read"]
      }
    }
  ],
  "screens": [
    {
      "type": "dashboard",
      "path": "/dashboard",
      "title": "Ledgerly Finance overview",
      "nav": {
        "label": "Overview",
        "icon": "layout-dashboard",
        "order": 0
      },
      "widgets": [
        {
          "kind": "kpi",
          "label": "Total accounts",
          "entity": "account",
          "aggregate": "count",
          "span": 1
        },
        {
          "kind": "chart",
          "label": "accounts over time",
          "entity": "account",
          "aggregate": "sum",
          "field": "value",
          "chart": "line",
          "bucket": {
            "field": "createdAt",
            "unit": "month"
          },
          "span": 3
        },
        {
          "kind": "board-summary",
          "label": "accounts by status",
          "entity": "account",
          "groupBy": "kind",
          "span": 2
        }
      ]
    },
    {
      "type": "list",
      "entity": "account",
      "columns": ["name", "kind", "currency"]
    },
    {
      "type": "form",
      "entity": "account"
    },
    {
      "type": "list",
      "entity": "transaction",
      "columns": ["account", "payee", "amount"]
    },
    {
      "type": "form",
      "entity": "transaction"
    },
    {
      "type": "list",
      "entity": "budget",
      "columns": ["category", "limit", "month"]
    },
    {
      "type": "form",
      "entity": "budget"
    },
    {
      "type": "analytics",
      "entity": "account",
      "dateField": "createdAt",
      "measures": [
        {
          "label": "Total value",
          "aggregate": "sum",
          "field": "value"
        }
      ],
      "dimensions": ["kind"],
      "path": "/accounts/analytics",
      "title": "Accounts analytics",
      "nav": {
        "label": "Analytics",
        "icon": "chart-line",
        "order": 20
      }
    },
    {
      "type": "detail",
      "entity": "account",
      "tabs": ["overview"],
      "path": "/accounts/:id",
      "title": "Account details",
      "nav": {
        "label": "Details",
        "icon": "file-text",
        "hidden": true
      }
    },
    {
      "type": "settings",
      "sections": ["profile", "appearance"],
      "path": "/settings",
      "title": "Settings",
      "nav": {
        "label": "Settings",
        "icon": "settings",
        "order": 999
      }
    }
  ]
}

{
  "$schema": "../packages/blueprint/schema/blueprint.schema.json",
  "formatVersion": 1,
  "name": "Northstar CRM",
  "description": "Accounts, contacts and deals for a fictional B2B sales team.",
  "icon": "📇",
  "category": "sales",
  "tags": ["crm", "sales", "pipeline"],
  "catalog": {
    "category": "sales",
    "productType": "CRM",
    "platforms": ["web"],
    "features": ["pipeline", "activities", "csv"],
    "highlights": ["Deal stages", "Account hierarchy", "Activity log"],
    "difficulty": "intermediate"
  },
  "brand": {
    "id": "crm-brand",
    "name": "Northstar CRM",
    "seed": "#1d4ed8",
    "secondary": "#0f766e",
    "styleProfile": "soft",
    "font": "grotesk"
  },
  "entities": [
    {
      "name": "account",
      "plural": "accounts",
      "fields": [
        {
          "name": "name",
          "kind": "text",
          "required": true,
          "fake": "company.name"
        },
        {
          "name": "domain",
          "kind": "url",
          "fake": "internet.url"
        },
        {
          "name": "industry",
          "kind": "text",
          "fake": "commerce.productName"
        },
        {
          "name": "owner",
          "kind": "persona"
        },
        {
          "name": "value",
          "kind": "number",
          "min": 0,
          "max": 100,
          "trend": "growth"
        }
      ],
      "titleField": "name",
      "ownerField": "owner",
      "searchable": ["name"],
      "features": {
        "csv": true
      }
    },
    {
      "name": "contact",
      "plural": "contacts",
      "fields": [
        {
          "name": "fullName",
          "kind": "text",
          "required": true,
          "fake": "person.fullName"
        },
        {
          "name": "email",
          "kind": "email",
          "fake": "internet.email"
        },
        {
          "name": "account",
          "kind": "relation",
          "to": "account",
          "required": true,
          "onDelete": "cascade"
        },
        {
          "name": "title",
          "kind": "text",
          "fake": "person.jobTitle"
        }
      ],
      "titleField": "fullName",
      "searchable": ["fullName", "email"]
    },
    {
      "name": "deal",
      "plural": "deals",
      "fields": [
        {
          "name": "title",
          "kind": "text",
          "required": true
        },
        {
          "name": "stage",
          "kind": "enum",
          "values": ["qualify", "proposal", "negotiation", "won", "lost"],
          "default": "qualify",
          "required": true,
          "weights": [5, 4, 3, 2, 1]
        },
        {
          "name": "amount",
          "kind": "money",
          "currency": "USD",
          "min": 0,
          "required": true,
          "trend": "seasonal"
        },
        {
          "name": "account",
          "kind": "relation",
          "to": "account",
          "required": true,
          "onDelete": "cascade"
        },
        {
          "name": "owner",
          "kind": "persona"
        },
        {
          "name": "closeOn",
          "kind": "date",
          "window": "past"
        }
      ],
      "titleField": "title",
      "ownerField": "owner",
      "indexes": ["stage"],
      "features": {
        "audit": true
      }
    },
    {
      "name": "activity",
      "plural": "activities",
      "fields": [
        {
          "name": "name",
          "kind": "text",
          "required": true
        },
        {
          "name": "contact",
          "kind": "relation",
          "to": "contact",
          "required": true,
          "onDelete": "cascade"
        },
        {
          "name": "status",
          "kind": "enum",
          "values": ["planned", "active", "complete"],
          "default": "planned",
          "required": true,
          "weights": [5, 3, 2]
        },
        {
          "name": "startsAt",
          "kind": "datetime",
          "window": "around"
        },
        {
          "name": "value",
          "kind": "money",
          "min": 5000,
          "max": 250000,
          "trend": "growth"
        }
      ],
      "titleField": "name",
      "searchable": ["name"]
    }
  ],
  "roles": [
    {
      "name": "owner",
      "permissions": {
        "*": ["*"]
      }
    },
    {
      "name": "member",
      "permissions": {
        "*": ["read", "create", "update", "delete", "import", "export"]
      }
    },
    {
      "name": "viewer",
      "permissions": {
        "*": ["read"]
      }
    }
  ],
  "screens": [
    {
      "type": "dashboard",
      "path": "/dashboard",
      "title": "Northstar CRM overview",
      "nav": {
        "label": "Overview",
        "icon": "layout-dashboard",
        "order": 0
      },
      "widgets": [
        {
          "kind": "kpi",
          "label": "Total accounts",
          "entity": "account",
          "aggregate": "count",
          "span": 1
        },
        {
          "kind": "chart",
          "label": "accounts over time",
          "entity": "account",
          "aggregate": "sum",
          "field": "value",
          "chart": "line",
          "bucket": {
            "field": "createdAt",
            "unit": "month"
          },
          "span": 3
        }
      ]
    },
    {
      "type": "list",
      "entity": "account",
      "columns": ["name", "domain", "industry"]
    },
    {
      "type": "form",
      "entity": "account"
    },
    {
      "type": "list",
      "entity": "contact",
      "columns": ["fullName", "email", "account"]
    },
    {
      "type": "form",
      "entity": "contact"
    },
    {
      "type": "list",
      "entity": "deal",
      "columns": ["title", "stage", "amount"]
    },
    {
      "type": "form",
      "entity": "deal"
    },
    {
      "type": "analytics",
      "entity": "account",
      "dateField": "createdAt",
      "measures": [
        {
          "label": "Total value",
          "aggregate": "sum",
          "field": "value"
        }
      ],
      "dimensions": [],
      "path": "/accounts/analytics",
      "title": "Accounts analytics",
      "nav": {
        "label": "Analytics",
        "icon": "chart-line",
        "order": 20
      }
    },
    {
      "type": "detail",
      "entity": "account",
      "tabs": ["overview"],
      "path": "/accounts/:id",
      "title": "Account details",
      "nav": {
        "label": "Details",
        "icon": "file-text",
        "hidden": true
      }
    },
    {
      "type": "settings",
      "sections": ["profile", "appearance"],
      "path": "/settings",
      "title": "Settings",
      "nav": {
        "label": "Settings",
        "icon": "settings",
        "order": 999
      }
    }
  ]
}

{
  "name": "protoyard-workspace",
  "private": true,
  "description": "Protoyard — an open-source playground for building, simulating, testing, and publishing realistic interactive prototypes in the browser.",
  "author": "Dailybot, Inc.",
  "license": "MIT",
  "homepage": "https://github.com/DailybotHQ/protoyard",
  "repository": {
    "type": "git",
    "url": "https://github.com/DailybotHQ/protoyard"
  },
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24.20.0"
  },
  "scripts": {
    "dev": "pnpm protoyard gallery",
    "build": "pnpm protoyard index --quiet && pnpm --filter @protoyard/gallery build",
    "preview": "pnpm --filter @protoyard/gallery preview",
    "protoyard": "tsx packages/cli/src/bin.ts",
    "biome:check": "biome check",
    "biome:fix": "biome check --write",
    "lint": "biome check",
    "format": "biome format --write",
    "typecheck": "pnpm -r --parallel --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "bench:index": "tsx scripts/bench-index.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "thumbnails": "tsx scripts/generate-thumbnails.ts",
    "build:showcase": "pnpm protoyard showcase",
    "preview:showcase": "pnpm protoyard showcase --skip-build --serve",
    "hygiene": "bash scripts/check-public-hygiene.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "2.5.15",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.64.0",
    "@protoyard/core": "workspace:*",
    "@protoyard/runtime": "workspace:*",
    "@protoyard/scenarios": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "fake-indexeddb": "~6.2.0",
    "happy-dom": "^21.0.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.0",
    "tsx": "^4.23.0",
    "typescript": "6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}

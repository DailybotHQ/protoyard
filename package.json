{
  "name": "protoyard-workspace",
  "private": true,
  "description": "Protoyard \u2014 an open-source playground for building, simulating, testing, and publishing realistic interactive prototypes in the browser.",
  "author": "Dailybot, Inc.",
  "license": "MIT",
  "homepage": "https://protoyard.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/DailybotHQ/protoyard"
  },
  "type": "module",
  "version": "1.0.0",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24.20.0"
  },
  "scripts": {
    "dev": "pnpm protoyard gallery",
    "dev:create": "pnpm protoyard gallery --allow-create",
    "build": "pnpm protoyard index --quiet && pnpm --filter @protoyard/gallery build",
    "preview": "pnpm --filter @protoyard/gallery preview",
    "protoyard": "tsx packages/cli/src/bin.ts",
    "biome:check": "biome check",
    "biome:fix": "biome check --write",
    "lint": "biome check",
    "format": "biome format --write",
    "typecheck": "pnpm -r --workspace-concurrency=4 --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:perf": "PROTOYARD_PERF=1 vitest run --no-file-parallelism packages/blocks/tests/code-tokenizer.test.ts",
    "bench:index": "tsx scripts/bench-index.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "visual:sweep": "tsx scripts/visual-sweep.ts",
    "thumbnails": "tsx scripts/generate-thumbnails.ts",
    "covers": "tsx scripts/content-covers.ts",
    "build:showcase": "pnpm protoyard showcase --site https://protoyard.app",
    "preview:showcase": "pnpm protoyard showcase --skip-build --serve",
    "hygiene": "bash scripts/check-public-hygiene.sh",
    "build:packages": "tsx scripts/build-packages.ts",
    "check:packages": "tsx scripts/check-packages.ts",
    "verify:packages": "pnpm build:packages && tsx scripts/verify-packages.ts",
    "changeset": "changeset",
    "version-packages": "tsx scripts/version-packages.ts",
    "check:skill": "tsx scripts/validate-skill-frontmatter.ts && tsx scripts/check-skill-cli.ts && tsx scripts/validate-skill-links.ts && bash scripts/verify-skill-integrity.sh",
    "check:integrations": "tsx scripts/validate-integrations.ts",
    "check:docs": "tsx scripts/check-public-docs.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "^3.0.3",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.64.1",
    "@protoyard/core": "workspace:*",
    "@protoyard/runtime": "workspace:*",
    "@protoyard/scenarios": "workspace:*",
    "@sveltejs/package": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/svelte": "^5.4.2",
    "@texuli/astro": "0.4.0",
    "@texuli/blocks": "0.4.0",
    "@texuli/catalog": "0.4.0",
    "@texuli/charts": "0.4.0",
    "@texuli/chat": "0.4.0",
    "@texuli/core": "0.4.0",
    "@texuli/data": "0.4.0",
    "@texuli/date": "0.4.0",
    "@texuli/deck": "0.4.0",
    "@texuli/drag": "0.4.0",
    "@texuli/media": "0.4.0",
    "@texuli/primitives": "0.4.0",
    "@texuli/slides": "0.4.0",
    "@texuli/tokens": "0.4.0",
    "@texuli/workflows": "0.4.0",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "fake-indexeddb": "~6.2.6",
    "happy-dom": "^21.0.3",
    "publint": "^0.3.25",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "texuli": "0.4.0",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}

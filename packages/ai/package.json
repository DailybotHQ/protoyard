{
  "name": "@protoyard/ai",
  "version": "1.0.0",
  "description": "Deterministic simulated AI conversations and response packs for Protoyard prototypes.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./approvals": "./src/approvals/index.ts",
    "./markdown": "./src/markdown.ts",
    "./packs": "./src/packs.ts",
    "./scenarios": "./src/scenarios.ts",
    "./voice": "./src/voice.ts",
    "./chart": "./src/chart.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@protoyard/core": "workspace:*",
    "zod": "^4.6.7"
  },
  "protoyard": {
    "build": {
      "group": "engine",
      "assets": []
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./approvals": {
        "types": "./dist/approvals/index.d.ts",
        "import": "./dist/approvals/index.js",
        "default": "./dist/approvals/index.js"
      },
      "./markdown": {
        "types": "./dist/markdown.d.ts",
        "import": "./dist/markdown.js",
        "default": "./dist/markdown.js"
      },
      "./packs": {
        "types": "./dist/packs.d.ts",
        "import": "./dist/packs.js",
        "default": "./dist/packs.js"
      },
      "./scenarios": {
        "types": "./dist/scenarios.d.ts",
        "import": "./dist/scenarios.js",
        "default": "./dist/scenarios.js"
      },
      "./voice": {
        "types": "./dist/voice.d.ts",
        "import": "./dist/voice.js",
        "default": "./dist/voice.js"
      },
      "./chart": {
        "types": "./dist/chart.d.ts",
        "import": "./dist/chart.js",
        "default": "./dist/chart.js"
      }
    },
    "types": "./dist/index.d.ts"
  },
  "engines": {
    "node": ">=24.20.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DailybotHQ/protoyard",
    "directory": "packages/ai"
  },
  "homepage": "https://protoyard.app",
  "bugs": {
    "url": "https://github.com/DailybotHQ/protoyard/issues"
  },
  "keywords": [
    "protoyard",
    "ai",
    "simulation",
    "prototype"
  ]
}

{
  "name": "@protoyard/crud",
  "version": "1.0.0",
  "description": "Blueprint-driven EntityList and EntityForm for Protoyard (DataTable, filters, CSV, soft-delete undo).",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.svelte",
    "dist/**/*.css",
    "dist/**/*.svelte"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./registry-meta": "./src/registry-meta.ts",
    "./styles.css": "./src/styles.css",
    "./app": {
      "types": "./src/app/index.ts",
      "svelte": "./src/app/index.ts",
      "default": "./src/app/index.ts"
    },
    "./screens/list": {
      "types": "./src/EntityList.svelte",
      "svelte": "./src/EntityList.svelte",
      "default": "./src/EntityList.svelte"
    },
    "./screens/form": {
      "types": "./src/EntityForm.svelte",
      "svelte": "./src/EntityForm.svelte",
      "default": "./src/EntityForm.svelte"
    },
    "./screens/settings": {
      "types": "./src/screens/settings/index.ts",
      "svelte": "./src/screens/settings/index.ts",
      "default": "./src/screens/settings/index.ts"
    },
    "./screens/calendar": {
      "types": "./src/screens/calendar/index.ts",
      "svelte": "./src/screens/calendar/index.ts",
      "default": "./src/screens/calendar/index.ts"
    },
    "./screens/map": {
      "types": "./src/screens/map/index.ts",
      "svelte": "./src/screens/map/index.ts",
      "default": "./src/screens/map/index.ts"
    },
    "./screens/board": {
      "types": "./src/screens/board/index.ts",
      "svelte": "./src/screens/board/index.ts",
      "default": "./src/screens/board/index.ts"
    },
    "./screens/dashboard": {
      "types": "./src/screens/dashboard/index.ts",
      "svelte": "./src/screens/dashboard/index.ts",
      "default": "./src/screens/dashboard/index.ts"
    },
    "./screens/analytics": {
      "types": "./src/screens/analytics/index.ts",
      "svelte": "./src/screens/analytics/index.ts",
      "default": "./src/screens/analytics/index.ts"
    },
    "./screens/timeline": {
      "types": "./src/screens/timeline/index.ts",
      "svelte": "./src/screens/timeline/index.ts",
      "default": "./src/screens/timeline/index.ts"
    }
  },
  "scripts": {
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --threshold error"
  },
  "dependencies": {
    "@lucide/svelte": "^1.61.0",
    "@protoyard/analytics": "workspace:*",
    "@protoyard/analytics-ui": "workspace:*",
    "@protoyard/blueprint": "workspace:*",
    "@protoyard/charts-ui": "workspace:*",
    "@protoyard/core": "workspace:*",
    "@protoyard/renderer-svelte": "workspace:*",
    "@protoyard/ui": "workspace:*",
    "@protoyard/views": "workspace:*",
    "@protoyard/views-ui": "workspace:*",
    "texuli": "0.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "svelte": "^5.57.2"
  },
  "peerDependencies": {
    "svelte": "^5.57.0"
  },
  "protoyard": {
    "build": {
      "assets": []
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "svelte": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./registry-meta": {
        "types": "./dist/registry-meta.d.ts",
        "svelte": "./dist/registry-meta.js",
        "default": "./dist/registry-meta.js"
      },
      "./styles.css": {
        "types": "./dist/styles.css.d.ts",
        "svelte": "./dist/styles.css",
        "default": "./dist/styles.css"
      },
      "./app": {
        "types": "./dist/app/index.d.ts",
        "svelte": "./dist/app/index.js",
        "default": "./dist/app/index.js"
      },
      "./screens/list": {
        "types": "./dist/EntityList.svelte.d.ts",
        "svelte": "./dist/EntityList.svelte",
        "default": "./dist/EntityList.svelte"
      },
      "./screens/form": {
        "types": "./dist/EntityForm.svelte.d.ts",
        "svelte": "./dist/EntityForm.svelte",
        "default": "./dist/EntityForm.svelte"
      },
      "./screens/settings": {
        "types": "./dist/screens/settings/index.d.ts",
        "svelte": "./dist/screens/settings/index.js",
        "default": "./dist/screens/settings/index.js"
      },
      "./screens/calendar": {
        "types": "./dist/screens/calendar/index.d.ts",
        "svelte": "./dist/screens/calendar/index.js",
        "default": "./dist/screens/calendar/index.js"
      },
      "./screens/map": {
        "types": "./dist/screens/map/index.d.ts",
        "svelte": "./dist/screens/map/index.js",
        "default": "./dist/screens/map/index.js"
      },
      "./screens/board": {
        "types": "./dist/screens/board/index.d.ts",
        "svelte": "./dist/screens/board/index.js",
        "default": "./dist/screens/board/index.js"
      },
      "./screens/dashboard": {
        "types": "./dist/screens/dashboard/index.d.ts",
        "svelte": "./dist/screens/dashboard/index.js",
        "default": "./dist/screens/dashboard/index.js"
      },
      "./screens/analytics": {
        "types": "./dist/screens/analytics/index.d.ts",
        "svelte": "./dist/screens/analytics/index.js",
        "default": "./dist/screens/analytics/index.js"
      },
      "./screens/timeline": {
        "types": "./dist/screens/timeline/index.d.ts",
        "svelte": "./dist/screens/timeline/index.js",
        "default": "./dist/screens/timeline/index.js"
      }
    },
    "files": [
      "dist",
      "README.md",
      "LICENSE"
    ],
    "types": "./dist/index.d.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DailybotHQ/protoyard",
    "directory": "packages/crud"
  },
  "homepage": "https://protoyard.app",
  "bugs": {
    "url": "https://github.com/DailybotHQ/protoyard/issues"
  },
  "engines": {
    "node": ">=24.20.0"
  },
  "keywords": [
    "protoyard",
    "svelte",
    "crud",
    "blueprint"
  ]
}

{
  "name": "@protoyard/crud",
  "version": "1.0.0",
  "description": "Blueprint-driven EntityList and EntityForm for Protoyard (DataTable, filters, CSV, soft-delete undo).",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.svelte"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./registry-meta": "./src/registry-meta.ts",
    "./styles.css": "./src/styles.css",
    "./app": {
      "types": "./src/app/index.ts",
      "svelte": "./src/app/index.ts",
      "default": "./src/app/index.ts"
    },
    "./screens/list": {
      "types": "./src/EntityList.svelte",
      "svelte": "./src/EntityList.svelte",
      "default": "./src/EntityList.svelte"
    },
    "./screens/form": {
      "types": "./src/EntityForm.svelte",
      "svelte": "./src/EntityForm.svelte",
      "default": "./src/EntityForm.svelte"
    },
    "./screens/settings": {
      "types": "./src/screens/settings/index.ts",
      "svelte": "./src/screens/settings/index.ts",
      "default": "./src/screens/settings/index.ts"
    },
    "./screens/calendar": {
      "types": "./src/screens/calendar/index.ts",
      "svelte": "./src/screens/calendar/index.ts",
      "default": "./src/screens/calendar/index.ts"
    },
    "./screens/map": {
      "types": "./src/screens/map/index.ts",
      "svelte": "./src/screens/map/index.ts",
      "default": "./src/screens/map/index.ts"
    },
    "./screens/board": {
      "types": "./src/screens/board/index.ts",
      "svelte": "./src/screens/board/index.ts",
      "default": "./src/screens/board/index.ts"
    },
    "./screens/dashboard": {
      "types": "./src/screens/dashboard/index.ts",
      "svelte": "./src/screens/dashboard/index.ts",
      "default": "./src/screens/dashboard/index.ts"
    },
    "./screens/analytics": {
      "types": "./src/screens/analytics/index.ts",
      "svelte": "./src/screens/analytics/index.ts",
      "default": "./src/screens/analytics/index.ts"
    },
    "./screens/timeline": {
      "types": "./src/screens/timeline/index.ts",
      "svelte": "./src/screens/timeline/index.ts",
      "default": "./src/screens/timeline/index.ts"
    }
  },
  "scripts": {
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --threshold error"
  },
  "dependencies": {
    "@lucide/svelte": "^1.59.0",
    "@protoyard/analytics": "workspace:*",
    "@protoyard/analytics-ui": "workspace:*",
    "@protoyard/blueprint": "workspace:*",
    "@protoyard/charts-ui": "workspace:*",
    "@protoyard/core": "workspace:*",
    "@protoyard/renderer-svelte": "workspace:*",
    "@protoyard/ui": "workspace:*",
    "@protoyard/views": "workspace:*",
    "@protoyard/views-ui": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "svelte": "^5.57.2"
  },
  "peerDependencies": {
    "svelte": "^5.57.0"
  },
  "svelte": "./src/index.ts",
  "protoyard": {
    "build": {
      "assets": []
    }
  }
}

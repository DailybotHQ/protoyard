{
  "name": "@protoyard/crud",
  "version": "0.1.0",
  "description": "Blueprint-driven EntityList and EntityForm for Protoyard (DataTable, filters, CSV, soft-delete undo).",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.svelte"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --threshold error"
  },
  "dependencies": {
    "@lucide/svelte": "^1.50.0",
    "@protoyard/blueprint": "workspace:*",
    "@protoyard/core": "workspace:*",
    "@protoyard/renderer-svelte": "workspace:*",
    "@protoyard/ui": "workspace:*"
  },
  "devDependencies": {
    "svelte": "^5.57.0"
  },
  "peerDependencies": {
    "svelte": "^5.57.0"
  },
  "svelte": "./src/index.ts"
}

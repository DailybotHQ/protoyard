{
  "name": "@protoyard/analytics-ui",
  "version": "1.0.0",
  "description": "Svelte 5 analytics kit for Protoyard prototypes: KPI tiles, date ranges, filters and segments, cohort and funnel views and a dashboard grid, one lazy subpath per view.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "dist/**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./date-range": {
      "types": "./src/date-range/index.ts",
      "svelte": "./src/date-range/index.ts",
      "default": "./src/date-range/index.ts"
    },
    "./filters": {
      "types": "./src/filters/index.ts",
      "svelte": "./src/filters/index.ts",
      "default": "./src/filters/index.ts"
    },
    "./cohort": {
      "types": "./src/cohort/index.ts",
      "svelte": "./src/cohort/index.ts",
      "default": "./src/cohort/index.ts"
    },
    "./funnel": {
      "types": "./src/funnel/index.ts",
      "svelte": "./src/funnel/index.ts",
      "default": "./src/funnel/index.ts"
    },
    "./grid": {
      "types": "./src/grid/index.ts",
      "svelte": "./src/grid/index.ts",
      "default": "./src/grid/index.ts"
    },
    "./drill": {
      "types": "./src/drill/index.ts",
      "svelte": "./src/drill/index.ts",
      "default": "./src/drill/index.ts"
    },
    "./player.css": "./src/player.css",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --threshold error"
  },
  "dependencies": {
    "@lucide/svelte": "^1.61.0",
    "@protoyard/analytics": "workspace:*",
    "@protoyard/charts-ui": "workspace:*",
    "@protoyard/renderer-svelte": "workspace:*",
    "@protoyard/ui": "workspace:*",
    "@texuli/charts": "0.8.0",
    "@texuli/data": "0.8.1",
    "@texuli/date": "0.8.0",
    "texuli": "0.8.0"
  },
  "devDependencies": {
    "svelte": "^5.57.2"
  },
  "peerDependencies": {
    "svelte": "^5.57.0"
  },
  "protoyard": {
    "build": {
      "assets": [
        "src/player.css"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "svelte": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./date-range": {
        "types": "./dist/date-range/index.d.ts",
        "svelte": "./dist/date-range/index.js",
        "default": "./dist/date-range/index.js"
      },
      "./filters": {
        "types": "./dist/filters/index.d.ts",
        "svelte": "./dist/filters/index.js",
        "default": "./dist/filters/index.js"
      },
      "./cohort": {
        "types": "./dist/cohort/index.d.ts",
        "svelte": "./dist/cohort/index.js",
        "default": "./dist/cohort/index.js"
      },
      "./funnel": {
        "types": "./dist/funnel/index.d.ts",
        "svelte": "./dist/funnel/index.js",
        "default": "./dist/funnel/index.js"
      },
      "./grid": {
        "types": "./dist/grid/index.d.ts",
        "svelte": "./dist/grid/index.js",
        "default": "./dist/grid/index.js"
      },
      "./drill": {
        "types": "./dist/drill/index.d.ts",
        "svelte": "./dist/drill/index.js",
        "default": "./dist/drill/index.js"
      },
      "./player.css": {
        "types": "./dist/player.css.d.ts",
        "svelte": "./dist/player.css",
        "default": "./dist/player.css"
      },
      "./styles.css": {
        "types": "./dist/styles.css.d.ts",
        "svelte": "./dist/styles.css",
        "default": "./dist/styles.css"
      }
    },
    "files": [
      "dist",
      "README.md",
      "LICENSE"
    ],
    "types": "./dist/index.d.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DailybotHQ/protoyard",
    "directory": "packages/analytics-ui"
  },
  "homepage": "https://protoyard.app",
  "bugs": {
    "url": "https://github.com/DailybotHQ/protoyard/issues"
  },
  "engines": {
    "node": ">=24.20.0"
  },
  "keywords": [
    "protoyard",
    "svelte",
    "analytics",
    "dashboard"
  ]
}

{
  "name": "@protoyard/charts",
  "version": "1.0.0",
  "description": "Chart math for Protoyard prototypes: thin re-exports of @texuli/charts/math (scales, shapes, layouts, downsampling) plus theme-token chart palettes.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./scales": "./src/scales/index.ts",
    "./shapes": "./src/shapes/index.ts",
    "./downsample": "./src/downsample/index.ts",
    "./layout": "./src/layout/index.ts",
    "./palette": "./src/palette/index.ts",
    "./palette/derive": "./src/palette/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@protoyard/core": "workspace:*",
    "@texuli/charts": "0.5.0",
    "@texuli/tokens": "0.5.0"
  },
  "protoyard": {
    "build": {
      "group": "engine",
      "assets": []
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./scales": {
        "types": "./dist/scales/index.d.ts",
        "import": "./dist/scales/index.js",
        "default": "./dist/scales/index.js"
      },
      "./shapes": {
        "types": "./dist/shapes/index.d.ts",
        "import": "./dist/shapes/index.js",
        "default": "./dist/shapes/index.js"
      },
      "./downsample": {
        "types": "./dist/downsample/index.d.ts",
        "import": "./dist/downsample/index.js",
        "default": "./dist/downsample/index.js"
      },
      "./layout": {
        "types": "./dist/layout/index.d.ts",
        "import": "./dist/layout/index.js",
        "default": "./dist/layout/index.js"
      },
      "./palette": {
        "types": "./dist/palette/index.d.ts",
        "import": "./dist/palette/index.js",
        "default": "./dist/palette/index.js"
      },
      "./palette/derive": {
        "types": "./dist/palette/index.d.ts",
        "import": "./dist/palette/index.js",
        "default": "./dist/palette/index.js"
      }
    },
    "types": "./dist/index.d.ts"
  },
  "engines": {
    "node": ">=24.20.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DailybotHQ/protoyard",
    "directory": "packages/charts"
  },
  "homepage": "https://protoyard.app",
  "bugs": {
    "url": "https://github.com/DailybotHQ/protoyard/issues"
  },
  "keywords": [
    "protoyard",
    "charts",
    "visualization",
    "typescript"
  ]
}

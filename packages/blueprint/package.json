{
  "name": "@protoyard/blueprint",
  "version": "1.0.0",
  "description": "Data-only blueprints for Protoyard: schema validation and the derivations (stores, integrity, migrations, inputs, policy, generators, entity services) that turn a blueprint into a working prototype.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./csv": "./src/csv.ts",
    "./computed": "./src/computed/index.ts",
    "./import/csv-shape": "./src/import/csv-shape.ts",
    "./import/json-shape": "./src/import/json-shape.ts",
    "./import/sqlite-schema": "./src/import/sqlite-schema.ts",
    "./generator": "./src/generator.ts",
    "./search": "./src/search.ts",
    "./workflows": "./src/workflows/index.ts",
    "./kinds": "./src/kinds/index.ts",
    "./kinds/embed": "./src/kinds/embed/index.ts",
    "./schema.json": "./schema/blueprint.schema.json",
    "./kinds/parse": "./src/kinds/parse.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@protoyard/blocks": "workspace:*",
    "@protoyard/core": "workspace:*",
    "@protoyard/decks": "workspace:*",
    "@protoyard/pages": "workspace:*",
    "@protoyard/scenarios": "workspace:*",
    "@protoyard/themes": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@protoyard/database": "workspace:*"
  },
  "protoyard": {
    "build": {
      "group": "engine",
      "assets": [
        "schema/blueprint.schema.json"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./csv": {
        "types": "./dist/csv.d.ts",
        "import": "./dist/csv.js",
        "default": "./dist/csv.js"
      },
      "./computed": {
        "types": "./dist/computed/index.d.ts",
        "import": "./dist/computed/index.js",
        "default": "./dist/computed/index.js"
      },
      "./import/csv-shape": {
        "types": "./dist/import/csv-shape.d.ts",
        "import": "./dist/import/csv-shape.js",
        "default": "./dist/import/csv-shape.js"
      },
      "./import/json-shape": {
        "types": "./dist/import/json-shape.d.ts",
        "import": "./dist/import/json-shape.js",
        "default": "./dist/import/json-shape.js"
      },
      "./import/sqlite-schema": {
        "types": "./dist/import/sqlite-schema.d.ts",
        "import": "./dist/import/sqlite-schema.js",
        "default": "./dist/import/sqlite-schema.js"
      },
      "./generator": {
        "types": "./dist/generator.d.ts",
        "import": "./dist/generator.js",
        "default": "./dist/generator.js"
      },
      "./search": {
        "types": "./dist/search.d.ts",
        "import": "./dist/search.js",
        "default": "./dist/search.js"
      },
      "./workflows": {
        "types": "./dist/workflows/index.d.ts",
        "import": "./dist/workflows/index.js",
        "default": "./dist/workflows/index.js"
      },
      "./kinds": {
        "types": "./dist/kinds/index.d.ts",
        "import": "./dist/kinds/index.js",
        "default": "./dist/kinds/index.js"
      },
      "./kinds/embed": {
        "types": "./dist/kinds/embed/index.d.ts",
        "import": "./dist/kinds/embed/index.js",
        "default": "./dist/kinds/embed/index.js"
      },
      "./kinds/parse": {
        "types": "./dist/kinds/parse.d.ts",
        "import": "./dist/kinds/parse.js",
        "default": "./dist/kinds/parse.js"
      },
      "./schema.json": "./dist/schema/blueprint.schema.json"
    },
    "types": "./dist/index.d.ts"
  },
  "engines": {
    "node": ">=24.20.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DailybotHQ/protoyard",
    "directory": "packages/blueprint"
  },
  "homepage": "https://protoyard.app",
  "bugs": {
    "url": "https://github.com/DailybotHQ/protoyard/issues"
  },
  "keywords": [
    "protoyard",
    "blueprint",
    "prototype",
    "generator"
  ]
}

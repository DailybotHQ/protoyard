{
  "name": "@protoyard/blueprint",
  "version": "1.0.0",
  "description": "Data-only blueprints for Protoyard: schema validation and the derivations (stores, integrity, migrations, inputs, policy, generators, entity services) that turn a blueprint into a working prototype.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./csv": "./src/csv.ts",
    "./computed": "./src/computed/index.ts",
    "./import/csv-shape": "./src/import/csv-shape.ts",
    "./import/json-shape": "./src/import/json-shape.ts",
    "./generator": "./src/generator.ts",
    "./search": "./src/search.ts",
    "./workflows": "./src/workflows/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@protoyard/core": "workspace:*",
    "@protoyard/scenarios": "workspace:*",
    "@protoyard/themes": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@protoyard/database": "workspace:*"
  }
}

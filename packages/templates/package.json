{
  "name": "@protoyard/templates",
  "version": "1.0.0",
  "description": "Every Protoyard starter template, packed for `protoyard new` outside this repository: listTemplates() and templateDir(name).",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "node scripts/copy-templates.mjs",
    "postpack": "node scripts/copy-templates.mjs --clean",
    "typecheck": "tsc -p tsconfig.json"
  },
  "engines": {
    "node": ">=24.20.0"
  },
  "protoyard": {
    "pack": {
      "payload": [
        "templates/"
      ],
      "types": false
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DailybotHQ/protoyard",
    "directory": "packages/templates"
  },
  "homepage": "https://protoyard.app",
  "bugs": {
    "url": "https://github.com/DailybotHQ/protoyard/issues"
  },
  "keywords": [
    "protoyard",
    "templates",
    "prototypes"
  ]
}

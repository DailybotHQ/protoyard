{
  "name": "@protoyard/ai-ui",
  "version": "1.0.0",
  "description": "Svelte 5 assistant interface components for simulated AI prototypes.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.svelte"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./voice": {
      "types": "./src/voice/index.ts",
      "svelte": "./src/voice/index.ts",
      "default": "./src/voice/index.ts"
    },
    "./widget": {
      "types": "./src/widget/index.ts",
      "svelte": "./src/widget/index.ts",
      "default": "./src/widget/index.ts"
    },
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --threshold error"
  },
  "dependencies": {
    "@lucide/svelte": "^1.59.0",
    "@protoyard/ai": "workspace:*",
    "@protoyard/charts-ui": "workspace:*"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "svelte": "^5.57.2"
  },
  "peerDependencies": {
    "svelte": "^5.57.0"
  },
  "svelte": "./src/index.ts",
  "protoyard": {
    "build": {
      "assets": []
    }
  }
}

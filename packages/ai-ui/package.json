{
  "name": "@protoyard/ai-ui",
  "version": "1.0.0",
  "description": "Svelte 5 assistant interface components for simulated AI prototypes.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.svelte",
    "dist/**/*.css",
    "dist/**/*.svelte"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./voice": {
      "types": "./src/voice/index.ts",
      "svelte": "./src/voice/index.ts",
      "default": "./src/voice/index.ts"
    },
    "./widget": {
      "types": "./src/widget/index.ts",
      "svelte": "./src/widget/index.ts",
      "default": "./src/widget/index.ts"
    },
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --threshold error"
  },
  "dependencies": {
    "@lucide/svelte": "^1.59.0",
    "@protoyard/ai": "workspace:*",
    "@protoyard/charts-ui": "workspace:*"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "svelte": "^5.57.2"
  },
  "peerDependencies": {
    "svelte": "^5.57.0"
  },
  "protoyard": {
    "build": {
      "assets": []
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "svelte": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./voice": {
        "types": "./dist/voice/index.d.ts",
        "svelte": "./dist/voice/index.js",
        "default": "./dist/voice/index.js"
      },
      "./widget": {
        "types": "./dist/widget/index.d.ts",
        "svelte": "./dist/widget/index.js",
        "default": "./dist/widget/index.js"
      },
      "./styles.css": {
        "types": "./dist/styles.css.d.ts",
        "svelte": "./dist/styles.css",
        "default": "./dist/styles.css"
      }
    },
    "files": [
      "dist",
      "README.md",
      "LICENSE"
    ],
    "types": "./dist/index.d.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DailybotHQ/protoyard",
    "directory": "packages/ai-ui"
  },
  "homepage": "https://protoyard.app",
  "bugs": {
    "url": "https://github.com/DailybotHQ/protoyard/issues"
  },
  "engines": {
    "node": ">=24.20.0"
  },
  "keywords": [
    "protoyard",
    "svelte",
    "ai",
    "components"
  ]
}

{
  "name": "@protoyard/blocks",
  "version": "1.0.0",
  "description": "Framework-free content-block engine for Protoyard: thin re-exports of @texuli/blocks/core (and family engines) plus Zod schema adapters for decks, pages and docs.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./formula": "./src/formula/index.ts",
    "./interactive": "./src/interactive/index.ts",
    "./code": "./src/code/index.ts",
    "./diagram": "./src/diagram/index.ts",
    "./catalog": "./src/catalog/index.ts",
    "./schema": "./src/json-schema.ts",
    "./safety": "./src/safety.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@protoyard/ai": "workspace:*",
    "@protoyard/avatars": "workspace:*",
    "@protoyard/core": "workspace:*",
    "@texuli/blocks": "link:../../../texuli/packages/blocks",
    "zod": "^4.6.7"
  },
  "protoyard": {
    "build": {
      "group": "engine",
      "assets": []
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "schema"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./formula": {
        "types": "./dist/formula/index.d.ts",
        "import": "./dist/formula/index.js",
        "default": "./dist/formula/index.js"
      },
      "./interactive": {
        "types": "./dist/interactive/index.d.ts",
        "import": "./dist/interactive/index.js",
        "default": "./dist/interactive/index.js"
      },
      "./code": {
        "types": "./dist/code/index.d.ts",
        "import": "./dist/code/index.js",
        "default": "./dist/code/index.js"
      },
      "./diagram": {
        "types": "./dist/diagram/index.d.ts",
        "import": "./dist/diagram/index.js",
        "default": "./dist/diagram/index.js"
      },
      "./catalog": {
        "types": "./dist/catalog/index.d.ts",
        "import": "./dist/catalog/index.js",
        "default": "./dist/catalog/index.js"
      },
      "./schema": {
        "types": "./dist/json-schema.d.ts",
        "import": "./dist/json-schema.js",
        "default": "./dist/json-schema.js"
      },
      "./safety": {
        "types": "./dist/safety.d.ts",
        "import": "./dist/safety.js",
        "default": "./dist/safety.js"
      }
    },
    "types": "./dist/index.d.ts"
  },
  "engines": {
    "node": ">=24.20.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DailybotHQ/protoyard",
    "directory": "packages/blocks"
  },
  "homepage": "https://protoyard.app",
  "bugs": {
    "url": "https://github.com/DailybotHQ/protoyard/issues"
  },
  "keywords": [
    "protoyard",
    "blocks",
    "content",
    "slides"
  ]
}

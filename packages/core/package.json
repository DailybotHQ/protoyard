{
  "name": "@protoyard/core",
  "version": "1.0.0",
  "description": "Framework-agnostic contracts for Protoyard: manifests, scenarios, personas, permissions, simulation clock, environment, snapshots and themes.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./manifest": "./src/manifest.ts",
    "./review": "./src/review.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "zod": "^4.6.7"
  },
  "protoyard": {
    "build": {
      "group": "engine",
      "assets": []
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./manifest": {
        "types": "./dist/manifest.d.ts",
        "import": "./dist/manifest.js",
        "default": "./dist/manifest.js"
      },
      "./review": {
        "types": "./dist/review.d.ts",
        "import": "./dist/review.js",
        "default": "./dist/review.js"
      }
    },
    "types": "./dist/index.d.ts"
  },
  "engines": {
    "node": ">=24.20.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DailybotHQ/protoyard",
    "directory": "packages/core"
  },
  "homepage": "https://protoyard.app",
  "bugs": {
    "url": "https://github.com/DailybotHQ/protoyard/issues"
  },
  "keywords": [
    "protoyard",
    "prototype",
    "simulation",
    "typescript"
  ]
}

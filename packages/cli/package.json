{
  "name": "@protoyard/cli",
  "version": "1.9.3",
  "description": "The protoyard command line: discover, index, scaffold, run, validate, build, export and publish prototypes.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DailybotHQ/protoyard",
    "directory": "packages/cli"
  },
  "homepage": "https://protoyard.app",
  "bugs": {
    "url": "https://github.com/DailybotHQ/protoyard/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./capture": "./src/lib/capture/index.ts",
    "./static-server": "./src/lib/static-server.ts",
    "./adoption": "./src/lib/texuli-adoption.ts"
  },
  "protoyard": {
    "build": {
      "group": "tooling",
      "assets": []
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@protoyard/blocks": "workspace:*",
    "@protoyard/blueprint": "workspace:*",
    "@protoyard/core": "workspace:*",
    "@protoyard/crud": "workspace:*",
    "@protoyard/decks": "workspace:*",
    "@protoyard/offline": "workspace:*",
    "@protoyard/player": "workspace:*",
    "@protoyard/renderer-svelte": "workspace:*",
    "@protoyard/review": "workspace:*",
    "@protoyard/scenarios": "workspace:*",
    "@protoyard/templates": "workspace:*",
    "@protoyard/themes": "workspace:*",
    "@texuli/catalog": "0.17.3",
    "@texuli/spec": "0.17.3",
    "@texuli/tokens": "0.17.3",
    "@texuli/tools": "0.17.3",
    "commander": "^15.0.0",
    "fflate": "^0.8.3",
    "picocolors": "^1.1.1",
    "sirv": "^3.0.2",
    "tsx": "^4.23.15",
    "vite": "^8.3.5",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@playwright/test": "^1.64.1"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "bin": {
    "protoyard": "./bin/protoyard.mjs"
  },
  "files": [
    "bin",
    "dist",
    "ci-templates",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "bin": {
      "protoyard": "./dist/bin.js"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./capture": {
        "types": "./dist/lib/capture/index.d.ts",
        "import": "./dist/lib/capture/index.js"
      },
      "./static-server": {
        "types": "./dist/lib/static-server.d.ts",
        "import": "./dist/lib/static-server.js"
      },
      "./adoption": {
        "types": "./dist/lib/texuli-adoption.d.ts",
        "import": "./dist/lib/texuli-adoption.js"
      }
    },
    "types": "./dist/index.d.ts"
  },
  "engines": {
    "node": ">=24.20.0"
  }
}

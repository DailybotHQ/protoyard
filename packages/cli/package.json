{
  "name": "@protoyard/cli",
  "version": "1.0.0",
  "description": "The protoyard command line: discover, index, scaffold, run, validate, build, export and publish prototypes.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "protoyard": {
    "build": {
      "group": "tooling",
      "assets": []
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@protoyard/blueprint": "workspace:*",
    "@protoyard/core": "workspace:*",
    "@protoyard/crud": "workspace:*",
    "@protoyard/offline": "workspace:*",
    "@protoyard/renderer-svelte": "workspace:*",
    "@protoyard/review": "workspace:*",
    "@protoyard/templates": "workspace:*",
    "@protoyard/themes": "workspace:*",
    "commander": "^15.0.0",
    "fflate": "^0.8.3",
    "picocolors": "^1.1.1",
    "sirv": "^3.0.2",
    "tsx": "^4.23.15",
    "vite": "^8.3.4",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@playwright/test": "^1.64.1"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "bin": {
    "protoyard": "./bin/protoyard.mjs"
  },
  "files": [
    "bin",
    "dist",
    "ci-templates"
  ],
  "publishConfig": {
    "access": "public",
    "bin": {
      "protoyard": "./dist/bin.js"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "types": "./dist/index.d.ts"
  },
  "engines": {
    "node": ">=24.20.0"
  }
}

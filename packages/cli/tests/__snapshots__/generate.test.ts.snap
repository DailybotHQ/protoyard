import { Database, LayoutDashboard, Users } from '@lucide/svelte';
import { defineRoutes } from '@protoyard/renderer-svelte';

/** Hash routes. Every screen is a lazy chunk, so adding entities does not grow the initial JS. */
export const routes = defineRoutes([
  {
    name: 'home',
    description: 'Overview with a count per entity',
    path: '/',
    title: 'Home',
    load: () => import('../screens/Home.svelte'),
  },
  {
    name: 'customer-list',
    description: 'Customers: list, create, edit and delete',
    path: '/customers',
    title: 'Customers',
    load: () => import('./screens/CustomerPage.svelte'),
  },
  {
    name: 'customer-detail',
    description: 'One customer: edit form',
    path: '/customers/:id',
    title: 'Customers',
    load: () => import('./screens/CustomerPage.svelte'),
  },
  {
    name: 'support-ticket-list',
    description: 'Tickets "VIP" </script>: list, create, edit and delete',
    path: '/support-tickets',
    title: 'Tickets "VIP" </script>',
    load: () => import('./screens/SupportTicketPage.svelte'),
  },
  {
    name: 'support-ticket-detail',
    description: 'One support ticket: edit form',
    path: '/support-tickets/:id',
    title: 'Tickets "VIP" </script>',
    load: () => import('./screens/SupportTicketPage.svelte'),
  },
  {
    name: 'members',
    description: 'Workspace people and their simulated roles',
    path: '/members',
    title: 'Members',
    load: () => import('../screens/Members.svelte'),
  },
]);

/** Sidebar entries in blueprint order. */
export const nav = [
  { path: '/', label: 'Home', icon: LayoutDashboard, exact: true },
  { path: '/customers', label: 'Customers', icon: Database },
  { path: '/support-tickets', label: 'Tickets "VIP" </script>', icon: Database },
  { path: '/members', label: 'Members', icon: Users },
];
"
`;


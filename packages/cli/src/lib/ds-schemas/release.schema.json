{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:protoyard:design-system:release:1",
  "title": "Design-system release record (protoyard/ds-release), planned",
  "description": "design-systems/<id>/releases/<version>.json (planned: no command writes this file yet; the contract may change before it lands). Generated from packages/cli/src/lib/ds-contracts.ts.",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "protoyard/ds-release"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "designSystem": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "release": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "contentHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "approvedBy": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[^\\u0000-\\u001f\\u007f\\u2028\\u2029]*$"
    },
    "approvedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "components": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z0-9]{0,63}$"
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": ["name", "version", "sha256"],
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "string",
      "maxLength": 4000
    }
  },
  "required": [
    "format",
    "version",
    "designSystem",
    "release",
    "contentHash",
    "approvedBy",
    "approvedAt",
    "components"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:protoyard:design-system:bundle:1",
  "title": "Portable design-system bundle (protoyard/ds-bundle)",
  "description": "<id>-<version>.ds-bundle.json (protoyard ds export <id> --bundle). Generated from packages/cli/src/lib/ds-contracts.ts.",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "protoyard/ds-bundle"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "designSystem": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "release": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "contentHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "texuli": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "files": {
      "minItems": 1,
      "maxItems": 400,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[A-Za-z0-9._/-]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1048576
          },
          "text": {
            "type": "string",
            "maxLength": 1048576
          },
          "from": {
            "type": "string",
            "pattern": "^(?:document|library:[a-z][a-z0-9-]{0,63})$"
          }
        },
        "required": ["path", "sha256", "bytes"],
        "additionalProperties": false
      }
    }
  },
  "required": ["format", "version", "designSystem", "release", "contentHash", "texuli", "files"],
  "additionalProperties": false
}

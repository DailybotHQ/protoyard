{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:protoyard:design-system:components:1",
  "title": "Design-system component library (protoyard/ds-components)",
  "description": "design-systems/<id>/components.json. Generated from packages/cli/src/lib/ds-contracts.ts.",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "protoyard/ds-components"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "components": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z0-9]{0,63}$"
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "maxLength": 280
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
          },
          "status": {
            "type": "string",
            "enum": ["draft", "approved"]
          },
          "file": {
            "type": "string",
            "pattern": "^components\\/[A-Z][A-Za-z0-9]{0,63}\\.svelte$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "approvedBy": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "approvedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": ["name", "purpose", "version", "status", "file", "sha256"],
        "additionalProperties": false
      }
    }
  },
  "required": ["format", "version", "components"],
  "additionalProperties": false
}

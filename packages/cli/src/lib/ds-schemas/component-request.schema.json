{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:protoyard:design-system:component-request:1",
  "title": "Design-system component request (protoyard/ds-component-request)",
  "description": "design-systems/<id>/requests/<Name>.json. Generated from packages/cli/src/lib/ds-contracts.ts.",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "protoyard/ds-component-request"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]{0,63}$"
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 280,
      "pattern": "^[^\\u0000-\\u001f\\u007f\\u2028\\u2029]*$"
    },
    "why": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "^[^\\u0000-\\u001f\\u007f\\u2028\\u2029]*$"
    },
    "requestedBy": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[^\\u0000-\\u001f\\u007f\\u2028\\u2029]*$"
    },
    "requestedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "status": {
      "type": "string",
      "enum": ["open", "approved"]
    },
    "approvedBy": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[^\\u0000-\\u001f\\u007f\\u2028\\u2029]*$"
    },
    "approvedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    }
  },
  "required": ["format", "version", "name", "purpose", "why", "requestedAt", "status"],
  "additionalProperties": false
}

{
  "name": "@protoyard/charts-ui",
  "version": "1.0.0",
  "description": "Svelte chart components for Protoyard: thin re-exports and adapters over @texuli/charts families.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "dist/**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./cartesian": {
      "types": "./src/cartesian/index.ts",
      "svelte": "./src/cartesian/index.ts",
      "default": "./src/cartesian/index.ts"
    },
    "./flow": {
      "types": "./src/flow/index.ts",
      "svelte": "./src/flow/index.ts",
      "default": "./src/flow/index.ts"
    },
    "./interaction": {
      "types": "./src/interaction/index.ts",
      "svelte": "./src/interaction/index.ts",
      "default": "./src/interaction/index.ts"
    },
    "./part-whole": {
      "types": "./src/part-whole/index.ts",
      "svelte": "./src/part-whole/index.ts",
      "default": "./src/part-whole/index.ts"
    },
    "./matrix": {
      "types": "./src/matrix/index.ts",
      "svelte": "./src/matrix/index.ts",
      "default": "./src/matrix/index.ts"
    },
    "./compact": {
      "types": "./src/compact/index.ts",
      "svelte": "./src/compact/index.ts",
      "default": "./src/compact/index.ts"
    },
    "./canvas": {
      "types": "./src/canvas/index.ts",
      "svelte": "./src/canvas/index.ts",
      "default": "./src/canvas/index.ts"
    },
    "./geo": {
      "types": "./src/geo/index.ts",
      "svelte": "./src/geo/index.ts",
      "default": "./src/geo/index.ts"
    },
    "./player.css": "./src/player.css",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --threshold error"
  },
  "dependencies": {
    "@protoyard/charts": "workspace:*",
    "@texuli/charts": "link:../../../texuli/packages/charts"
  },
  "devDependencies": {
    "svelte": "^5.57.2"
  },
  "peerDependencies": {
    "svelte": "^5.57.0"
  },
  "protoyard": {
    "build": {
      "assets": [
        "src/player.css"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "svelte": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./cartesian": {
        "types": "./dist/cartesian/index.d.ts",
        "svelte": "./dist/cartesian/index.js",
        "default": "./dist/cartesian/index.js"
      },
      "./part-whole": {
        "types": "./dist/part-whole/index.d.ts",
        "svelte": "./dist/part-whole/index.js",
        "default": "./dist/part-whole/index.js"
      },
      "./matrix": {
        "types": "./dist/matrix/index.d.ts",
        "svelte": "./dist/matrix/index.js",
        "default": "./dist/matrix/index.js"
      },
      "./compact": {
        "types": "./dist/compact/index.d.ts",
        "svelte": "./dist/compact/index.js",
        "default": "./dist/compact/index.js"
      },
      "./canvas": {
        "types": "./dist/canvas/index.d.ts",
        "svelte": "./dist/canvas/index.js",
        "default": "./dist/canvas/index.js"
      },
      "./geo": {
        "types": "./dist/geo/index.d.ts",
        "svelte": "./dist/geo/index.js",
        "default": "./dist/geo/index.js"
      },
      "./player.css": {
        "types": "./dist/player.css.d.ts",
        "svelte": "./dist/player.css",
        "default": "./dist/player.css"
      },
      "./styles.css": {
        "types": "./dist/styles.css.d.ts",
        "svelte": "./dist/styles.css",
        "default": "./dist/styles.css"
      }
    },
    "files": [
      "dist",
      "README.md",
      "LICENSE"
    ],
    "types": "./dist/index.d.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DailybotHQ/protoyard",
    "directory": "packages/charts-ui"
  },
  "homepage": "https://protoyard.app",
  "bugs": {
    "url": "https://github.com/DailybotHQ/protoyard/issues"
  },
  "engines": {
    "node": ">=24.20.0"
  },
  "keywords": [
    "protoyard",
    "svelte",
    "charts",
    "visualization"
  ]
}

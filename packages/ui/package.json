{
  "name": "@protoyard/ui",
  "version": "1.0.0",
  "description": "Svelte 5 UI components and product patterns for Protoyard prototypes, built on Texuli (Tailwind CSS 4 + Lucide).",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.svelte",
    "dist/**/*.css",
    "dist/**/*.svelte"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./player.css": "./src/player.css",
    "./styles.css": "./src/styles.css",
    "./layouts/docs": {
      "types": "./src/layouts/DocsLayout.svelte",
      "svelte": "./src/layouts/DocsLayout.svelte",
      "default": "./src/layouts/DocsLayout.svelte"
    },
    "./layouts/marketing": {
      "types": "./src/layouts/marketing.ts",
      "svelte": "./src/layouts/marketing.ts",
      "default": "./src/layouts/marketing.ts"
    }
  },
  "scripts": {
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --threshold error"
  },
  "dependencies": {
    "@lucide/svelte": "^1.62.0",
    "@texuli/chat": "0.8.0",
    "@texuli/core": "0.8.0",
    "@texuli/data": "0.8.1",
    "@texuli/date": "0.8.0",
    "@texuli/primitives": "0.8.0",
    "texuli": "0.8.0"
  },
  "devDependencies": {
    "svelte": "^5.57.3"
  },
  "peerDependencies": {
    "svelte": "^5.57.0"
  },
  "protoyard": {
    "build": {
      "assets": [
        "src/player.css"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "svelte": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./player.css": {
        "types": "./dist/player.css.d.ts",
        "svelte": "./dist/player.css",
        "default": "./dist/player.css"
      },
      "./styles.css": {
        "types": "./dist/styles.css.d.ts",
        "svelte": "./dist/styles.css",
        "default": "./dist/styles.css"
      },
      "./layouts/docs": {
        "types": "./dist/layouts/DocsLayout.svelte.d.ts",
        "svelte": "./dist/layouts/DocsLayout.svelte",
        "default": "./dist/layouts/DocsLayout.svelte"
      },
      "./layouts/marketing": {
        "types": "./dist/layouts/marketing.d.ts",
        "svelte": "./dist/layouts/marketing.js",
        "default": "./dist/layouts/marketing.js"
      }
    },
    "files": [
      "dist",
      "README.md",
      "LICENSE"
    ],
    "types": "./dist/index.d.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DailybotHQ/protoyard",
    "directory": "packages/ui"
  },
  "homepage": "https://protoyard.app",
  "bugs": {
    "url": "https://github.com/DailybotHQ/protoyard/issues"
  },
  "engines": {
    "node": ">=24.20.0"
  },
  "keywords": [
    "protoyard",
    "svelte",
    "ui",
    "components"
  ]
}

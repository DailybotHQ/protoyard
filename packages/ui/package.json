{
  "name": "@protoyard/ui",
  "version": "1.0.0",
  "description": "Svelte 5 UI primitives and product patterns for Protoyard prototypes (Bits UI + Tailwind CSS 4 + Lucide).",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.svelte",
    "dist/**/*.css",
    "dist/**/*.svelte"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles.css": "./src/styles.css",
    "./layouts/docs": {
      "types": "./src/layouts/DocsLayout.svelte",
      "svelte": "./src/layouts/DocsLayout.svelte",
      "default": "./src/layouts/DocsLayout.svelte"
    },
    "./layouts/marketing": {
      "types": "./src/layouts/MarketingLayout.svelte",
      "svelte": "./src/layouts/MarketingLayout.svelte",
      "default": "./src/layouts/MarketingLayout.svelte"
    }
  },
  "scripts": {
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --threshold error"
  },
  "dependencies": {
    "@lucide/svelte": "^1.59.0",
    "bits-ui": "^2.19.5",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1"
  },
  "devDependencies": {
    "svelte": "^5.57.2"
  },
  "peerDependencies": {
    "svelte": "^5.57.0"
  },
  "protoyard": {
    "build": {
      "assets": []
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "svelte": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./styles.css": {
        "types": "./dist/styles.css.d.ts",
        "svelte": "./dist/styles.css",
        "default": "./dist/styles.css"
      },
      "./layouts/docs": {
        "types": "./dist/layouts/DocsLayout.svelte.d.ts",
        "svelte": "./dist/layouts/DocsLayout.svelte",
        "default": "./dist/layouts/DocsLayout.svelte"
      },
      "./layouts/marketing": {
        "types": "./dist/layouts/MarketingLayout.svelte.d.ts",
        "svelte": "./dist/layouts/MarketingLayout.svelte",
        "default": "./dist/layouts/MarketingLayout.svelte"
      }
    },
    "files": [
      "dist",
      "README.md",
      "LICENSE"
    ],
    "types": "./dist/index.d.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DailybotHQ/protoyard",
    "directory": "packages/ui"
  },
  "homepage": "https://protoyard.app",
  "bugs": {
    "url": "https://github.com/DailybotHQ/protoyard/issues"
  },
  "engines": {
    "node": ">=24.20.0"
  },
  "keywords": [
    "protoyard",
    "svelte",
    "ui",
    "components"
  ]
}

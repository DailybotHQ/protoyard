{
  "name": "@protoyard/ui",
  "version": "1.0.0",
  "description": "Svelte 5 UI primitives and product patterns for Protoyard prototypes (Bits UI + Tailwind CSS 4 + Lucide).",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.svelte"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --threshold error"
  },
  "dependencies": {
    "@lucide/svelte": "^1.59.0",
    "bits-ui": "^2.19.5",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1"
  },
  "devDependencies": {
    "svelte": "^5.57.2"
  },
  "peerDependencies": {
    "svelte": "^5.57.0"
  },
  "svelte": "./src/index.ts",
  "protoyard": {
    "build": {
      "assets": []
    }
  }
}

{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "rewriteRelativeImportExtensions": true,
    "preserveSymlinks": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src/embed/**/*.ts", "src/boot.ts"]
}

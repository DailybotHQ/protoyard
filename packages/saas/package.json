{
  "name": "@protoyard/saas",
  "version": "1.0.0",
  "description": "Simulated SaaS kit engine for Protoyard prototypes: tables, row schemas and integrity rules for accounts, sign-in history, tokens, MFA, invitations, an inbox, subscriptions, invoices and onboarding. Simulation for UX, never security.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@protoyard/avatars": "workspace:*",
    "@protoyard/core": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@protoyard/runtime": "workspace:*",
    "@protoyard/scenarios": "workspace:*"
  },
  "protoyard": {
    "build": {
      "group": "engine",
      "assets": []
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    },
    "types": "./dist/index.d.ts"
  },
  "engines": {
    "node": ">=24.20.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DailybotHQ/protoyard",
    "directory": "packages/saas"
  },
  "homepage": "https://protoyard.app",
  "bugs": {
    "url": "https://github.com/DailybotHQ/protoyard/issues"
  },
  "keywords": [
    "protoyard",
    "saas",
    "simulation",
    "prototype"
  ]
}

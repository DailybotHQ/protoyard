{
  "name": "@protoyard/blocks-ui",
  "version": "1.0.0",
  "description": "Svelte 5 renderers for Protoyard's shared content blocks: a small dispatcher plus one lazy subpath per block family (text, media, data, structure, code, diagram, interactive, map, embed). Never re-exported from @protoyard/ui.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "dist/**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./text": {
      "types": "./src/text/index.ts",
      "svelte": "./src/text/index.ts",
      "default": "./src/text/index.ts"
    },
    "./media": {
      "types": "./src/media/index.ts",
      "svelte": "./src/media/index.ts",
      "default": "./src/media/index.ts"
    },
    "./data": {
      "types": "./src/data/index.ts",
      "svelte": "./src/data/index.ts",
      "default": "./src/data/index.ts"
    },
    "./structure": {
      "types": "./src/structure/index.ts",
      "svelte": "./src/structure/index.ts",
      "default": "./src/structure/index.ts"
    },
    "./code": {
      "types": "./src/code/index.ts",
      "svelte": "./src/code/index.ts",
      "default": "./src/code/index.ts"
    },
    "./diagram": {
      "types": "./src/diagram/index.ts",
      "svelte": "./src/diagram/index.ts",
      "default": "./src/diagram/index.ts"
    },
    "./interactive": {
      "types": "./src/interactive/index.ts",
      "svelte": "./src/interactive/index.ts",
      "default": "./src/interactive/index.ts"
    },
    "./map": {
      "types": "./src/map/index.ts",
      "svelte": "./src/map/index.ts",
      "default": "./src/map/index.ts"
    },
    "./embed": {
      "types": "./src/embed/index.ts",
      "svelte": "./src/embed/index.ts",
      "default": "./src/embed/index.ts"
    },
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --threshold error"
  },
  "dependencies": {
    "@lucide/svelte": "^1.59.0",
    "@protoyard/ai": "workspace:*",
    "@protoyard/blocks": "workspace:*",
    "@protoyard/charts-ui": "workspace:*",
    "@protoyard/core": "workspace:*",
    "@protoyard/renderer-svelte": "workspace:*",
    "@protoyard/ui": "workspace:*",
    "@protoyard/views-ui": "workspace:*"
  },
  "devDependencies": {
    "svelte": "^5.57.2"
  },
  "peerDependencies": {
    "svelte": "^5.57.0"
  },
  "protoyard": {
    "build": {
      "assets": []
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "svelte": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./text": {
        "types": "./dist/text/index.d.ts",
        "svelte": "./dist/text/index.js",
        "default": "./dist/text/index.js"
      },
      "./media": {
        "types": "./dist/media/index.d.ts",
        "svelte": "./dist/media/index.js",
        "default": "./dist/media/index.js"
      },
      "./data": {
        "types": "./dist/data/index.d.ts",
        "svelte": "./dist/data/index.js",
        "default": "./dist/data/index.js"
      },
      "./structure": {
        "types": "./dist/structure/index.d.ts",
        "svelte": "./dist/structure/index.js",
        "default": "./dist/structure/index.js"
      },
      "./code": {
        "types": "./dist/code/index.d.ts",
        "svelte": "./dist/code/index.js",
        "default": "./dist/code/index.js"
      },
      "./diagram": {
        "types": "./dist/diagram/index.d.ts",
        "svelte": "./dist/diagram/index.js",
        "default": "./dist/diagram/index.js"
      },
      "./interactive": {
        "types": "./dist/interactive/index.d.ts",
        "svelte": "./dist/interactive/index.js",
        "default": "./dist/interactive/index.js"
      },
      "./map": {
        "types": "./dist/map/index.d.ts",
        "svelte": "./dist/map/index.js",
        "default": "./dist/map/index.js"
      },
      "./embed": {
        "types": "./dist/embed/index.d.ts",
        "svelte": "./dist/embed/index.js",
        "default": "./dist/embed/index.js"
      },
      "./styles.css": {
        "types": "./dist/styles.css.d.ts",
        "svelte": "./dist/styles.css",
        "default": "./dist/styles.css"
      }
    },
    "files": [
      "dist",
      "README.md",
      "LICENSE"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DailybotHQ/protoyard",
    "directory": "packages/blocks-ui"
  },
  "homepage": "https://protoyard.app",
  "bugs": {
    "url": "https://github.com/DailybotHQ/protoyard/issues"
  },
  "engines": {
    "node": ">=24.20.0"
  },
  "keywords": [
    "protoyard",
    "svelte",
    "blocks",
    "slides",
    "components"
  ]
}

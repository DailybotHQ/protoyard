{
  "name": "@protoyard/renderer-svelte",
  "version": "1.0.0",
  "description": "Svelte 5 + Vite renderer for Protoyard: Vite config factory, app mounting, reactive runtime bindings and live queries.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.svelte",
    "dist/**/*.css",
    "dist/**/*.svelte"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./vite": "./src/vite.ts",
    "./avatars-plugin": "./src/avatars-plugin.ts",
    "./app.css": "./src/app.css",
    "./env": "./src/env.d.ts"
  },
  "scripts": {
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --threshold error"
  },
  "dependencies": {
    "@protoyard/avatars": "workspace:*",
    "@protoyard/core": "workspace:*",
    "@protoyard/devtools": "workspace:*",
    "@protoyard/offline": "workspace:*",
    "@protoyard/review-ui": "workspace:*",
    "@protoyard/runtime": "workspace:*",
    "@protoyard/themes": "workspace:*",
    "@protoyard/ui": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "dexie": "^4.4.7",
    "tailwindcss": "^4.3.3",
    "texuli": "0.8.0",
    "vite": "^8.3.5"
  },
  "devDependencies": {
    "svelte": "^5.57.2"
  },
  "peerDependencies": {
    "svelte": "^5.57.0"
  },
  "protoyard": {
    "build": {
      "assets": []
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "svelte": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./vite": {
        "types": "./dist/vite.d.ts",
        "svelte": "./dist/vite.js",
        "default": "./dist/vite.js"
      },
      "./avatars-plugin": {
        "types": "./dist/avatars-plugin.d.ts",
        "svelte": "./dist/avatars-plugin.js",
        "default": "./dist/avatars-plugin.js"
      },
      "./app.css": {
        "types": "./dist/app.css.d.ts",
        "svelte": "./dist/app.css",
        "default": "./dist/app.css"
      },
      "./env": {
        "types": "./dist/env.d.ts",
        "svelte": "./dist/env.d.ts",
        "default": "./dist/env.d.ts"
      }
    },
    "files": [
      "dist",
      "README.md",
      "LICENSE"
    ],
    "types": "./dist/index.d.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DailybotHQ/protoyard",
    "directory": "packages/renderer-svelte"
  },
  "homepage": "https://protoyard.app",
  "bugs": {
    "url": "https://github.com/DailybotHQ/protoyard/issues"
  },
  "engines": {
    "node": ">=24.20.0"
  },
  "keywords": [
    "protoyard",
    "svelte",
    "renderer",
    "vite"
  ]
}

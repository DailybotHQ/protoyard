{
  "name": "@protoyard/scenarios",
  "version": "1.0.0",
  "description": "Scenario engine for Protoyard: presets, seeded generator SDK (faker + PRNG + fixed clock), referential-integrity checks and timeline helpers.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./presets": "./src/presets.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@protoyard/avatars": "workspace:*",
    "@protoyard/core": "workspace:*",
    "@faker-js/faker": "^10.6.0"
  },
  "protoyard": {
    "build": {
      "group": "engine",
      "assets": []
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./presets": {
        "types": "./dist/presets.d.ts",
        "import": "./dist/presets.js",
        "default": "./dist/presets.js"
      }
    },
    "types": "./dist/index.d.ts"
  },
  "engines": {
    "node": ">=24.20.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DailybotHQ/protoyard",
    "directory": "packages/scenarios"
  },
  "homepage": "https://protoyard.app",
  "bugs": {
    "url": "https://github.com/DailybotHQ/protoyard/issues"
  },
  "keywords": [
    "protoyard",
    "scenarios",
    "deterministic",
    "prototype"
  ]
}

{
  "name": "@protoyard/saas-ui",
  "version": "1.0.0",
  "description": "Svelte 5 screens and route helpers for Protoyard simulated SaaS kits (auth, inbox, onboarding, workspaces). Simulation UX only — never security.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.svelte",
    "dist/**/*.css",
    "dist/**/*.svelte"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --threshold error"
  },
  "dependencies": {
    "@lucide/svelte": "^1.59.0",
    "@protoyard/core": "workspace:*",
    "@protoyard/renderer-svelte": "workspace:*",
    "@protoyard/saas": "workspace:*",
    "@protoyard/ui": "workspace:*",
    "texuli": "0.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "svelte": "^5.57.2"
  },
  "peerDependencies": {
    "svelte": "^5.57.0"
  },
  "protoyard": {
    "build": {
      "assets": []
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "svelte": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./styles.css": {
        "types": "./dist/styles.css.d.ts",
        "svelte": "./dist/styles.css",
        "default": "./dist/styles.css"
      }
    },
    "files": [
      "dist",
      "README.md",
      "LICENSE"
    ],
    "types": "./dist/index.d.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DailybotHQ/protoyard",
    "directory": "packages/saas-ui"
  },
  "homepage": "https://protoyard.app",
  "bugs": {
    "url": "https://github.com/DailybotHQ/protoyard/issues"
  },
  "engines": {
    "node": ">=24.20.0"
  },
  "keywords": [
    "protoyard",
    "svelte",
    "saas",
    "components"
  ]
}

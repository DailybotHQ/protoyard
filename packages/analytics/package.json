{
  "name": "@protoyard/analytics",
  "version": "1.0.0",
  "description": "Framework-agnostic analytics engine for Protoyard prototypes: event and metric contracts, date ranges, funnels, cohorts and deterministic analytics generators (no Svelte).",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./generators": "./src/generators/index.ts",
    "./funnel": "./src/funnel.ts",
    "./cohort": "./src/cohort.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@protoyard/core": "workspace:*",
    "@protoyard/scenarios": "workspace:*",
    "zod": "^4.6.7"
  },
  "protoyard": {
    "build": {
      "group": "engine",
      "assets": []
    }
  }
}

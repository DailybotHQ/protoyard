{
  "name": "@protoyard/analytics",
  "version": "1.0.0",
  "description": "Framework-agnostic analytics engine for Protoyard prototypes: event and metric contracts, date ranges, funnels, cohorts and deterministic analytics generators (no Svelte).",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./generators": "./src/generators/index.ts",
    "./funnel": "./src/funnel.ts",
    "./cohort": "./src/cohort.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@protoyard/core": "workspace:*",
    "@protoyard/scenarios": "workspace:*",
    "zod": "^4.6.7"
  },
  "protoyard": {
    "build": {
      "group": "engine",
      "assets": []
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./generators": {
        "types": "./dist/generators/index.d.ts",
        "import": "./dist/generators/index.js",
        "default": "./dist/generators/index.js"
      },
      "./funnel": {
        "types": "./dist/funnel.d.ts",
        "import": "./dist/funnel.js",
        "default": "./dist/funnel.js"
      },
      "./cohort": {
        "types": "./dist/cohort.d.ts",
        "import": "./dist/cohort.js",
        "default": "./dist/cohort.js"
      }
    },
    "types": "./dist/index.d.ts"
  },
  "engines": {
    "node": ">=24.20.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DailybotHQ/protoyard",
    "directory": "packages/analytics"
  },
  "homepage": "https://protoyard.app",
  "bugs": {
    "url": "https://github.com/DailybotHQ/protoyard/issues"
  },
  "keywords": [
    "protoyard",
    "analytics",
    "metrics",
    "prototype"
  ]
}

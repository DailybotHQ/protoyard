{
  "name": "@protoyard/review-ui",
  "version": "1.0.0",
  "description": "Svelte 5 review UI for published Protoyard prototypes: comment mode and pins, threads, the comments panel and review toolbar, and the lazy mount entry. Loaded only when review is enabled.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.svelte",
    "dist/**/*.css",
    "dist/**/*.svelte"
  ],
  "exports": {
    "./overlay": {
      "types": "./src/overlay/index.ts",
      "svelte": "./src/overlay/index.ts",
      "default": "./src/overlay/index.ts"
    },
    "./thread": {
      "types": "./src/thread/index.ts",
      "svelte": "./src/thread/index.ts",
      "default": "./src/thread/index.ts"
    },
    "./panel": {
      "types": "./src/panel/index.ts",
      "svelte": "./src/panel/index.ts",
      "default": "./src/panel/index.ts"
    },
    "./toolbar": {
      "types": "./src/toolbar/index.ts",
      "svelte": "./src/toolbar/index.ts",
      "default": "./src/toolbar/index.ts"
    },
    "./mount": {
      "types": "./src/mount/index.ts",
      "svelte": "./src/mount/index.ts",
      "default": "./src/mount/index.ts"
    },
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --threshold error"
  },
  "dependencies": {
    "@lucide/svelte": "^1.59.0",
    "@protoyard/core": "workspace:*",
    "@protoyard/review": "workspace:*",
    "@protoyard/ui": "workspace:*",
    "@protoyard/views": "workspace:*",
    "@protoyard/views-ui": "workspace:*"
  },
  "devDependencies": {
    "svelte": "^5.57.2"
  },
  "peerDependencies": {
    "svelte": "^5.57.0"
  },
  "protoyard": {
    "build": {
      "assets": []
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      "./overlay": {
        "types": "./dist/overlay/index.d.ts",
        "svelte": "./dist/overlay/index.js",
        "default": "./dist/overlay/index.js"
      },
      "./thread": {
        "types": "./dist/thread/index.d.ts",
        "svelte": "./dist/thread/index.js",
        "default": "./dist/thread/index.js"
      },
      "./panel": {
        "types": "./dist/panel/index.d.ts",
        "svelte": "./dist/panel/index.js",
        "default": "./dist/panel/index.js"
      },
      "./toolbar": {
        "types": "./dist/toolbar/index.d.ts",
        "svelte": "./dist/toolbar/index.js",
        "default": "./dist/toolbar/index.js"
      },
      "./mount": {
        "types": "./dist/mount/index.d.ts",
        "svelte": "./dist/mount/index.js",
        "default": "./dist/mount/index.js"
      },
      "./styles.css": {
        "types": "./dist/styles.css.d.ts",
        "svelte": "./dist/styles.css",
        "default": "./dist/styles.css"
      }
    },
    "files": [
      "dist",
      "README.md",
      "LICENSE"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DailybotHQ/protoyard",
    "directory": "packages/review-ui"
  },
  "homepage": "https://protoyard.app",
  "bugs": {
    "url": "https://github.com/DailybotHQ/protoyard/issues"
  },
  "engines": {
    "node": ">=24.20.0"
  },
  "keywords": [
    "protoyard",
    "svelte",
    "review",
    "comments"
  ]
}

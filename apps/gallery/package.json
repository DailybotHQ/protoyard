{
  "name": "@protoyard/gallery",
  "version": "1.0.0",
  "description": "The Protoyard gallery: a static Astro site that lists prototypes and templates from the generated metadata registry.",
  "license": "MIT",
  "type": "module",
  "files": [
    "src",
    "public",
    "astro.config.mjs",
    "tsconfig.json",
    "README.md"
  ],
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "typecheck": "astro check"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/svelte": "^9.1.0",
    "@lucide/svelte": "^1.59.0",
    "@protoyard/blueprint": "workspace:*",
    "@protoyard/core": "workspace:*",
    "@protoyard/player": "workspace:*",
    "@protoyard/themes": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@texuli/astro": "0.3.0",
    "@texuli/tokens": "0.3.0",
    "astro": "^7.4.0",
    "svelte": "^5.57.2",
    "tailwindcss": "^4.3.3",
    "texuli": "0.3.0"
  },
  "devDependencies": {
    "axe-core": "^4.14.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "protoyard": {
    "pack": {
      "payload": [
        "src/",
        "public/"
      ],
      "types": false
    }
  }
}

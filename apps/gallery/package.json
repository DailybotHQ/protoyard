{
  "name": "@protoyard/gallery",
  "version": "1.9.4",
  "description": "The Protoyard gallery: a static Astro site that lists prototypes and templates from the generated metadata registry.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DailybotHQ/protoyard",
    "directory": "apps/gallery"
  },
  "homepage": "https://protoyard.app",
  "bugs": {
    "url": "https://github.com/DailybotHQ/protoyard/issues"
  },
  "type": "module",
  "files": [
    "src",
    "public",
    "astro.config.mjs",
    "tsconfig.json",
    "README.md",
    "CHANGELOG.md",
    "guides"
  ],
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "prepack": "node scripts/copy-guides.mjs",
    "postpack": "node scripts/copy-guides.mjs --clean"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/svelte": "^9.1.2",
    "@lucide/svelte": "^1.64.0",
    "@protoyard/blueprint": "workspace:*",
    "@protoyard/core": "workspace:*",
    "@protoyard/player": "workspace:*",
    "@protoyard/themes": "workspace:*",
    "@protoyard/ui": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@texuli/astro": "0.17.4",
    "@texuli/tokens": "0.17.4",
    "astro": "^7.4.4",
    "svelte": "^5.57.3",
    "tailwindcss": "^4.3.3",
    "texuli": "0.17.4"
  },
  "devDependencies": {
    "axe-core": "^4.14.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "protoyard": {
    "pack": {
      "payload": [
        "guides/",
        "public/",
        "src/"
      ],
      "types": false
    }
  }
}

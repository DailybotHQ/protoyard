---
import '@/styles/global.css';
import { themeBootstrapScript } from '@texuli/astro';
import CommandPaletteTrigger from '@/components/CommandPaletteTrigger.svelte';
import ThemeToggle from '@/components/ThemeToggle.svelte';
import { withBase } from '@/lib/format';
import { APPEARANCE_MIGRATION_SCRIPT } from '@/lib/theme';

interface Props {
  title?: string;
  description?: string;
  /** Base-relative path to use for canonical and social metadata. */
  canonicalPath?: string;
  active?: 'home' | 'templates' | 'marketplace' | 'themes' | 'new' | 'features' | 'play' | 'docs';
  /** Keep the page out of search results (404, compare, create flow). */
  noindex?: boolean;
}

const {
  title,
  description = 'Build prototypes that feel real. Real behavior. Fake infrastructure.',
  canonicalPath,
  active,
  noindex = false,
} = Astro.props;
const fullTitle = title ? `${title} · Protoyard` : 'Protoyard — Build prototypes that feel real';
// With a site (`protoyard showcase --site https://…` or GALLERY_SITE), links
// and images are absolute so search engines and link previews resolve them.
const absolute = (path: string) => (Astro.site ? new URL(path, Astro.site).href : path);
// Astro.url.pathname is route-relative, while showcase links include the
// configured base. Normalize both forms so canonical URLs match that base.
const configuredBase = import.meta.env.BASE_URL.replace(/\/$/, '');
const routePath =
  configuredBase && Astro.url.pathname.startsWith(`${configuredBase}/`)
    ? Astro.url.pathname.slice(configuredBase.length)
    : Astro.url.pathname;
const canonical = Astro.site
  ? new URL(canonicalPath ?? withBase(routePath), Astro.site).href
  : null;
// One brand card for every page, so a shared protoyard.app link always shows it.
const socialImage = absolute(withBase('/og-image.jpg'));
const socialImageAlt =
  'Protoyard: build prototypes that feel real. Browser-first prototyping with mock data, scenarios, themes and publishable apps.';
const nav = [
  { href: withBase('/'), label: 'Prototypes', id: 'home' },
  { href: withBase('/features/'), label: 'Features', id: 'features' },
  { href: withBase('/play/'), label: 'Play', id: 'play' },
  { href: withBase('/docs/'), label: 'Docs', id: 'docs' },
  { href: withBase('/#templates'), label: 'Templates', id: 'templates' },
  { href: withBase('/marketplace/'), label: 'Marketplace', id: 'marketplace' },
  { href: withBase('/themes/'), label: 'Themes', id: 'themes' },
  { href: withBase('/new/'), label: 'Create', id: 'new' },
];
---

<!doctype html>
<html lang="en" data-tx-theme="gallery" data-tx-mode="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#4f46e5" />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Protoyard" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <link rel="icon" href={withBase('/favicon.ico')} sizes="16x16 32x32 48x48" />
    <link rel="icon" href={withBase('/favicon-96x96.png')} type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} sizes="180x180" />
    <link rel="manifest" href={withBase('/site.webmanifest')} />
    {Astro.site && <link rel="sitemap" href={withBase('/sitemap.xml')} />}
    <script is:inline set:html={APPEARANCE_MIGRATION_SCRIPT + themeBootstrapScript({ namespace: 'gallery' })} />
  </head>
  <body class="bg-bg text-fg">
    <a
      href="#main"
      class="sr-only-focusable fixed left-3 top-3 z-50 rounded-md bg-accent px-3 py-2 text-sm font-medium text-on-accent"
      >Skip to content</a
    >
    <header class="sticky top-0 z-40 border-b border-line bg-bg/85 backdrop-blur">
      <div class="mx-auto flex h-14 max-w-7xl items-center gap-2 px-4 sm:gap-4 sm:px-6">
        <a href={withBase('/')} class="flex items-center gap-2 font-semibold tracking-tight" aria-label="Protoyard home">
          <img src={withBase('/logo-mark.png')} width="24" height="24" alt="" aria-hidden="true" />
          <span class="hidden sm:inline">Protoyard</span>
        </a>
        <nav aria-label="Main" class="flex min-w-0 items-center gap-0.5 overflow-x-auto whitespace-nowrap text-sm [scrollbar-width:none] sm:gap-1">
          {
            nav.map((item) => (
              <a
                href={item.href}
                aria-current={active === item.id ? 'page' : undefined}
                class:list={[
                  'rounded-md px-2 py-1.5 text-muted hover:bg-surface-2 hover:text-fg sm:px-2.5',
                  active === item.id && 'bg-surface-2 text-fg',
                ]}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
        <div class="ml-auto flex items-center gap-2">
          <CommandPaletteTrigger client:idle homeUrl={withBase('/')} />
          <ThemeToggle client:load />
        </div>
      </div>
    </header>
    <main id="main" class="mx-auto max-w-7xl px-4 pb-24 pt-8 sm:px-6">
      <slot />
    </main>
    <footer class="border-t border-line">
      <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-2 px-4 py-6 text-xs text-muted sm:px-6">
        <p>Protoyard — real behavior, fake infrastructure. Every prototype keeps its data in your browser.</p>
        <p>
          <a class="underline-offset-2 hover:underline" href="https://github.com/DailybotHQ/protoyard">Source on GitHub</a>
          · MIT · Dailybot, Inc.
        </p>
      </div>
    </footer>
  </body>
</html>

---
import ThemeExplorer from '@/components/ThemeExplorer.svelte';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { withBase } from '@/lib/format';
import { prototypes } from '@/lib/registry';
import { buildThemeCatalog, withThemeParam } from '@/lib/theme-catalog';

const themes = await buildThemeCatalog();
const collections = [...new Set(themes.map((theme) => theme.collection))];
const moods = [...new Set(themes.flatMap((theme) => theme.mood))].sort();
const prototypeTargets = prototypes()
  .filter((entry) => entry.kind === 'prototype')
  .map((entry) => ({
    slug: entry.slug,
    name: entry.name,
    url: entry.embedded?.url ? withBase(`/${entry.embedded.url}`) : withBase(`/p/${entry.slug}/`),
  }));
---

<BaseLayout
  title="Themes"
  description="Browse Protoyard theme presets with live light and dark swatches. Open any prototype preview in a chosen theme."
  active="themes"
>
  <section class="mb-8 max-w-3xl">
    <p class="text-sm font-medium text-accent-fg">Design range</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl" data-testid="themes-title">
      Themes
    </h1>
    <p class="mt-3 text-muted">
      Explore the 64-theme library and six built-in palettes by collection, mood, or search. Compare
      chart colors in either mode, then open a prototype with
      <code class="font-mono text-sm">?theme=&lt;id&gt;</code>.
    </p>
  </section>

  <ThemeExplorer
    client:load
    collections={collections}
    moods={moods}
    prototypes={prototypeTargets}
    themeCount={themes.length}
  />

  <ul class="mt-6 grid gap-4 lg:grid-cols-2" data-testid="theme-grid">
    {themes.map((theme) => (
      <li
        class="overflow-hidden rounded-xl border border-line bg-surface shadow-sm"
        data-theme-card
        data-theme-id={theme.id}
        data-collection={theme.collection}
        data-moods={theme.mood.join(' ')}
        data-search={`${theme.id} ${theme.name} ${theme.description} ${theme.category} ${theme.collection} ${theme.mood.join(' ')} ${theme.tags.join(' ')}`}
        data-testid="theme-card"
      >
        <header class="border-b border-line px-4 py-3">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h2 class="text-base font-semibold tracking-tight text-fg">{theme.name}</h2>
            <span class="rounded-md bg-surface-2 px-2 py-0.5 font-mono text-[11px] text-muted">{theme.id}</span>
          </div>
          <p class="mt-1 text-sm text-muted">{theme.description || 'No description.'}</p>
          <div class="mt-2 flex flex-wrap gap-1.5">
            <span class="rounded-md bg-accent-soft px-2 py-0.5 text-xs font-medium text-accent-fg">{theme.collection}</span>
            {theme.mood.map((item) => <span class="rounded-md bg-surface-2 px-2 py-0.5 text-xs text-muted">{item}</span>)}
          </div>
        </header>
        <div class="p-4" data-theme-mode="light" style={theme.lightStyle}>
          <p class="mb-3 text-[11px] font-medium tracking-wide text-[color:var(--tx-muted-foreground)] uppercase">Light preview</p>
          <div class="rounded-[var(--tx-radius)] border border-[color:var(--tx-border)] bg-[color:var(--tx-background)] p-3 text-[color:var(--tx-foreground)]">
            <p class="text-sm font-semibold" style="font-family:var(--tx-font-heading);font-weight:var(--tx-font-weight-heading)">A clear, readable interface</p>
            <p class="mt-1 text-xs text-[color:var(--tx-muted-foreground)]">Palette surfaces and chart colors</p>
            <div class="mt-3 flex gap-2" role="img" aria-label="Chart palette preview">
              {theme.chartColors.map((_, index) => <span class="size-5 rounded-full border border-black/10" style={`background:var(--tx-chart${index + 1})`} aria-hidden="true"></span>)}
            </div>
          </div>
        </div>
        <div class="p-4" data-theme-mode="dark" style={theme.darkStyle} hidden>
          <p class="mb-3 text-[11px] font-medium tracking-wide text-[color:var(--tx-muted-foreground)] uppercase">Dark preview</p>
          <div class="rounded-[var(--tx-radius)] border border-[color:var(--tx-border)] bg-[color:var(--tx-background)] p-3 text-[color:var(--tx-foreground)]">
            <p class="text-sm font-semibold" style="font-family:var(--tx-font-heading);font-weight:var(--tx-font-weight-heading)">A clear, readable interface</p>
            <p class="mt-1 text-xs text-[color:var(--tx-muted-foreground)]">Palette surfaces and chart colors</p>
            <div class="mt-3 flex gap-2" role="img" aria-label="Chart palette preview">
              {theme.chartColors.map((_, index) => <span class="size-5 rounded-full border border-white/10" style={`background:var(--tx-chart${index + 1})`} aria-hidden="true"></span>)}
            </div>
          </div>
        </div>
        <footer class="border-t border-line bg-surface-2/60 px-4 py-3">
          <a class="inline-flex rounded-md bg-accent px-3 py-1.5 text-sm font-medium text-on-accent hover:bg-accent-hover" data-theme-open href={prototypeTargets[0] ? withThemeParam(prototypeTargets[0].url, theme.id, 'light') : '#'} target="_blank" rel="noopener" hidden={!prototypeTargets.length}>
            {prototypeTargets[0] ? `Open ${prototypeTargets[0].name} in this theme` : 'Choose a prototype'}
          </a>
        </footer>
      </li>
    ))}
  </ul>
</BaseLayout>

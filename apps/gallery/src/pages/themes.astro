---
import ThemeBrowser from '@/components/ThemeBrowser.svelte';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { withBase } from '@/lib/format';
import { prototypes } from '@/lib/registry';
import { buildThemeCatalog, themeCategories } from '@/lib/theme-catalog';

const themes = await buildThemeCatalog();
const categories = themeCategories(themes);
const demo = prototypes().find((entry) => entry.embedded?.url) ?? prototypes()[0] ?? null;
const previewUrl = demo
  ? demo.embedded?.url
    ? withBase(`/${demo.embedded.url}`)
    : withBase(`/p/${demo.slug}/`)
  : null;
const previewName = demo?.name ?? null;
---

<BaseLayout
  title="Themes"
  description="Browse Protoyard theme presets with live light and dark swatches. Open any prototype preview in a chosen theme."
  active="themes"
>
  <section class="mb-8 max-w-3xl">
    <p class="text-sm font-medium text-accent-fg">Design range</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl" data-testid="themes-title">
      Themes
    </h1>
    <p class="mt-3 text-muted">
      Built-in presets and the product-category library, each with light and dark palettes rendered as
      live samples. Filter by category, then open a prototype with
      <code class="font-mono text-sm">?theme=&lt;id&gt;</code>
      so DevTools and the runtime pick that theme (simulation only).
    </p>
  </section>

  <ThemeBrowser
    client:load
    themes={themes}
    categories={categories}
    previewUrl={previewUrl}
    previewName={previewName}
  />
</BaseLayout>

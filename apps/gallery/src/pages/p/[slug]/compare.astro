---
import CompareView from '@/components/CompareView.svelte';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { devCommand } from '@/lib/commands';
import { withBase } from '@/lib/format';
import { prototypes } from '@/lib/registry';
import type { RegistryEntry } from '@/lib/types';

export function getStaticPaths() {
  return prototypes().map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props as { entry: RegistryEntry };
const embeddedUrl = entry.embedded ? withBase(`/${entry.embedded.url}`) : null;
---

<BaseLayout title={`Compare scenarios · ${entry.name}`} description={`Compare ${entry.name} scenarios side by side.`} noindex>
  <a href={withBase(`/p/${entry.slug}/`)} class="inline-flex items-center gap-1 text-sm text-muted hover:text-fg">
    <span aria-hidden="true">←</span> {entry.name}
  </a>
  <h1 class="mt-3 text-3xl font-semibold tracking-tight" data-testid="detail-title">Compare scenarios</h1>
  <p class="mt-1 max-w-3xl text-muted">
    {entry.name} side by side: pick a scenario per frame. Every frame is an isolated sandbox of the same build.
  </p>
  <div class="mt-6">
    {
      entry.scenarios.length > 0 ? (
        <CompareView
          client:load
          slug={entry.slug}
          name={entry.name}
          scenarios={entry.scenarios}
          defaultScenario={entry.defaultScenario}
          embeddedUrl={embeddedUrl}
          devCommand={devCommand(entry.slug)}
        />
      ) : (
        <p class="rounded-xl border border-dashed border-line p-6 text-sm text-muted">
          {entry.name} declares no scenarios, so there is nothing to compare.
        </p>
      )
    }
  </div>
</BaseLayout>

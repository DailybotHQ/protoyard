---
import DocsSearch from '@/components/docs/DocsSearch.svelte';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPublicDocs } from '@/lib/docs';
import { withBase } from '@/lib/format';

const docs = getPublicDocs(withBase(''));
---

<BaseLayout
  title="Documentation"
  description="Guides for building, sharing and extending Protoyard prototypes."
  canonicalPath={withBase('/docs/')}
  active="docs"
>
  <section class="mx-auto max-w-4xl">
    <p class="text-sm font-medium text-accent">Documentation</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight">Build with Protoyard</h1>
    <p class="mt-3 max-w-2xl text-muted">Public guides for using Protoyard and its tools.</p>
    <div class="mt-6 max-w-xl">
      <DocsSearch client:idle indexUrl={withBase('/docs/search-index.json')} />
    </div>
    <ul class="mt-8 grid gap-4 sm:grid-cols-2">
      {docs.map((doc) => (
        <li class="rounded-xl border border-line bg-surface p-5">
          <h2 class="text-lg font-semibold"><a class="underline-offset-4 hover:underline" href={withBase(`/docs/${doc.slug}/`)}>{doc.title}</a></h2>
          <p class="mt-2 text-sm text-muted">{doc.description}</p>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

---
import Playground from '@/components/player/Playground.svelte';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { withBase } from '@/lib/format';
---

<BaseLayout
  title="Run a blueprint"
  description="Run app, deck, page, or document blueprints in your browser. Paste JSON, open a share link, or load a local blueprint file; simulated data stays in this browser."
  canonicalPath={withBase('/play/')}
  active="play"
>
  <h1 class="text-3xl font-semibold tracking-tight">Run a blueprint</h1>
  <p class="mt-2 mb-8 max-w-3xl text-muted">
    Run an app, deck, page, or document blueprint in this browser. Paste blueprint JSON, open a
    share link, or choose a local JSON file in the player. Simulated data stays in this browser.
  </p>
  <Playground client:load />
  <script>
    import { syncShareRobots } from '@/lib/play-robots';

    const updateShareRobots = () => syncShareRobots(window.location.hash, document.head);
    updateShareRobots();
    window.addEventListener('hashchange', updateShareRobots);
  </script>
</BaseLayout>

---
import MarketplaceBrowser from '@/components/marketplace/MarketplaceBrowser.svelte';
import { facets } from '@/components/marketplace/model';
import { shelf } from '@/components/marketplace/shelf';
import { themeChoices } from '@/components/marketplace/theme-facet';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { withBase } from '@/lib/format';

const items = shelf().map((item) => item.entry);
const counts = facets(items);
const kindCount = (kind: string) => counts.kind.find(([value]) => value === kind)?.[1] ?? 0;
---

<BaseLayout
  title="Marketplace"
  description="Every product type Protoyard can simulate: try a live demo, then start your own from a template, a prototype or a blueprint."
  active="marketplace"
>
  <section class="mb-8 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
    <div class="max-w-3xl">
      <p class="text-sm font-medium text-accent-fg">Marketplace</p>
      <h1 class="mt-2 text-4xl font-semibold tracking-tight text-balance">Start from a product that already works.</h1>
      <p class="mt-3 text-lg text-muted">
        Web apps, mobile apps, desktop apps, chat widgets and plugins. Try one live, then make it yours with
        <span class="whitespace-nowrap">“Use this template”</span> or “Remix”.
      </p>
    </div>
    <dl class="flex gap-6 text-sm">
      <div><dt class="text-muted">Prototypes</dt><dd class="text-2xl font-semibold tabular-nums">{kindCount('prototype')}</dd></div>
      <div><dt class="text-muted">Templates</dt><dd class="text-2xl font-semibold tabular-nums">{kindCount('template')}</dd></div>
      <div><dt class="text-muted">Blueprints</dt><dd class="text-2xl font-semibold tabular-nums">{kindCount('blueprint')}</dd></div>
    </dl>
  </section>

  {
    items.length > 0 ? (
      <MarketplaceBrowser client:load entries={items} facets={counts} themes={themeChoices()} />
    ) : (
      <div class="rounded-xl border border-dashed border-line p-10 text-center" data-testid="market-empty">
        <p class="font-medium">Nothing is shelved yet</p>
        <p class="mt-1 text-sm text-muted">
          Items appear here once their <code class="font-mono">protoyard.json</code> has a
          <code class="font-mono">catalog</code> block. Run <code class="font-mono">pnpm protoyard index</code> after adding one.
        </p>
        <a href={withBase('/')} class="mt-4 inline-block rounded-lg border border-line px-3 py-1.5 text-sm hover:bg-surface-2">Browse all prototypes</a>
      </div>
    )
  }
</BaseLayout>

{
  "$schema": "https://github.com/DailybotHQ/protoyard/schema/manifest/v1",
  "id": "template.onboarding",
  "slug": "onboarding",
  "kind": "template",
  "name": "Onboarding Wizard",
  "description": "A multi-step onboarding starter: profile, workspace, teammate invites and preferences with per-step validation, progress saved to IndexedDB after every step, skippable optional steps, a summary and a post-onboarding home.",
  "version": "0.1.0",
  "renderer": "svelte-vite",
  "platform": "responsive",
  "category": "starter",
  "tags": ["starter", "onboarding", "wizard", "forms", "stepper"],
  "catalog": {
    "category": "starter",
    "productType": "Onboarding wizard",
    "platforms": ["web"],
    "features": ["onboarding", "wizard", "validation", "invites"],
    "highlights": [
      "Profile, workspace, invites and preferences steps",
      "Per-step validation, with progress saved after every step",
      "Skippable optional steps and a summary"
    ],
    "difficulty": "beginner"
  },
  "status": "ready",
  "icon": "🧭",
  "defaultScenario": "half-complete",
  "defaultTheme": "violet",
  "defaultMode": "system",
  "preview": {
    "viewport": "desktop",
    "layout": { "id": "wizard", "supported": ["wizard", "auth-split"] }
  },
  "storage": { "namespace": "template-onboarding", "schemaVersion": 1 },
  "build": { "includeDevtools": false, "demoBadge": true, "base": "./" },
  "scenarios": ["not-started", "half-complete", "completed", "viewer"],
  "thumbnail": "public/thumbnail.png"
}

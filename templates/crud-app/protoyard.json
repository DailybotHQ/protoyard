{
  "$schema": "https://github.com/DailybotHQ/protoyard/schema/manifest/v1",
  "id": "template.crud-app",
  "slug": "crud-app",
  "kind": "template",
  "name": "CRUD app",
  "description": "Blueprint-driven starter: projects and tasks with AppShell navigation, EntityList/EntityForm, notifications bell, members and a command palette. Base template for `protoyard generate`.",
  "version": "0.1.0",
  "renderer": "svelte-vite",
  "platform": "responsive",
  "category": "starter",
  "tags": ["starter", "crud", "blueprint", "generate"],
  "status": "ready",
  "icon": "🗂️",
  "defaultScenario": "active",
  "defaultTheme": "ocean",
  "defaultMode": "system",
  "preview": { "viewport": "desktop", "shell": "browser" },
  "storage": { "namespace": "template-crud-app", "schemaVersion": 1 },
  "build": { "includeDevtools": false, "demoBadge": true, "base": "./" },
  "scenarios": ["empty", "active", "viewer", "massive"]
}

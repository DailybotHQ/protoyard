{
  "$schema": "https://github.com/DailybotHQ/protoyard/schema/manifest/v1",
  "id": "template.admin-console",
  "slug": "admin-console",
  "kind": "template",
  "name": "Admin Console",
  "description": "An internal admin console: tenants with suspend and reactivate, users across tenants with simulated impersonation, subscriptions with cancel and resume, and an audit log of every staff action, with role-gated destructive actions behind confirmation.",
  "version": "0.1.0",
  "renderer": "svelte-vite",
  "platform": "desktop",
  "category": "starter",
  "tags": ["starter", "admin", "internal-tool", "saas", "audit", "roles", "impersonation"],
  "catalog": {
    "category": "internal-tools",
    "productType": "Admin console",
    "platforms": ["web", "desktop"],
    "features": ["multi-tenant", "roles", "impersonation", "subscriptions", "audit-log"],
    "highlights": [
      "Suspend and reactivate tenants",
      "Simulated impersonation of users across tenants",
      "Cancel and resume subscriptions",
      "Audit log of every staff action, with confirmed destructive actions"
    ],
    "difficulty": "intermediate"
  },
  "status": "ready",
  "icon": "🛡️",
  "defaultScenario": "operations",
  "defaultTheme": "ocean",
  "defaultMode": "system",
  "preview": {
    "viewport": "desktop",
    "layout": { "id": "sidebar", "supported": ["sidebar", "rail", "top-nav", "dual-sidebar"] }
  },
  "storage": { "namespace": "template-admin-console", "schemaVersion": 1 },
  "build": { "includeDevtools": false, "demoBadge": true, "base": "./" },
  "scenarios": ["empty", "operations", "incident", "support-agent", "auditor"],
  "thumbnail": "public/thumbnail.png"
}

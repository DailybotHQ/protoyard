{
  "$schema": "https://github.com/DailybotHQ/protoyard/schema/manifest/v1",
  "id": "template.dashboard",
  "slug": "dashboard",
  "kind": "template",
  "name": "SaaS Dashboard",
  "description": "A SaaS admin starter: overview metrics and a revenue chart, customers with search, filters and detail pages, orders with audited status changes, and a role-gated settings page for owner, admin, member and viewer personas.",
  "version": "0.1.0",
  "renderer": "svelte-vite",
  "platform": "responsive",
  "category": "starter",
  "tags": ["starter", "dashboard", "saas", "admin", "crud", "roles"],
  "catalog": {
    "category": "analytics",
    "productType": "SaaS dashboard",
    "platforms": ["web"],
    "features": ["dashboard", "charts", "crud", "audit-log", "roles"],
    "highlights": [
      "Overview metrics and a revenue chart",
      "Customers with search, filters and detail pages",
      "Orders with audited status changes",
      "Role-gated settings for four personas"
    ],
    "difficulty": "intermediate"
  },
  "status": "ready",
  "icon": "📊",
  "defaultScenario": "active",
  "defaultTheme": "violet",
  "defaultMode": "system",
  "preview": { "viewport": "desktop" },
  "storage": { "namespace": "template-dashboard", "schemaVersion": 2 },
  "build": { "includeDevtools": false, "demoBadge": true, "base": "./" },
  "scenarios": ["empty", "active", "power-user", "viewer"]
}

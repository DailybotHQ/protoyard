{
  "g02-release-notes": {
    "id": "layout-doc",
    "props": {
      "title": "What is new in Pebble 4.2"
    },
    "children": [
      {
        "id": "blocks-text",
        "props": {
          "block": {
            "type": "text",
            "markdown": "This release speeds up shared boards and brings shortcuts to the editor."
          }
        }
      },
      {
        "id": "blocks-text",
        "props": {
          "block": {
            "type": "heading",
            "level": 2,
            "text": "New"
          }
        }
      },
      {
        "id": "blocks-text",
        "props": {
          "block": {
            "type": "list",
            "ordered": false,
            "items": [
              {
                "text": "Shortcuts for moving cards between columns"
              },
              {
                "text": "Starter templates for weekly planning"
              }
            ]
          }
        }
      },
      {
        "id": "blocks-text",
        "props": {
          "block": {
            "type": "heading",
            "level": 2,
            "text": "Fixed"
          }
        }
      },
      {
        "id": "blocks-text",
        "props": {
          "block": {
            "type": "list",
            "ordered": false,
            "items": [
              {
                "text": "Mentions no longer lose focus while typing"
              },
              {
                "text": "Due dates follow the viewer time zone"
              }
            ]
          }
        }
      },
      {
        "id": "blocks-text",
        "props": {
          "block": {
            "type": "callout",
            "tone": "warning",
            "title": "Old exports go away",
            "body": "Pebble 4.3 drops the 3.x export format. Export older boards again before upgrading."
          }
        }
      }
    ]
  },
  "g03-onboarding-handbook": {
    "id": "layout-doc",
    "props": {

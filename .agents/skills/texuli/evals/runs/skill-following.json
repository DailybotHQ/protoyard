  "g08-pricing-faq": {
    "id": "layout-doc",
    "props": {
      "title": "Pebble pricing FAQ"
    },
    "children": [
      {
        "id": "blocks-text",
        "props": {
          "block": {
            "type": "heading",
            "level": 2,
            "text": "Can I switch plans?"
          }
        }
      },
      {
        "id": "blocks-text",
        "props": {
          "block": {
            "type": "text",
            "markdown": "Yes. A new plan starts with your next billing period."
          }
        }
      },
      {
        "id": "blocks-text",
        "props": {
          "block": {
            "type": "heading",
            "level": 2,
            "text": "How long is the trial?"
          }
        }
      },
      {
        "id": "blocks-text",
        "props": {
          "block": {
            "type": "text",
            "markdown": "Every plan includes a 14-day trial with all features."
          }
        }
      },
      {
        "id": "blocks-text",
        "props": {
          "block": {
            "type": "heading",
            "level": 2,
            "text": "Are there nonprofit discounts?"
          }
        }
      },
      {
        "id": "blocks-text",
        "props": {
          "block": {
            "type": "text",
            "markdown": "Registered nonprofits receive 30% off the Team plan."
          }
        }
      },
      {
        "id": "blocks-text",
        "props": {
          "block": {
            "type": "heading",
            "level": 2,
            "text": "What counts as a seat?"
          }
        }
      },
      {
        "id": "blocks-text",
        "props": {
          "block": {
            "type": "text",
            "markdown": "Anyone who used Pebble during the billing period."
          }
        }
      }
    ]
  },

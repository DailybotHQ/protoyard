  "g18-recipe": {
    "id": "layout-doc",
    "props": {
      "title": "Lemon barley soup"
    },
    "children": [
      {
        "id": "blocks-text",
        "props": {
          "block": {
            "type": "text",
            "markdown": "A bright, filling soup for a cold evening. Serves four."
          }
        }
      },
      {
        "id": "blocks-text",
        "props": {
          "block": {
            "type": "heading",
            "level": 2,
            "text": "Ingredients"
          }
        }
      },
      {
        "id": "blocks-text",
        "props": {
          "block": {
            "type": "list",
            "ordered": false,
            "items": [
              {
                "text": "1 cup pearl barley"
              },
              {
                "text": "1 onion, diced"
              },
              {
                "text": "2 carrots, sliced"
              },
              {
                "text": "6 cups vegetable stock"
              },
              {
                "text": "2 lemons, juiced"
              }
            ]
          }
        }
      },
      {
        "id": "blocks-text",
        "props": {
          "block": {
            "type": "heading",
            "level": 2,
            "text": "Steps"
          }
        }
      },
      {
        "id": "blocks-text",
        "props": {
          "block": {
            "type": "list",
            "ordered": true,
            "items": [
              {
                "text": "Soften the onion and carrots in a little oil"
              },
              {
                "text": "Add the barley and stock, then simmer for 40 minutes"
              },
              {
                "text": "Stir in the lemon juice and season to taste"
              }
            ]
          }
        }
      }
    ]
  },

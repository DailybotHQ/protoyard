  },
  "g05-incident-postmortem": {
    "id": "layout-doc",
    "props": {
      "title": "Checkout errors on 3 June"
    },
    "children": [
      {
        "id": "blocks-text",
        "props": {
          "block": {
            "type": "text",
            "markdown": "For 23 minutes checkout failed after a configuration push. Orders were retried and none were lost."
          }
        }
      },
      {
        "id": "blocks-text",
        "props": {
          "block": {
            "type": "heading",
            "level": 2,
            "text": "Timeline"
          }
        }
      },
      {
        "id": "blocks-text",
        "props": {
          "block": {
            "type": "list",
            "ordered": true,
            "items": [
              {
                "text": "14:02 configuration pushed"
              },
              {
                "text": "14:06 error rate alert"
              },
              {
                "text": "14:25 configuration reverted"
              }
            ]
          }
        }
      },
      {
        "id": "blocks-text",
        "props": {
          "block": {
            "type": "quote",
            "quote": "Seeing the config diff in the alert would have saved ten minutes.",
            "cite": "Sam Ito, on call"
          }
        }
      },
      {
        "id": "blocks-text",
        "props": {
          "block": {
            "type": "callout",
            "tone": "info",
            "title": "Follow-up owner",
            "body": "Lena Park adds a configuration canary before the next release."
          }
        }
      }
    ]
  },
